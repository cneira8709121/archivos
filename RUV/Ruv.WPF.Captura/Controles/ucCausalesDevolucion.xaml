<UserControl
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:Ruv_WPF_Captura_Registro_Secciones="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
	xmlns:Ruv_Infrastructure_Crosscutting_Common_Entidades_Devolucion="clr-namespace:Ruv.Infrastructure.Crosscutting.Common.Entidades.Devolucion;assembly=Ruv.Infrastructure.Crosscutting.Common"
	mc:Ignorable="d"
	x:Class="Ruv.WPF.Captura.ucCausalesDevolucion"
	x:Name="UserControl" MaxWidth="350">

	<UserControl.DataContext>
		<Ruv_Infrastructure_Crosscutting_Common_Entidades_Devolucion:clsDevolucion/>
	</UserControl.DataContext>

	<Grid x:Name="LayoutRoot">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="130"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<Label Content="Seleccione las causales que apliquen" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{DynamicResource Thickness-Bottom-10}"/>
		<Ruv_WPF_Captura_Registro_Secciones:ListaOpciones x:Name="ucListaOpciones" Grid.Row="1" IncluirNumero="False" UsarDosColumnas="False" VerticalAlignment="Center" Orientacion="Vertical" TipoOpciones="Multiple" ValoresUsuario="{Binding LstCausalesDevolucion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
		<Label Content="Observaciones" HorizontalAlignment="Left" Grid.Row="2" VerticalAlignment="Top" Margin="{DynamicResource Thickness-Bottom-10}"/>
		<ScrollViewer Grid.Row="3" MaxHeight="130" Margin="{DynamicResource Thickness-Bottom-10}">
			<TextBox Name="txtObservaciones" TextWrapping="Wrap" Text="{Binding CObservaciones, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
		</ScrollViewer>
		<StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
			<Button Content="Aceptar" Width="75" Margin="{DynamicResource Thickness-Right-10}" Click="AceptarButton_Click"/>
			<Button Content="Cancelar" Width="75" Click="CancelarButton_Click"/>
		</StackPanel>
	</Grid>
</UserControl>