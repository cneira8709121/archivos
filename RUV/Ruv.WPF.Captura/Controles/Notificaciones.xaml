<UserControl x:Class="Ruv.WPF.Captura.Controles.Notificaciones"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" Width="250" Height="90">
    <Border  BorderThickness="1,1,1,1" Margin="0,0,0,0"
                BorderBrush="#FF997137"
                Background="White">
        <Grid  Margin="0,0,0,0">
            <Image Margin="5,5,0,0"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                    Width="65"
                    Height="80" 
                    Source="/Recursos/Imagenes/Info.png" />
            <TextBlock  
                    VerticalAlignment="Top"
                    Height="21"
                    Text="{Binding Path=Titulo, Mode=TwoWay}" 
                    FontWeight="Bold" Margin="75,10,5,5" FontSize="13" HorizontalAlignment="Left" />
            <TextBlock      
            VerticalAlignment="Top" TextWrapping="Wrap"
            Foreground="#FFECAD25" Margin="75,40,10,10" HorizontalAlignment="Stretch">
            <Hyperlink x:Name="hlkAbrir" Click="hlkAbrir_Click" >
                <TextBlock  VerticalAlignment="Top" HorizontalAlignment="Stretch" Text="{Binding Informacion}" FontSize="10" TextWrapping="Wrap" ></TextBlock>
            </Hyperlink>
        </TextBlock>
        </Grid>

        <Border.Effect>
            <DropShadowEffect Color="#FF747474"/>
        </Border.Effect>
    </Border>
</UserControl>
