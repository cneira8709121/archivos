<UserControl x:Class="Ruv.WPF.Captura.Controles.BloqueoInterfase"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Visibility="Collapsed"
             d:DesignHeight="300"
             d:DesignWidth="300">
  <Border x:Name="borBloqueoInterfase"
          Background="#55A0A0A0">
    <Border.Resources>
      <Storyboard x:Key="sbBloqueoInterfase">
        <DoubleAnimation Storyboard.TargetName="rtOcupado1"
                         Storyboard.TargetProperty="Angle"
                         RepeatBehavior="Forever"
                         From="0"
                         To="360"
                         Duration="0:0:1" />
        <DoubleAnimation Storyboard.TargetName="rtOcupado2"
                         Storyboard.TargetProperty="Angle"
                         RepeatBehavior="Forever"
                         From="360"
                         To="0"
                         Duration="0:0:1" />
      </Storyboard>
    </Border.Resources>
    <Grid>
      <Ellipse  StrokeThickness="10"
                StrokeDashArray="5 5"
                Width="70"
                Height="70"
                Stroke="Gray">
        <Ellipse.RenderTransform>
          <RotateTransform x:Name="rtOcupado1"
                           CenterX="35"
                           CenterY="35"
                           Angle="0" />
        </Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse  StrokeThickness="10"
                StrokeDashArray="6 6"
                Width="90"
                Height="90"
                Stroke="Gray">
        <Ellipse.RenderTransform>
          <RotateTransform x:Name="rtOcupado2"
                           CenterX="45"
                           CenterY="45"
                           Angle="0" />
        </Ellipse.RenderTransform>
      </Ellipse>
      <Border Background="#ACFFFFFF"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              CornerRadius="5"
              BorderThickness="2"
              BorderBrush="Gray"
              Padding="10,5"
              Height="Auto"
              Width="Auto">
        <TextBlock x:Name="txtMensajeBloqueo"
                   Text=""
                   FontSize="30"
                   FontWeight="Bold" />
      </Border>
    </Grid>
  </Border>
</UserControl>
