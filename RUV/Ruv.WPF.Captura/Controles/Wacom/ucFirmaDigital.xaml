<UserControl x:Class="Ruv.WPF.Captura.Controles.Wacom.ucFirmaDigital"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Ruv_WPF_Captura_Controles="clr-namespace:Ruv.WPF.Captura.Controles" xmlns:Ruv_WPF_Captura_Recursos="clr-namespace:Ruv.WPF.Captura.Recursos"
             mc:Ignorable="d" 
             d:DesignHeight="470" d:DesignWidth="736" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <Ruv_WPF_Captura_Recursos:Controles x:Key="ControlesDataSource" d:IsDataSource="True"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70*" />
            <RowDefinition Height="400*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Height="30" Margin="{DynamicResource Thickness-20}">
                <Button x:Name="btnIniciar" Content="{Binding IniciarToma, Source={StaticResource ControlesDataSource}}" Margin="{DynamicResource Thickness-Right-10}" Click="btnIniciar_Click" />
                <Button x:Name="btnGuardar" Content="{Binding Guardar, Source={StaticResource ControlesDataSource}}" Margin="{DynamicResource Thickness-Right-10}" Click="btnGuardar_Click" />
                <Button x:Name="btnLimpiar" Content="{Binding Limpiar, Source={StaticResource ControlesDataSource}}" Margin="{DynamicResource Thickness-Right-10}" Click="btnLimpiar_Click" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="{DynamicResource Thickness-20}" >
                <Label Content="{Binding Path=DispositivoConectado, Source={StaticResource ControlesDataSource}, StringFormat='\{0\} :'}" />
                <Label x:Name="lblConectado" />
            </StackPanel>
        </DockPanel>
        <Canvas Grid.Row="1" x:Name="cvn" Height="400" HorizontalAlignment="Left" VerticalAlignment="Top" Width="736" />
    </Grid>
</UserControl>
