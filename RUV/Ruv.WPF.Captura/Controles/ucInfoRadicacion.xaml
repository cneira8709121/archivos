<UserControl
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:Ruv_WPF_Captura_Recursos="clr-namespace:Ruv.WPF.Captura.Recursos"
	xmlns:Ruv_WPF_Captura_Controles="clr-namespace:Ruv.WPF.Captura.Controles"
	xmlns:Ruv_WPF_Captura_Converters="clr-namespace:Ruv.WPF.Captura.Converters" xmlns:Ruv_Infrastructure_Crosscutting_Common_Entidades="clr-namespace:Ruv.Infrastructure.Crosscutting.Common.Entidades;assembly=Ruv.Infrastructure.Crosscutting.Common"
	mc:Ignorable="d"
	x:Class="Ruv.WPF.Captura.ucInfoRadicacion"
	x:Name="UserControl" MaxWidth="600">

	<UserControl.Resources>
		<Ruv_WPF_Captura_Converters:ObjetoNuloAVisibilidadConverter x:Key="ObjetoNuloAVisibilidadConverter"/>
		<Ruv_WPF_Captura_Converters:ParametroNombreConverter x:Key="ParametroNombreConverter"/>
		<Ruv_Infrastructure_Crosscutting_Common_Entidades:clsRadicacion x:Key="clsRadicacionDataSource" d:IsDataSource="True"/>
		<Ruv_WPF_Captura_Recursos:Controles x:Key="ControlesDataSource" d:IsDataSource="True"/>
	</UserControl.Resources>
	<UserControl.DataContext>
		<Binding Mode="OneWay" Source="{StaticResource clsRadicacionDataSource}"/>
	</UserControl.DataContext>

	<Grid x:Name="LayoutRoot">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<GroupBox Header="{Binding General, Source={StaticResource ControlesDataSource}}" d:LayoutOverrides="Height" Padding="{DynamicResource Thickness-10}" Margin="{DynamicResource Thickness-Bottom-10}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition/>
					<RowDefinition/>
					<RowDefinition/>
					<RowDefinition/>
					<RowDefinition/>
					<RowDefinition/>
					<RowDefinition/>
					<RowDefinition/>
				</Grid.RowDefinitions>
				<TextBlock Text="{Binding FechaEntrega, Source={StaticResource ControlesDataSource}}" HorizontalAlignment="Left" d:LayoutOverrides="Height" VerticalAlignment="Center" Margin="{DynamicResource Thickness-Right-10}"/>
				<TextBlock Text="{Binding TipoDocumento, Source={StaticResource ControlesDataSource}}" HorizontalAlignment="Left" Grid.Row="1" d:LayoutOverrides="Height" VerticalAlignment="Center" Margin="{DynamicResource Thickness-Right-10}"/>
				<TextBlock Text="{Binding CodigoFormulario, Source={StaticResource ControlesDataSource}}" HorizontalAlignment="Left" Grid.Row="2" d:LayoutOverrides="Height" VerticalAlignment="Center" Margin="{DynamicResource Thickness-Right-10}"/>
				<TextBlock Text="{Binding Pais, Source={StaticResource ControlesDataSource}}" HorizontalAlignment="Left" Grid.Row="3" d:LayoutOverrides="Height" VerticalAlignment="Center" Margin="{DynamicResource Thickness-Right-10}"/>
				<TextBlock Text="{Binding Departamento, Source={StaticResource ControlesDataSource}}" HorizontalAlignment="Left" Grid.Row="4" d:LayoutOverrides="Height" VerticalAlignment="Center" Margin="{DynamicResource Thickness-Right-10}"/>
				<TextBlock Text="{Binding Municipio, Source={StaticResource ControlesDataSource}}" HorizontalAlignment="Left" Grid.Row="5" d:LayoutOverrides="Height" VerticalAlignment="Center" Margin="{DynamicResource Thickness-Right-10}"/>
				<TextBlock Text="{Binding Entidad, Source={StaticResource ControlesDataSource}}" HorizontalAlignment="Left" Grid.Row="6" d:LayoutOverrides="Height" VerticalAlignment="Center" Margin="{DynamicResource Thickness-Right-10}"/>
				<TextBlock Grid.Column="1" HorizontalAlignment="Center" TextWrapping="Wrap" Text=":" d:LayoutOverrides="Height" Margin="{DynamicResource Thickness-Right-10}" VerticalAlignment="Center"/>
				<TextBlock Grid.Column="1" HorizontalAlignment="Center" TextWrapping="Wrap" Text=":" d:LayoutOverrides="Height" Margin="{DynamicResource Thickness-Right-10}" VerticalAlignment="Center"/>
				<TextBlock Grid.Column="1" HorizontalAlignment="Center" Grid.Row="1" TextWrapping="Wrap" Text=":" VerticalAlignment="Center" Margin="{DynamicResource Thickness-Right-10}"/>
				<TextBlock Grid.Column="1" HorizontalAlignment="Center" Grid.Row="2" TextWrapping="Wrap" Text=":" d:LayoutOverrides="Height" Margin="{DynamicResource Thickness-Right-10}" VerticalAlignment="Center"/>
				<TextBlock Grid.Column="1" HorizontalAlignment="Center" Grid.Row="3" TextWrapping="Wrap" Text=":" d:LayoutOverrides="Height" Margin="{DynamicResource Thickness-Right-10}" VerticalAlignment="Center"/>
				<TextBlock Grid.Column="1" HorizontalAlignment="Center" Grid.Row="4" TextWrapping="Wrap" Text=":" d:LayoutOverrides="Height" Margin="{DynamicResource Thickness-Right-10}" VerticalAlignment="Center"/>
				<TextBlock Grid.Column="1" HorizontalAlignment="Center" Grid.Row="5" TextWrapping="Wrap" Text=":" d:LayoutOverrides="Height" Margin="{DynamicResource Thickness-Right-10}" VerticalAlignment="Center"/>
				<TextBlock Grid.Column="1" HorizontalAlignment="Center" Grid.Row="6" TextWrapping="Wrap" Text=":" d:LayoutOverrides="Height" Margin="{DynamicResource Thickness-Right-10}" VerticalAlignment="Center"/>
				<Label Content="{Binding Path=FECHALLEGADA, StringFormat=d}" Grid.Column="2" d:LayoutOverrides="Height" MinHeight="25.96" />
				<Label Content="{Binding ID_TIPORADICACION, Converter={StaticResource ParametroNombreConverter}}" Grid.Column="2" Grid.Row="1" d:LayoutOverrides="Height" MinHeight="25.96"/>
				<StackPanel Grid.Column="2" Grid.Row="2" Orientation="Horizontal">
					<TextBox x:Name="txbNumeroFormulario" TextWrapping="Wrap" MinWidth="150" Margin="{DynamicResource Thickness-Right-10}" Text="{Binding NRO_FORMULARIO, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
					<StackPanel x:Name="spGenerar" Orientation="Horizontal" Visibility="{Binding NRO_FORMULARIO, ConverterParameter=LogicalNegation, Converter={StaticResource ObjetoNuloAVisibilidadConverter}}">
						<Label Content="{Binding Path=Serie, Source={StaticResource ControlesDataSource}}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cbxSerie" HorizontalAlignment="Left" VerticalAlignment="Center" Width="40" Margin="0,0,5,0" Initialized="cbxSerie_Initialized"/>
						<Button x:Name="btnGenerarNumeroFormulario" Content="{Binding Generar, Source={StaticResource ControlesDataSource}}" Width="75" Click="btnGenerarNumeroFormulario_Click"/>
					</StackPanel>
				</StackPanel>
				<ComboBox x:Name="cbxPais" Grid.Column="2" Grid.Row="3" d:LayoutOverrides="Height" HorizontalAlignment="Left" MinWidth="150"/>
				<ComboBox x:Name="cbxDepartamento" Grid.Column="2" HorizontalAlignment="Left" Grid.Row="4" d:LayoutOverrides="Height" MinWidth="150"/>
				<ComboBox x:Name="cbxMunicipio" Grid.Column="2" HorizontalAlignment="Left" Grid.Row="5" d:LayoutOverrides="Height" MinWidth="150"/>
				<ComboBox x:Name="cbxEntidad" Grid.Column="2" HorizontalAlignment="Left" Grid.Row="6" d:LayoutOverrides="Height" MinWidth="150"/>
                <Ruv_WPF_Captura_Controles:Geografia Grid.Row="7" Grid.RowSpan="2" ComboPais="{Binding ElementName=cbxPais, Mode=OneWay}" ComboDepartamento="{Binding ElementName=cbxDepartamento, Mode=OneWay}" ComboMunicipio="{Binding ElementName=cbxMunicipio, Mode=OneWay}" ComboEntidadMunicipio="{Binding ElementName=cbxEntidad, Mode=OneWay}" PaisId="{Binding ID_PAIS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DepartamentoId="{Binding ID_DEPARTAMENTO, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MunicipioId="{Binding ID_MUNICIPIO, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EntidadMunicipioId="{Binding ID_ENTIDADMUNICIPIO, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
			</Grid>
		</GroupBox>
		<GroupBox Header="{Binding Declarante, Source={StaticResource ControlesDataSource}}" Grid.Row="1" d:LayoutOverrides="Width" Padding="{DynamicResource Thickness-10}" Margin="{DynamicResource Thickness-Bottom-10}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<TextBlock Text="{Binding PrimerNombre, Source={StaticResource ControlesDataSource}}" HorizontalAlignment="Left" d:LayoutOverrides="Height" VerticalAlignment="Center" Margin="{DynamicResource Thickness-Right-10}"/>
				<TextBlock Text="{Binding SegundoNombre, Source={StaticResource ControlesDataSource}}" HorizontalAlignment="Left" Grid.Row="1" d:LayoutOverrides="Height" VerticalAlignment="Center" Margin="{DynamicResource Thickness-Right-10}"/>
				<TextBlock Text="{Binding PrimerApellido, Source={StaticResource ControlesDataSource}}" HorizontalAlignment="Left" Grid.Row="2" d:LayoutOverrides="Height" VerticalAlignment="Center" Margin="{DynamicResource Thickness-Right-10}"/>
				<TextBlock Text="{Binding SegundoApellido, Source={StaticResource ControlesDataSource}}" HorizontalAlignment="Left" Grid.Row="3" d:LayoutOverrides="Height" VerticalAlignment="Center" Margin="{DynamicResource Thickness-Right-10}"/>
				<TextBlock Text="{Binding TipoDocumento, Source={StaticResource ControlesDataSource}}" HorizontalAlignment="Left" Grid.Row="4" d:LayoutOverrides="Height" VerticalAlignment="Center" Margin="{DynamicResource Thickness-Right-10}"/>
				<TextBlock Text="{Binding NumeroDocumento, Source={StaticResource ControlesDataSource}}" HorizontalAlignment="Left" Grid.Row="5" d:LayoutOverrides="Height" VerticalAlignment="Center" Margin="{DynamicResource Thickness-Right-10}"/>
				<TextBlock Grid.Column="1" HorizontalAlignment="Center" TextWrapping="Wrap" Text=":" d:LayoutOverrides="Height" Margin="{DynamicResource Thickness-Right-10}" VerticalAlignment="Center"/>
				<TextBlock Grid.Column="1" HorizontalAlignment="Center" Grid.Row="1" TextWrapping="Wrap" Text=":" VerticalAlignment="Center" Margin="{DynamicResource Thickness-Right-10}"/>
				<TextBlock Grid.Column="1" HorizontalAlignment="Center" Grid.Row="2" TextWrapping="Wrap" Text=":" d:LayoutOverrides="Height" Margin="{DynamicResource Thickness-Right-10}" VerticalAlignment="Center"/>
				<TextBlock Grid.Column="1" HorizontalAlignment="Center" Grid.Row="3" TextWrapping="Wrap" Text=":" d:LayoutOverrides="Height" Margin="{DynamicResource Thickness-Right-10}" VerticalAlignment="Center"/>
				<TextBlock Grid.Column="1" HorizontalAlignment="Center" Grid.Row="4" TextWrapping="Wrap" Text=":" d:LayoutOverrides="Height" Margin="{DynamicResource Thickness-Right-10}" VerticalAlignment="Center"/>
				<TextBlock Grid.Column="1" HorizontalAlignment="Center" Grid.Row="5" TextWrapping="Wrap" Text=":" d:LayoutOverrides="Height" Margin="{DynamicResource Thickness-Right-10}" VerticalAlignment="Center"/>
				<Label Grid.Column="2" Content="{Binding PrimerNombre}" d:LayoutOverrides="Height" VerticalAlignment="Center" MinHeight="25.96"/>
				<Label Grid.Column="2" Grid.Row="1" Content="{Binding SegundoNombre}" d:LayoutOverrides="Height" VerticalAlignment="Center" MinHeight="25.96"/>
				<Label Grid.Column="2" Grid.Row="2" Content="{Binding PrimerApellido}" d:LayoutOverrides="Height" VerticalAlignment="Center" MinHeight="25.96"/>
				<Label Grid.Column="2" Grid.Row="3" Content="{Binding SegundoApellido}" d:LayoutOverrides="Height" VerticalAlignment="Center" MinHeight="25.96"/>
				<Label Grid.Column="2" Grid.Row="4" Content="{Binding TipoDocumento, Converter={StaticResource ParametroNombreConverter}}" d:LayoutOverrides="Height" VerticalAlignment="Center" MinHeight="25.96"/>
				<Label Grid.Column="2" Grid.Row="5" Content="{Binding NumeroDocumento}" d:LayoutOverrides="Height" VerticalAlignment="Center" MinHeight="25.96"/>
			</Grid>
		</GroupBox>
		<Grid Grid.Row="2" Margin="{DynamicResource Thickness-Bottom-10}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition/>
			</Grid.ColumnDefinitions>
			<TextBlock Text="{Binding Observaciones, Source={StaticResource ControlesDataSource}}" Margin="{DynamicResource Thickness-Right-10}" VerticalAlignment="Center"/>
			<TextBlock Grid.Column="1" HorizontalAlignment="Center" TextWrapping="Wrap" Text=":" d:LayoutOverrides="Height" Margin="{DynamicResource Thickness-Right-10}" VerticalAlignment="Center"/>
			<ScrollViewer Grid.Column="2" MaxHeight="300">
				<TextBlock Text="{Binding OBSERVACIONES}" TextWrapping="Wrap" MinHeight="25.96" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
			</ScrollViewer>
		</Grid>
        <Button x:Name="btnImagen" Content="{Binding VerImagen, Source={StaticResource ControlesDataSource}}" Grid.Row="3" d:LayoutOverrides="Height" HorizontalAlignment="Left" Click="btnImagen_Click" Visibility="{Binding RUTAIMAGEN, Converter={StaticResource ObjetoNuloAVisibilidadConverter}}" Margin="6,0" />
        <GroupBox Grid.Row="4" x:Name="gbxCambiarImagen" Header="Cambiar imagen" Margin="0,6" Width="293" HorizontalAlignment="Left">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="0,6">
                    <Button x:Name="btnSeleccionar" Content="Seleccionar" Height="23" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Margin="6,0" Click="btnSeleccionar_Click" />
                    <TextBox x:Name="txtRutaImagen" IsReadOnly="True" Height="20" HorizontalAlignment="Left" Margin="6,0" VerticalAlignment="Top" Width="181" />
                </StackPanel>
                <Button Grid.Row="1" Content="Cambiar Imagen" Height="23" HorizontalAlignment="Left" Margin="6,0" Name="btnCambiaImagen" VerticalAlignment="Top" Width="122" Click="BtnCambiaImagen_Click" />
            </Grid>
        </GroupBox>
    </Grid>
    
</UserControl>