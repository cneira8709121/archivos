<Window xmlns:my1="clr-namespace:Ruv.WPF.Captura.Registro.Secciones.Controles"
        xmlns:my="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
        x:Class="Ruv.WPF.Captura.Tmp.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Window3"
        Height="300"
        Width="300">
  <StackPanel>
    <my1:AutorDespojo ValorSeleccionado="{Binding Valor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" 
                      Texto="{Binding Texto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                      />
  </StackPanel>
</Window>
