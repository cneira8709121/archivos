<Window x:Class="Ruv.WPF.Captura.Tmp.Window7"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Window7"
        Height="300"
        Width="300"
        Background="#FFFDCBFF">
  <StackPanel Grid.IsSharedSizeScope="True">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" SharedSizeGroup="c01" />
        <ColumnDefinition Width="1*" SharedSizeGroup="c02" />
        <ColumnDefinition Width="1*" SharedSizeGroup="c03" />
      </Grid.ColumnDefinitions>
      <Border Background="Red"
              Height="50" />
      <Border Background="Blue"
              Grid.Column="1"
              Height="50" />
      <Border Background="Red"
              Grid.Column="2"
              Height="50" />
    </Grid>
    <Grid HorizontalAlignment="Left">
      <Grid.ColumnDefinitions>
        <ColumnDefinition SharedSizeGroup="c01" />
        <ColumnDefinition SharedSizeGroup="c02" />
        <ColumnDefinition SharedSizeGroup="c03" />
      </Grid.ColumnDefinitions>
      <Border Background="Red"
              Height="50" />
      <Border Background="Blue"
              Grid.Column="1"
              Height="50" />
      <Border Background="Red"
              Grid.Column="2"
              Height="50" />
    </Grid>

  </StackPanel>

</Window>
