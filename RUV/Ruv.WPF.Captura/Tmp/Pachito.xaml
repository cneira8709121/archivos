<Window x:Class="Ruv.WPF.Captura.Tmp.Pachito"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:congen="clr-namespace:Ruv.WPF.Captura.Controles"
        Title="Pachito" Height="352" Width="502" xmlns:my="clr-namespace:Ruv.WPF.Captura.Registro.Secciones">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <Grid>
        <DatePicker Height="25" HorizontalAlignment="Left" Margin="151,6,0,0" Name="datePicker1" VerticalAlignment="Top" Width="115" />
        <Calendar Margin="0,0,12,75" Name="calendar1" HorizontalAlignment="Right" Width="180" Height="170" VerticalAlignment="Bottom" />
        <TextBlock Height="23" HorizontalAlignment="Left" Margin="21,12,0,0" Name="textBlock1" Text="Fecha de registro" VerticalAlignment="Top" />
        <my:ListaOpciones TipoParametros="Entidades" TipoOpciones="Unica" HorizontalAlignment="Left" Margin="21,110,0,0" x:Name="listaOpciones1" VerticalAlignment="Top" Height="44" Width="148" />
        <TextBox Height="23" HorizontalAlignment="Left" Margin="210,227,0,0" Name="textBox1" VerticalAlignment="Top" Width="120" />
        <ComboBox x:Name="cb01TipoDoc"
                    SelectedValuePath="Id"
                    DisplayMemberPath="Nombre"
                    ItemsSource="{Binding Converter={StaticResource ParametrosConverter}, ConverterParameter=TipoDeDocumentoDeIdentidad}"
                    SelectedValue="{Binding Encargado.RepresentanteTipoDocumento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" Margin="57,173,209,101" />
        <congen:Geografia x:Name="geo02"
                        ComboDepartamento="{Binding ElementName=cbDeptoDeclarante}"
                        ComboMunicipio="{Binding ElementName=cbMcpioDeclarante}"
                        DepartamentoId="{Binding DatoContactoDepartamento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                        MunicipioId="{Binding DatoContactoMunicipio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" Margin="71,52,231,183" />
        <ComboBox Height="23" HorizontalAlignment="Left" Margin="94,252,0,0" Name="cbDeptoDeclarante" VerticalAlignment="Top" Width="120" />
        <ComboBox Height="23" HorizontalAlignment="Left" Margin="94,281,0,0" Name="cbMcpioDeclarante" VerticalAlignment="Top" Width="120" />
    </Grid>
    </ScrollViewer>
</Window>
