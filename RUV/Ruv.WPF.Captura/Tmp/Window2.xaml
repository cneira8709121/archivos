<Window x:Class="Ruv.WPF.Captura.Tmp.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Window2"
        Height="300"
        Width="300">
  <Grid>
    <Border x:Name="borBloqueoInterfase"
            Background="#55A0A0A0">
      <Border.Resources>
        <Storyboard x:Key="sbBloqueoInterfase">
          <DoubleAnimation Storyboard.TargetName="rtOcupado"
                           Storyboard.TargetProperty="Angle"
                           From="0"
                           To="360"
                           Duration="0:0:1" />
        </Storyboard>
      </Border.Resources>
      <Ellipse  StrokeThickness="10"
                StrokeDashArray="6 6"
                Width="90"
                Height="90"
                Stroke="Black">
        <Ellipse.RenderTransform>
          <RotateTransform x:Name="rtOcupado"
                           CenterX="35"
                           CenterY="35"
                           Angle="0" />
        </Ellipse.RenderTransform>
      </Ellipse>
    </Border>
  </Grid>
</Window>
