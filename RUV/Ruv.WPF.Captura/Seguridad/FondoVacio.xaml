<Page x:Class="Ruv.WPF.Captura.Seguridad.FondoVacio"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="365"
      d:DesignWidth="565"
      Title="FondoVacio">

  <Grid>
    <Image HorizontalAlignment="Center"
           VerticalAlignment="Center"
           Width="660"
           Height="160"
           Opacity="0"
           Source="/Ruv.WPF.Captura;component/Recursos/Imagenes/logosUnidad.png"
           Stretch="Fill">
      <Image.RenderTransform>
        <ScaleTransform ScaleX="0.5"
                        ScaleY="0.5"
                        CenterX="295"
                        CenterY="115" />
      </Image.RenderTransform>
      <Image.Style>
        <Style TargetType="Image">
          <Style.Triggers>
            <EventTrigger RoutedEvent="Image.Loaded">
              <EventTrigger.Actions>
                <BeginStoryboard>
                  <Storyboard BeginTime="0:0:0.5">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="1"
                                     Duration="0:0:1"
                                     FillBehavior="HoldEnd" />
                    <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).ScaleX"
                                     To="1"
                                     Duration="0:0:1"
                                     FillBehavior="HoldEnd">
                      <DoubleAnimation.EasingFunction>
                        <CircleEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).ScaleY"
                                     To="1"
                                     Duration="0:0:1"
                                     FillBehavior="HoldEnd">
                      <DoubleAnimation.EasingFunction>
                        <CircleEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger.Actions>
            </EventTrigger>
          </Style.Triggers>
        </Style>
      </Image.Style>
    </Image>
    <Image HorizontalAlignment="Right"
           VerticalAlignment="Bottom"
           Source="/Ruv.WPF.Captura;component/Recursos/Imagenes/ProsperidadParaTodos.png"
           Stretch="None">
    </Image>
  </Grid>
</Page>
