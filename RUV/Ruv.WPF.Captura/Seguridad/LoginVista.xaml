<Page x:Class="Ruv.WPF.Captura.Seguridad.LoginVista"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="800"
      d:DesignWidth="800"
      Title="LoginView">
    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="HorizontalAlignment"
              Value="Center" />
        </Style>

        <Storyboard x:Key="sbMensajeOpen">
            <DoubleAnimation Storyboard.TargetProperty="Height"
                       Duration="0:0:0.5"
                       From="0"
                       To="60"
                       FillBehavior="HoldEnd">
                <DoubleAnimation.EasingFunction>
                    <CubicEase />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="sbMensajeClose">
            <DoubleAnimation Storyboard.TargetProperty="Height"
                       Duration="0:0:0.5"
                       From="60"
                       To="0"
                       FillBehavior="HoldEnd">
                <DoubleAnimation.EasingFunction>
                    <CubicEase />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="sbMensajeAutenticando">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                       Duration="0:0:0.4"
                       AutoReverse="True"
                       RepeatBehavior="Forever"
                       From="1"
                       To="0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

    </Page.Resources>
    <Grid Margin="0,50,0,0">

        <Grid.RowDefinitions>
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid x:Name="grdIngresar"
          IsEnabled="{Binding EstaHabilitado}"
          VerticalAlignment="Top"
          Width="400">
            <Grid.ColumnDefinitions>
                <ColumnDefinition  Width="125*" />
                <ColumnDefinition  Width="275*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>
            <Border CornerRadius="10,10,0,0"
              Grid.ColumnSpan="2"
              Background="#e78035">
                <TextBlock Foreground="White"
                   VerticalAlignment="Center"
                   FontSize="16">Autenticación</TextBlock>
            </Border>
            <Border CornerRadius="0,0,10,10"
              Grid.Row="1"
              Grid.ColumnSpan="2"
              Grid.RowSpan="6"
              BorderBrush="Black"
              BorderThickness="2,0,2,2"></Border>
            <TextBlock Grid.Row="1"
                 FontSize="14"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Right">Usuario:</TextBlock>
            <TextBlock Grid.Row="2"
                 FontSize="14"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Right">Contraseña:</TextBlock>
            <TextBlock Grid.Row="3"
                 FontSize="14" 
                 VerticalAlignment="Center"
                 HorizontalAlignment="Right">Token:</TextBlock>
            <!--luisesteban  ASocial11%-->
            <TextBox x:Name="tbxUsuario"
               Text=""
               Height="25"
               Width="200"
               Foreground="Blue"
               FontSize="14"
               HorizontalAlignment="Left"
               Margin="5,0"
               Grid.Row="1"
               Grid.Column="1"
               TabIndex="1" />
            <PasswordBox x:Name="tbxContraseña"
                   FontSize="14"
                   Password=""
                   Foreground="Blue"
                   Height="25"
                   Width="200"
                   HorizontalAlignment="Left"
                   Margin="5,0"
                   Grid.Row="2"
                   Grid.Column="1"
                   TabIndex="2" />
            <Button x:Name="btnToken"
              Content="No seleccionado"
              Style="{StaticResource styLinkButton}"
              Click="Token_Click"
              IsDefault="False"
              Grid.Column="1"
              Grid.Row="3"
              Margin="5,0"
              VerticalAlignment="Center"
              HorizontalAlignment="Left"
              TabIndex="3" />
            <Button Content="INGRESAR"
              x:Name="btnIngresar"
              Click="Ingresar_Click"
              IsDefault="True"
              Grid.Column="1"
              Grid.Row="4"
              Width="200"
              Height="25"
              Margin="5,0"
              HorizontalAlignment="Left"
              TabIndex="4" />
            <Button x:Name="btnRecuperarClave" 
                    Content="¿Olvido su clave?" 
                    Style="{StaticResource styLinkButton}"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Click="btnRecuperarClave_Click"
                    Grid.Row="5"/>
            <TextBlock x:Name="txtMensaje"
                 Text="{Binding Mensaje}"
                 TextWrapping="Wrap"
                 HorizontalAlignment="Stretch"
                 TextAlignment="Center"
                 FontSize="14"
                 Margin="10"
                 Grid.Row="6"
                 Grid.ColumnSpan="2">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=txtMensaje}"
                             Value="">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <StaticResource ResourceKey="sbMensajeClose" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <StaticResource ResourceKey="sbMensajeOpen" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, ElementName=txtMensaje}"
                             Value="Autenticando">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Name="BSB01">
                                        <Storyboard>
                                            <StaticResource ResourceKey="sbMensajeAutenticando" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="BSB01" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

    </Grid>
</Page>
