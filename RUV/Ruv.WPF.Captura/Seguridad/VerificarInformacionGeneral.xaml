<Page x:Class="Ruv.WPF.Captura.Seguridad.VerificarInformacionGeneral"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="300"
      d:DesignWidth="300"
      Title="VerificarInformacionGeneral">

  <StackPanel x:Name="spMain"
              Visibility="Hidden"
              Orientation="Vertical"
              VerticalAlignment="Center">
    <TextBlock TextAlignment="Center"
               FontSize="16"
               Text="Preparando ambiente fuera de línea" />
    <TextBlock Margin="0,10,0,0"
               Width="300"
               TextWrapping="Wrap"
               Foreground="Gray"
               TextAlignment="Center"
               Text="{Binding Source={StaticResource RUV}, Path=InfoGeneral.EstadoDescarga}" />
    <ProgressBar Height="21"
                 HorizontalAlignment="Center"
                 Name="progressBar1"
                 Value="{Binding Source={StaticResource RUV}, Path=InfoGeneral.PorcentajeDescarga}"
                 Width="300">
      <ProgressBar.Style>
        <Style TargetType="ProgressBar">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Source={StaticResource RUV}, Path=InfoGeneral.EstadoDescarga}"
                         Value="0d">
              <Setter Property="IsIndeterminate"
                      Value="True" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ProgressBar.Style>
    </ProgressBar>
  </StackPanel>
</Page>
