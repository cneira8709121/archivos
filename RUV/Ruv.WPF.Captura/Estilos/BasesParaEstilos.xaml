<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--ESTILOS BASE-->
  <Style x:Key="styRadioCaja"
         TargetType="Border">
    <Setter Property="Width"
            Value="{DynamicResource RadioCajaAncho}" />
    <Setter Property="Height"
            Value="{DynamicResource RadioCajaAlto}" />
    <Setter Property="CornerRadius"
            Value="0" />
    <Setter Property="BorderBrush"
            Value="Black" />
    <Setter Property="BorderThickness"
            Value="1" />
  </Style>

  <Style x:Key="styBaseTextBlockNormal"
         TargetType="TextBlock">
    <Setter Property="FontSize"
            Value="{DynamicResource TamañoTextoNormal}" />
    <Setter Property="FontFamily"
            Value="{DynamicResource TipoLetraEstandar}" />
  </Style>

  <Style x:Key="styBaseComboboxNormal"
         TargetType="ComboBox">
    <Setter Property="FontSize"
            Value="{DynamicResource TamañoTextoNormal}" />
    <Setter Property="FontFamily"
            Value="{DynamicResource TipoLetraEstandar}" />
    <Style.Triggers>
      <Trigger Property="Validation.HasError"
               Value="true">
        <Setter Property="ToolTip"
                Value="{Binding RelativeSource={RelativeSource Self}, 
                       Path=(Validation.Errors)[0].ErrorContent}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="styBaseTextBlockGrande"
         TargetType="TextBlock">
    <Setter Property="FontSize"
            Value="{DynamicResource TamañoTextoGrande}" />
    <Setter Property="FontFamily"
            Value="{DynamicResource TipoLetraEstandar}" />
  </Style>

  <Style x:Key="styBaseTextBlockPequeño"
         TargetType="TextBlock">
    <Setter Property="FontSize"
            Value="{DynamicResource TamañoTextoPequeño}" />
    <Setter Property="FontFamily"
            Value="{DynamicResource TipoLetraEstandar}" />
    <Setter Property="TextWrapping"
            Value="Wrap" />
  </Style>

  <Style x:Key="styBaseTextBoxNormal"
         TargetType="TextBox">
    <Setter Property="FontSize"
            Value="{DynamicResource TamañoTextoNormal}" />
    <Setter Property="FontFamily"
            Value="{DynamicResource TipoLetraEstandar}" />
    <Setter Property="Foreground"
            Value="{DynamicResource ColorValorEntrada}" />
    <Style.Triggers>
      <Trigger Property="Validation.HasError"
               Value="true">
        <Setter Property="ToolTip"
                Value="{Binding RelativeSource={RelativeSource Self}, 
                       Path=(Validation.Errors)[0].ErrorContent}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="styBaseTextBlockRadioNormal"
         TargetType="TextBlock">
    <Setter Property="FontSize"
            Value="{DynamicResource TamañoTextoNormal}" />
    <Setter Property="FontFamily"
            Value="{DynamicResource TipoLetraEstandar}" />
    <Setter Property="Foreground"
            Value="{DynamicResource ColorValorEntrada}" />
    <Setter Property="Text"
            Value="X" />
    <Setter Property="FontWeight"
            Value="ExtraBold" />
    <Setter Property="HorizontalAlignment"
            Value="Center" />
    <Setter Property="VerticalAlignment"
            Value="Center" />
  </Style>

  <Style TargetType="Label"
         x:Key="styBaseLabelNormal">
    <Setter Property="DockPanel.Dock"
            Value="Left" />
    <Setter Property="Background"
            Value="Black" />
    <Setter Property="Foreground"
            Value="White" />
    <Setter Property="Padding"
            Value="7,2" />
    <Setter Property="FontSize"
            Value="{DynamicResource TamañoTextoNormal}" />
  </Style>

  <Style TargetType="TextBlock"
         BasedOn="{StaticResource styBaseTextBlockNormal}" />

  <Style TargetType="TextBox"
         BasedOn="{StaticResource styBaseTextBoxNormal}" />

  <SolidColorBrush x:Key="scbFondoSubtitulo"
                   Color="LightGray" />

    

</ResourceDictionary>