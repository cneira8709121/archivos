<Page
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:Recursos="clr-namespace:Ruv.WPF.Captura.Recursos" 
	xmlns:Ruv.Infrastructure.Crosscutting.Common.Entidades_GestionFormulario="clr-namespace:Ruv.Infrastructure.Crosscutting.Common.Entidades.GestionFormulario;assembly=Ruv.Infrastructure.Crosscutting.Common" 
    mc:Ignorable="d"
	xmlns:ctrl="clr-namespace:Ruv.WPF.Captura.Controles"
	xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
	xmlns:utils="clr-namespace:Ruv.WPF.Captura.Utils"
	xmlns:Enumeraciones="clr-namespace:Ruv.Infrastructure.Crosscutting.Common;assembly=Ruv.Infrastructure.Crosscutting.Common"
	x:Class="Ruv.WPF.Captura.GeneracionFormulario"
	xmlns:System="clr-namespace:System;assembly=mscorlib"
	xmlns:Converters="clr-namespace:Ruv.WPF.Captura.Converters" 
    xmlns:DataSource="clr-namespace:Ruv.WPF.Captura.Utils.DataSources"
	x:Name="Window"
	xmlns:Ruv_WPF_Captura_Controles="clr-namespace:Ruv.WPF.Captura.Controles"
	Title="GeneracionFormulario"
	Width="1006" Height="517" Loaded="Window_Loaded">

    <Page.Resources>
        <Ruv.Infrastructure.Crosscutting.Common.Entidades_GestionFormulario:clsFormulario x:Key="FormularioDataSource" d:IsDataSource="True"/>
        <Recursos:Controles x:Key="ControlesDataSource" d:IsDataSource="True"/>
        <Converters:VisibilidadConverter x:Key="VisibilidadConverter"/>
        <Converters:ConsultaDatoConverter x:Key="ConsultaDato"/>
        <ObjectDataProvider MethodName="GetValues" ObjectType="{x:Type System:Enum}" x:Key="sysEnum">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="Enumeraciones:eEstadoFormulario" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <DataSource:FormulariosUsuarioDataSource x:Key="Datos" />
        <Style TargetType="{x:Type Ruv_WPF_Captura_Controles:PaggingControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Ruv_WPF_Captura_Controles:PaggingControl}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="23" >
                            <Button Name="PART_FirstPageButton" Content="&lt;&lt;" Width="40" Height="23" />
                            <Button Name="PART_PreviousPageButton" Content="&lt;" Width="40" Height="23" />
                            <TextBlock Text="Pagina Actual:" TextAlignment="Center" Width="100" HorizontalAlignment="Stretch" VerticalAlignment="Center"  />
                            <TextBox Name="PART_PageTextBox" Width="40" Height="23"  />
                            <TextBlock Text="Total paginas:" TextAlignment="Center" Width="100" HorizontalAlignment="Stretch" VerticalAlignment="Center"  />
                            <TextBlock Text="{Binding TotalPages, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Width="50" />
                            <Button Name="PART_NextPageButton" Content="&gt;" Width="40" Height="23" />
                            <Button Name="PART_LastPageButton" Content="&gt;&gt;" Width="40" Height="23" />
                            <ComboBox Name="PART_PageSizesCombobox" Width="60" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="Foreground" Value="Red" />
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type DatePicker}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="Foreground" Value="Red" />
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid x:Name="LayoutRoot" >

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="15,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel FlowDirection="LeftToRight" Orientation="Horizontal">
                        <Label FontStretch="ExtraExpanded" FontWeight="ExtraBold" Content="{Binding Path=GeneracionDocumentos, Source={StaticResource ControlesDataSource}}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Label Content="{Binding Path=Serie, Source={StaticResource ControlesDataSource}}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cbxSerie" HorizontalAlignment="Left" VerticalAlignment="Center" Initialized="cbxSerie_Initialized" Margin="5,0,0,0" Width="40" SelectedValue="{Binding CSerie, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                        <Label Content="{Binding Cantidad, Source={StaticResource ControlesDataSource}}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox x:Name="txbCantidad" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" Width="100" MaxLength="5" Text="{Binding NCantidad}" >
                            <i:Interaction.Behaviors>
                                <utils:clsTextBoxFilterBehavior ConjuntoDeCaracteres="SoloDigitos" />
                            </i:Interaction.Behaviors>
                        </TextBox>
                        <Button x:Name="btnGenerar" VerticalAlignment="Center" Margin="25,0,0,0" Content="{Binding Path=Generar, Source={StaticResource ControlesDataSource}}" Click="btnGenerar_Click"/>
                    </StackPanel>
                    <StackPanel FlowDirection="LeftToRight" Orientation="Horizontal" Grid.Row="1">
                        <Label FontStretch="ExtraExpanded" FontWeight="ExtraBold" Content="{Binding Path=Filtro, Source={StaticResource ControlesDataSource}}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Label Content="{Binding Path=Serie, Source={StaticResource ControlesDataSource}}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cbxSerieBuscar" HorizontalAlignment="Left" VerticalAlignment="Center" Initialized="cbxSerie_Initialized" Margin="5,0,0,0" Width="40" SelectedValue="{Binding Path=CSerieBuscar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                        <Label Content="{Binding Path=Rango, Source={StaticResource ControlesDataSource}}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox x:Name="txbDesde" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" Width="50" MaxLength="9" Text="{Binding Path=NDesde, Mode=TwoWay, TargetNullValue='', ValidatesOnDataErrors=True, NotifyOnValidationError=True}" >
                            <i:Interaction.Behaviors>
                                <utils:clsTextBoxFilterBehavior ConjuntoDeCaracteres="SoloDigitos" />
                            </i:Interaction.Behaviors>
                        </TextBox>
                        <Label Content="-" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox x:Name="txbHasta" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" Width="50" MaxLength="9" Text="{Binding Path=NHasta, Mode=TwoWay, TargetNullValue='', ValidatesOnDataErrors=True, NotifyOnValidationError=True}" >
                            <i:Interaction.Behaviors>
                                <utils:clsTextBoxFilterBehavior ConjuntoDeCaracteres="SoloDigitos" />
                            </i:Interaction.Behaviors>
                        </TextBox>
                        <Label Content="{Binding Path=FechaGenerado, Source={StaticResource ControlesDataSource}}" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
                        <DatePicker x:Name="dpGenerado" SelectedDate="{Binding Path=DGenerado, Mode=TwoWay, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" Visibility="Collapsed" />
                        <Button x:Name="btnBuscar" VerticalAlignment="Center" Margin="25,0,0,0" Content="{Binding Path=Buscar, Source={StaticResource ControlesDataSource}}" Click="btnBuscar_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=BSePuedeBuscar}" Value="True">
                                            <Setter Property="Button.IsEnabled" Value="True" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=BSePuedeBuscar}" Value="False">
                                            <Setter Property="Button.IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="btnSepararFiltro" VerticalAlignment="Center" Margin="10,0,0,0" Content="{Binding SepararImprenta, Mode=OneWay, Source={StaticResource ControlesDataSource}}" Click="btnSepararFiltro_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=BSePuedeSeparar}" Value="True">
                                            <Setter Property="Button.IsEnabled" Value="True" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=BSePuedeSeparar}" Value="False">
                                            <Setter Property="Button.IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="btnDistribuirFiltro" VerticalAlignment="Center" Margin="10,0,0,0" Content="{Binding Distribuir,  Source={StaticResource ControlesDataSource}}" Click="btnDistribuirFiltro_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=BSePuedeDistribuir}" Value="True">
                                            <Setter Property="Button.IsEnabled" Value="True" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=BSePuedeDistribuir}" Value="False">
                                            <Setter Property="Button.IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
                <StackPanel FlowDirection="RightToLeft" Orientation="Horizontal" Grid.Column="1">
                    <ComboBox Height="23" Name="cbxEstados" Width="120" FlowDirection="LeftToRight" VerticalAlignment="Center" 
                              SelectionChanged="cbxEstados_SelectionChanged"
                              ItemsSource="{Binding Source={StaticResource sysEnum}}" 
                              SelectedValue="{Binding Path=EFiltro, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Name="Estado" VerticalAlignment="Center" Content="{Binding Path=Estado, Source={StaticResource ControlesDataSource}}" ></Label>
                </StackPanel>
            </Grid>

            <DataGrid x:Name="dgFormulario" AutoGenerateColumns="False" Grid.Row="1" Margin="15,0,15,10" IsReadOnly="{Binding Path=BSoloLectura, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                      ItemsSource="{Binding LstFormularios, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding Path=BSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="30">
                        <DataGridCheckBoxColumn.Header>
                            <CheckBox Name="chkAll" Visibility="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Page}}, Path=DataContext.BSeleccionMasiva, Converter={StaticResource VisibilidadConverter}}" Checked="cbx_CheckedUncheckedAll" Unchecked="cbx_CheckedUncheckedAll" />
                        </DataGridCheckBoxColumn.Header>
                        <DataGridCheckBoxColumn.CellStyle>
                            <Style>
                                <EventSetter Event="CheckBox.Checked" Handler="cbx_CheckedUnchecked"/>
                                <EventSetter Event="CheckBox.Unchecked" Handler="cbx_CheckedUnchecked"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Page}}, Path=DataContext.BSeleccionMasiva}" Value="True">
                                        <Setter Property="CheckBox.Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Page}}, Path=DataContext.BSeleccionMasiva}" Value="False">
                                        <Setter Property="CheckBox.Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridCheckBoxColumn.CellStyle>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Header="{Binding CodigoFormulario, Mode=OneWay, Source={StaticResource ControlesDataSource}}" Binding="{Binding CNumeroFormulario, Mode=OneWay}" MinWidth="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{Binding FechaGenerado, Mode=OneWay, Source={StaticResource ControlesDataSource}}" Binding="{Binding DGenerado, Mode=OneWay, StringFormat={}{0:dd-MMM-yy HH:mm:ss}}" MinWidth="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{Binding Estado, Mode=OneWay, Source={StaticResource ControlesDataSource}}" Binding="{Binding EfId, Mode=OneWay}" MinWidth="110" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Geografia">
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <DockPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock DockPanel.Dock="Top" TextAlignment="Center" Text="{Binding Pais, Source={StaticResource ControlesDataSource}}"/>
                                        <ComboBox x:Name="cbxPais" Width="120" />
                                    </DockPanel>
                                    <DockPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock DockPanel.Dock="Top" TextAlignment="Center" Text="{Binding Departamento,  Source={StaticResource ControlesDataSource}}"/>
                                        <ComboBox x:Name="cbxDepartamento" Width="120" />
                                    </DockPanel>
                                    <DockPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock DockPanel.Dock="Top" TextAlignment="Center" Text="{Binding Municipio,  Source={StaticResource ControlesDataSource}}"/>
                                        <ComboBox x:Name="cbxMunicipio" Width="120" />
                                    </DockPanel>
                                    <DockPanel VerticalAlignment="Center">
                                        <TextBlock DockPanel.Dock="Top" TextAlignment="Center" Text="{Binding Entidad,  Source={StaticResource ControlesDataSource}}"/>
                                        <ComboBox x:Name="cbxEntidad" Width="120" />
                                    </DockPanel>
                                    <Ruv_WPF_Captura_Controles:Geografia ComboPais="{Binding ElementName=cbxPais}" ComboDepartamento="{Binding ElementName=cbxDepartamento}" ComboMunicipio="{Binding ElementName=cbxMunicipio}" ComboEntidadMunicipio="{Binding ElementName=cbxEntidad}" TodosLosPaises="False" PaisId="{Binding Path=NIdPais, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DepartamentoId="{Binding Path=NIdDepartamento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MunicipioId="{Binding Path=NIdMunicipio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EntidadMunicipioId="{Binding Path=NIdEntidad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <DockPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock DockPanel.Dock="Top" TextAlignment="Center" Text="{Binding Pais, Source={StaticResource ControlesDataSource}}"/>
                                        <TextBlock x:Name="txbPais" TextWrapping="Wrap" Text="{Binding Path=NIdPais,Mode=TwoWay, Converter={StaticResource ResourceKey=ConsultaDato},ConverterParameter=PAIS, TargetNullValue=NINGUNO}"/>
                                    </DockPanel>
                                    <DockPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock DockPanel.Dock="Top" TextAlignment="Center" Text="{Binding Departamento,  Source={StaticResource ControlesDataSource}}"/>
                                        <TextBlock x:Name="txbDepartamento" TextWrapping="Wrap" Text="{Binding Path=NIdDepartamento, Mode=TwoWay, Converter={StaticResource ResourceKey=ConsultaDato},ConverterParameter=DEPARTAMENTO, TargetNullValue=NINGUNO}"/>
                                    </DockPanel>
                                    <DockPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock DockPanel.Dock="Top" TextAlignment="Center" Text="{Binding Municipio,  Source={StaticResource ControlesDataSource}}"/>
                                        <TextBlock x:Name="txbMunicipio" TextWrapping="Wrap" Text="{Binding Path=NIdMunicipio, Mode=TwoWay, Converter={StaticResource ResourceKey=ConsultaDato},ConverterParameter=MUNICIPIO, TargetNullValue=NINGUNO}"/>
                                    </DockPanel>
                                    <DockPanel VerticalAlignment="Center">
                                        <TextBlock DockPanel.Dock="Top" TextAlignment="Center" Text="{Binding Entidad,  Source={StaticResource ControlesDataSource}}"/>
                                        <TextBlock x:Name="txbEntidad" TextWrapping="Wrap" Text="{Binding Path=NIdEntidad, Mode=TwoWay, Converter={StaticResource ResourceKey=ConsultaDato},ConverterParameter=ENTIDAD_MUNICIPIO, TargetNullValue=NINGUNO}"/>
                                    </DockPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{Binding Imprimir, Mode=OneWay, Source={StaticResource ControlesDataSource}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ctrl:ImageButton Image="{DynamicResource GenerarPdf}" Click="ImageButton_Click" ToolTip="{Binding GenerarPdf, Mode=OneWay, Source={StaticResource ControlesDataSource}}" >
                                    <Control.Style>
                                        <Style TargetType="{x:Type UserControl}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=EfId}" Value="ASIGNADO">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=EfId}" Value="GENERADO">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=EfId}" Value="INACTIVO">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=EfId}" Value="IMPRENTA">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=EfId}" Value="RADICADO">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=EfId}" Value="DEVULETO">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Control.Style>
                                </ctrl:ImageButton>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
            <Ruv_WPF_Captura_Controles:PaggingControl x:Name="pageControl" Grid.Row="2" Height="25"
                              PageContract="{StaticResource Datos}"
                              PreviewPageChange="pageControl_PreviewPageChange"
                              PageChanged="pageControl_PageChanged">
                <Ruv_WPF_Captura_Controles:PaggingControl.PageSizes>
                    <System:UInt32>10
                    </System:UInt32>
                    <System:UInt32>20
                    </System:UInt32>
                    <System:UInt32>50
                    </System:UInt32>
                    <System:UInt32>100
                    </System:UInt32>
                </Ruv_WPF_Captura_Controles:PaggingControl.PageSizes>
            </Ruv_WPF_Captura_Controles:PaggingControl>
            <GroupBox x:Name="gbxGestionMasiva" Padding="{DynamicResource Thickness-10}" Grid.Row="3" Header="{Binding GestionMasiva, Mode=OneWay}" Visibility="{Binding Path=VisibilidadMasivos, Converter={StaticResource VisibilidadConverter}, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Margin="15,0,15,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="0.21*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="{Binding UbicacionGeografica, Mode=OneWay}" Padding="{DynamicResource Thickness-10}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <DockPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock DockPanel.Dock="Top" TextAlignment="Center" Text="{Binding Pais, Source={StaticResource ControlesDataSource}}"/>
                                <ComboBox x:Name="cbxPais" Width="120" />
                            </DockPanel>
                            <DockPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock DockPanel.Dock="Top" TextAlignment="Center" Text="{Binding Departamento,  Source={StaticResource ControlesDataSource}}"/>
                                <ComboBox x:Name="cbxDepartamento" Width="120" />
                            </DockPanel>
                            <DockPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock DockPanel.Dock="Top" TextAlignment="Center" Text="{Binding Municipio,  Source={StaticResource ControlesDataSource}}"/>
                                <ComboBox x:Name="cbxMunicipio" Width="120" />
                            </DockPanel>
                            <DockPanel VerticalAlignment="Center">
                                <TextBlock DockPanel.Dock="Top" TextAlignment="Center" Text="{Binding Entidad,  Source={StaticResource ControlesDataSource}}"/>
                                <ComboBox x:Name="cbxEntidad" Width="120" />
                            </DockPanel>
                            <Ruv_WPF_Captura_Controles:Geografia ComboPais="{Binding ElementName=cbxPais}" ComboDepartamento="{Binding ElementName=cbxDepartamento}" ComboMunicipio="{Binding ElementName=cbxMunicipio}" ComboEntidadMunicipio="{Binding ElementName=cbxEntidad}" TodosLosPaises="False" PaisId="{Binding Path=NPaisId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DepartamentoId="{Binding Path=NDepartamentoId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MunicipioId="{Binding Path=NMunicipioId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EntidadMunicipioId="{Binding Path=NEntidadMunicipioId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </GroupBox>
                    <StackPanel Grid.Column="1" Orientation="Vertical" d:LayoutOverrides="Height" VerticalAlignment="Center">
                        <Button x:Name="btnSeparar" Content="{Binding SepararImprenta, Mode=OneWay, Source={StaticResource ControlesDataSource}}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="btnSeparar_Click"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnGenerarPdf" Content="{Binding GenerarPdf, Mode=OneWay,  Source={StaticResource ControlesDataSource}}" Margin="0,0,20,10" VerticalAlignment="Center" Click="btnGenerarPdf_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=BMostrarBtnPDF}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=BMostrarBtnPDF}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="btnGuardar" Content="{Binding Distribuir,  Source={StaticResource ControlesDataSource}}" Width="110" Margin="00,0,20,10" Click="btnGuardar_Click" IsEnabled="{Binding Path=BActivo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>                
        </Grid>
        <Popup x:Name="pGeografia" PlacementTarget="{Binding ElementName=LayoutRoot, Mode=OneWay}" AllowsTransparency="True" Placement="Center">
            <Grid Background="#4C000000" Width="{Binding ActualWidth, ElementName=LayoutRoot}" Height="{Binding ActualHeight, ElementName=LayoutRoot}">
                <Border BorderBrush="White" BorderThickness="5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Background="White">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="0.21*"/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="{Binding UbicacionGeografica, Mode=OneWay}" Padding="{DynamicResource Thickness-10}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <DockPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock DockPanel.Dock="Top" TextAlignment="Center" Text="{Binding Pais, Source={StaticResource ControlesDataSource}}"/>
                                    <ComboBox x:Name="cbxPaisFiltro" Width="120" />
                                </DockPanel>
                                <DockPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock DockPanel.Dock="Top" TextAlignment="Center" Text="{Binding Departamento,  Source={StaticResource ControlesDataSource}}"/>
                                    <ComboBox x:Name="cbxDepartamentoFiltro" Width="120" />
                                </DockPanel>
                                <DockPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock DockPanel.Dock="Top" TextAlignment="Center" Text="{Binding Municipio,  Source={StaticResource ControlesDataSource}}"/>
                                    <ComboBox x:Name="cbxMunicipioFiltro" Width="120" />
                                </DockPanel>
                                <DockPanel VerticalAlignment="Center">
                                    <TextBlock DockPanel.Dock="Top" TextAlignment="Center" Text="{Binding Entidad,  Source={StaticResource ControlesDataSource}}"/>
                                    <ComboBox x:Name="cbxEntidadFiltro" Width="120" />
                                </DockPanel>
                                <Ruv_WPF_Captura_Controles:Geografia ComboPais="{Binding ElementName=cbxPaisFiltro}" ComboDepartamento="{Binding ElementName=cbxDepartamentoFiltro}" ComboMunicipio="{Binding ElementName=cbxMunicipioFiltro}" ComboEntidadMunicipio="{Binding ElementName=cbxEntidadFiltro}" TodosLosPaises="False"
                                        PaisId="{Binding Path=NPaisIdFiltro, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" DepartamentoId="{Binding Path=NDepartamentoIdFiltro, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                        MunicipioId="{Binding Path=NMunicipioIdFiltro, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" EntidadMunicipioId="{Binding Path=NEntidadMunicipioIdFiltro, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                            </StackPanel>
                        </GroupBox>
                        <Button x:Name="btnDistribuirFiltroGeo" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" Content="{Binding Path=Distribuir, Mode=OneWay, Source={StaticResource ControlesDataSource}}" Click="btnDistribuirFiltroGeo_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=BSePuedeDistribuirFiltro}" Value="True">
                                            <Setter Property="Button.IsEnabled" Value="True" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=BSePuedeDistribuirFiltro}" Value="False">
                                            <Setter Property="Button.IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</Page>