<UserControl x:Class="Ruv.WPF.Captura.Impresion.ColillaRecibo_Bloque00"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sec="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
             xmlns:rec="clr-namespace:Ruv.WPF.Captura.Recursos"
             xmlns:congen="clr-namespace:Ruv.WPF.Captura.Controles"
             xmlns:conv="clr-namespace:Ruv.WPF.Captura.Converters"
             mc:Ignorable="d"
             d:DesignHeight="665"
             d:DesignWidth="840">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Registro/Secciones/RegistroDiccionario.xaml" />
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Recursos/EstilosImpresion.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:ConsultaDatoConverter x:Key="CDC" />
      <conv:DeclaranteImpresionConverter x:Key="DIC" />
      <rec:Controles x:Key="ControlesDataSource" d:IsDataSource="True"/>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>
    <StackPanel Orientation="Horizontal"
                Margin="5">
      <StackPanel.Resources>
        <Style TargetType="TextBlock">
          <Setter Property="FontSize"
                  Value="{StaticResource TamañoTextoNormal}" />
        </Style>
      </StackPanel.Resources>
      <TextBlock Margin="0,5"
            TextWrapping="Wrap">Certifico que recibí declaración bajo el código de formato No. <Run Text="{Binding Source={StaticResource RUV}, Path=Configuraciones.Impresion.DeclaracionEnImpresion.DeclaracionNumero}" /></TextBlock>
        </StackPanel>
    <TextBlock Margin="0,5"
               Style="{StaticResource styTituloSeccion}"
               Text="{Binding ConstanciaSolicitudInscripcion, Source={StaticResource ControlesDataSource}}" />
  </StackPanel>
</UserControl>
