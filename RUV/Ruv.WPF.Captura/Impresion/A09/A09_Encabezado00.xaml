<UserControl x:Class="Ruv.WPF.Captura.Impresion.A09_Encabezado00"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:rec="clr-namespace:Ruv.WPF.Captura.Recursos"
             xmlns:congen="clr-namespace:Ruv.WPF.Captura.Controles"
             xmlns:sec="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
             mc:Ignorable="d"
             d:DesignHeight="535"
             d:DesignWidth="1159">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Registro/Secciones/RegistroDiccionario.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>
      <congen:TextoRecurso Recurso="{x:Static rec:Textos.a06t001}"
                           Style="{StaticResource styTextoDescripcion}" />
      <Border Grid.Column="1"
              BorderThickness="1"
              BorderBrush="Black"
              VerticalAlignment="Center"
              HorizontalAlignment="Center">
        <TextBlock Text="{Binding Numero, StringFormat='{}ANEXO {0}'}"
                   VerticalAlignment="Center"
                   Margin="5,2" />
      </Border>
    </Grid>
      </StackPanel>
</UserControl>
