<UserControl x:Class="Ruv.WPF.Captura.Impresion.H01_Pregunta09"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sec="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
             xmlns:rec="clr-namespace:Ruv.WPF.Captura.Recursos"
             xmlns:congen="clr-namespace:Ruv.WPF.Captura.Controles"
             xmlns:conv="clr-namespace:Ruv.WPF.Captura.Converters"
             xmlns:my="clr-namespace:Ruv.WPF.Captura.Impresion"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="747">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Ruv.WPF.Captura;component/Registro/Secciones/RegistroDiccionario.xaml" />
                <ResourceDictionary Source="/Ruv.WPF.Captura;component/Recursos/EstilosImpresion.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:VictimaConsultaConverter x:Key="VCC" />
            <conv:ConsultaDatoConverter x:Key="CDC" />
            <conv:ConsultaDatoImpresionConverter x:Key="CDCI" />
            <conv:CantidadTiempoConverter x:Key="CTC" />
            <conv:ParametroNumeroConverter x:Key="PNC" />
            <conv:GeoEntornoConverter x:Key="GEC" />
            <conv:VersionFUDConverter x:Key="VersionFUDConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <!--=================================================-->
        <sec:SubTituloEntrada Numero="9"
                          Texto="Datos alternos de Contacto del (de la) Declarante" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource styBordeCajaEntrada1}"
              Grid.ColumnSpan="5">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top">*Dirección de residencia o correspondencia</TextBlock>
                    <my:DatoColumna Texto="{Binding DatoAlternoContactoDireccion}"
                          BordeVisible="False" />
                </DockPanel>
            </Border>

            <!--<congen:Geografia x:Name="geo03"
                        Grid.Row="1"
                        Grid.ColumnSpan="5"
                        ComboDepartamento="{Binding ElementName=cbDeptoDeclaranteAlterno}"
                        ComboMunicipio="{Binding ElementName=cbMcpioDeclaranteAlterno}"
                        DepartamentoId="{Binding DatoAlternoContactoDepartamento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                        MunicipioId="{Binding DatoAlternoContactoMunicipio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />-->
            <Border Style="{StaticResource styBordeCajaEntrada1}"
              Grid.Row="1"
              VerticalAlignment="Stretch">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Top">País</TextBlock>
                    <my:DatoColumna Texto="{Binding DatoAlternoContactoPais, Converter={StaticResource CDC}, ConverterParameter=Pais }"
                          BordeVisible="False" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource styBordeCajaEntrada1}"
              Grid.Row="1"
                    Grid.Column="1"
              VerticalAlignment="Stretch">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Top">Departamento</TextBlock>
                    <my:DatoColumna Texto="{Binding DatoAlternoContactoDepartamento, Converter={StaticResource CDC}, ConverterParameter=Departamento }"
                          BordeVisible="False" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource styBordeCajaEntrada2}"
              Grid.Column="2"
              Grid.Row="1"
              VerticalAlignment="Stretch">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Top">Municipio</TextBlock>
                    <my:DatoColumna Texto="{Binding DatoAlternoContactoMunicipio, Converter={StaticResource CDC}, ConverterParameter=Municipio }"
                          BordeVisible="False" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource styBordeCajaEntrada2}"
              Grid.Column="3"
              Grid.Row="1"
              Grid.ColumnSpan="3"
              VerticalAlignment="Stretch">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Top"
                     Text="{Binding DatoAlternoContactoTipoEntorno, Converter={StaticResource CDC}, ConverterParameter=TIPOENTORNOPOBLACIONES}" />
                    <my:DatoColumna BordeVisible="False">
                        <my:DatoColumna.Texto>
                            <MultiBinding Converter="{StaticResource GEC}"
                            ConverterParameter="ENTORNOCOMPLETO">
                                <Binding Path="DatoAlternoContactoTipoEntorno" />
                                <Binding Path="DatoAlternoContactoBarrioVeredaId" />
                                <Binding Path="DatoAlternoContactoLocalidadCorregimientoId" />
                                <Binding Path="DatoAlternoContactoBarrioVeredaNombre" />
                                <Binding Path="DatoAlternoContactoLocalidadCorregimientoNombre" />
                            </MultiBinding>
                        </my:DatoColumna.Texto>
                    </my:DatoColumna>
                </DockPanel>
            </Border>

            <sec:SubTituloEntrada Numero=""
                            Texto="Número telefónico al cual se enviarán avisos de notificación e información sobre oferta institucional (Este servicio será siempre gratuito)"
                            Grid.Row="2"
                            Grid.ColumnSpan="2" />
            <sec:SubTituloEntrada Numero=""
                            Texto="Correo electrónico"
                            Grid.Row="2"
                            Grid.Column="2"
                            Grid.ColumnSpan="3" />
            <Border Style="{StaticResource styBordeCajaEntrada1}"
              Grid.Row="3">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top">Fijo</TextBlock>
                    <my:DatoColumna 
                          BordeVisible="False" >
                        <my:DatoColumna.Texto>
                            <MultiBinding Converter="{StaticResource CDCI}" ConverterParameter="INDICATIVO_FIJO" >
                                <Binding Path="DatoAlternoContactoPais" />
                                <Binding Path="DatoContactoAlternoIndicativo" />
                                <Binding Path="DatoAlternoContactoTelefonoFijo" />
                            </MultiBinding>
                        </my:DatoColumna.Texto>
                    </my:DatoColumna>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource styBordeCajaEntrada1}"
              Grid.Row="3"
              Grid.Column="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top">Celular</TextBlock>
                    <my:DatoColumna
                          BordeVisible="False" >
                        <my:DatoColumna.Texto>
                            <MultiBinding Converter="{StaticResource CDCI}" ConverterParameter="INDICATIVO_CELULAR" >
                                <Binding Path="DatoAlternoContactoPais" />
                                <Binding Path="DatoAlternoContactoTelefonoCelular" />
                            </MultiBinding>
                        </my:DatoColumna.Texto>
                    </my:DatoColumna>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource styBordeCajaEntrada1}"
              Grid.Row="3"
              Grid.Column="2"
              Grid.ColumnSpan="3">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"></TextBlock>
                    <my:DatoColumna Texto="{Binding DatoAlternoContactoCorreoElectronico}"
                          BordeVisible="False" />
                </DockPanel>
            </Border>
        </Grid>
        <congen:TextoRecurso Recurso="{x:Static rec:Textos.h01t006}" Visibility="{Binding Source={StaticResource RUV}, Path=I.DeclaracionActual.VersionFUD, Converter={StaticResource VersionFUDConverter}, ConverterParameter=VisibleEnVersion1}"
                         TextAlignment="Justify" TextWrapping="Wrap" />
        <congen:TextoRecurso  Recurso="{x:Static rec:Textos.h01t006V2}" Visibility="{Binding Source={StaticResource RUV}, Path=I.DeclaracionActual.VersionFUD, Converter={StaticResource VersionFUDConverter}, ConverterParameter=VisibleEnVersion2}"
                         TextAlignment="Justify" TextWrapping="Wrap" />
        <TextBlock TextAlignment="Center"
               Margin="0,10,0,0">Identifique a continuación los medios por los cuales la persona autoriza ser contactada:</TextBlock>
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock DockPanel.Dock="Top">Mensajes de texto a través del celular</TextBlock>
            <TextBlock Grid.Column="2">Mensajes de voz a través del teléfono fijo</TextBlock>
            <TextBlock Grid.Row="1">Mensajes a través del correo electrónico</TextBlock>
            <DockPanel Grid.Column="2"
                 Grid.Row="1"
                 Grid.ColumnSpan="2">
                <TextBlock DockPanel.Dock="Left">Otro medio ¿Cuál?</TextBlock>
                <my:DatoColumna Texto="{Binding MedioDeContactoOtro}"
                        BordeVisible="False" />
            </DockPanel>
            <my:DatoSiNoColumna Valor="{Binding MedioDeContactoMensajeTexto}"
                          Grid.Column="1"
                          HorizontalAlignment="Left" />
            <my:DatoSiNoColumna Valor="{Binding MedioDeContactoCorreoElectronico}"
                          Grid.Column="1"
                          Grid.Row="1"
                          HorizontalAlignment="Left" />
            <my:DatoSiNoColumna Valor="{Binding MedioDeContactoMensajeVoz}"
                          Grid.Column="3"
                          HorizontalAlignment="Left" />
        </Grid>
    </StackPanel>
</UserControl>
