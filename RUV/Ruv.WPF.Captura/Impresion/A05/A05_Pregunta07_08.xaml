<UserControl x:Class="Ruv.WPF.Captura.Impresion.A05_Pregunta07_08"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:rec="clr-namespace:Ruv.WPF.Captura.Recursos"
             xmlns:congen="clr-namespace:Ruv.WPF.Captura.Controles"
             xmlns:my="clr-namespace:Ruv.WPF.Captura.Impresion"
             xmlns:sec="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
             xmlns:conv="clr-namespace:Ruv.WPF.Captura.Converters"
             mc:Ignorable="d"
             d:DesignHeight="535"
             d:DesignWidth="822">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Registro/Secciones/RegistroDiccionario.xaml" />
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Recursos/EstilosImpresion.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:VictimaConsultaConverter x:Key="VCC" />
      <conv:ConsultaDatoConverter x:Key="CDC" />
      <conv:CantidadTiempoConverter x:Key="CTC" />
      <conv:Victima05JefeHogarConverter x:Key="V05FHC" />
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>

    <DockPanel>

      <Grid DockPanel.Dock="Left">
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <sec:SubTituloEntrada Numero="7"
                              Texto="¿El deseo del hogar es?" />
        <my:DatoColumna Texto="{Binding DeseoDelHogar, Converter={StaticResource CDC}, ConverterParameter=PARAMETRO}"
                        Grid.Row="1" />
      </Grid>

      <sec:FechaLugar_Imp FechaYLugar="{Binding DeseaUbicarseEn}"
                          CajaFechaEsVisible="False"
                          CajaPaisEsVisible="False"
                          Numero="8"
                          TextoTitulo="Si respondió 'Reubicarse', ¿en qué lugar desearía reubicarse?"
                          Margin="5,0,0,0" />
    </DockPanel>
    <sec:SubTituloEntrada Numero=""
                          Margin="0,5"
                          AlineacionTexto="Center"
                          Texto="HOGAR AFECTADO" />
    <sec:SubTituloEntrada Numero="9"
                          Texto="Relacione en este cuadro las personas que conforman el hogar afectado por el desplazamiento" />
    <Grid Margin="5"
          HorizontalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <TextBlock TextAlignment="Center"
                 Grid.RowSpan="2">
        <TextBlock.LayoutTransform>
          <RotateTransform Angle="270" />
        </TextBlock.LayoutTransform>
        Jefe de<LineBreak />Hogar</TextBlock>
      <my:EncabezadoColumna Texto="No. Consecutivo\n(Hoja 2-Item 11)"
                            Grid.Row="0"
                            Grid.Column="1" />
      <my:EncabezadoColumna Texto="¿Se\ndesplazó?"
                            Grid.Row="0"
                            Grid.Column="2" />
      <my:DatoColumna Texto="{Binding Converter={StaticResource V05FHC}, ConverterParameter=NUMEROCONSECUTIVO}"
                      Grid.Row="1"
                      Grid.Column="1"
                      AlineacionTexto="Center" />
      <my:DatoSiNoColumna Valor="{Binding Converter={StaticResource V05FHC}, ConverterParameter=SEDESPLAZO}"
                          Grid.Row="1"
                          Grid.Column="2" />
    </Grid>
  </StackPanel>
</UserControl>
