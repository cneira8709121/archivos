<UserControl x:Class="Ruv.WPF.Captura.Impresion.A05_Pregunta10_12"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:rec="clr-namespace:Ruv.WPF.Captura.Recursos"
             xmlns:congen="clr-namespace:Ruv.WPF.Captura.Controles"
             xmlns:my="clr-namespace:Ruv.WPF.Captura.Impresion"
             xmlns:sec="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
             xmlns:conv="clr-namespace:Ruv.WPF.Captura.Converters"
             mc:Ignorable="d"
             d:DesignHeight="535"
             d:DesignWidth="822">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Ruv.WPF.Captura;component/Registro/Secciones/RegistroDiccionario.xaml" />
                <ResourceDictionary Source="/Ruv.WPF.Captura;component/Recursos/EstilosImpresion.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:VictimaConsultaConverter x:Key="VCC" />
            <conv:ConsultaDatoConverter x:Key="CDC" />
            <conv:CantidadTiempoConverter x:Key="CTC" />
            <conv:Victima05JefeHogarConverter x:Key="V05FHC" />
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <congen:TextoRecurso Recurso="{x:Static rec:Textos.a05t002}"
                         Margin="0,0,0,5"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Stretch" />
        <Grid VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="9*" />

                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="9*" />

                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="9*" />
                <ColumnDefinition Width="2*" />

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="cTitulo" />
                <RowDefinition x:Name="cSubTitulo" />
                <RowDefinition x:Name="cDetalle" />
            </Grid.RowDefinitions>
            <!--LOS BORDES-->
            <Border Grid.Column="0"
              Grid.Row="2" />
            <Border Grid.Column="1"
              Grid.Row="2" />
            <Border Grid.Column="2"
              Grid.Row="2" />
            <Border Grid.Column="3"
              Grid.Row="2" />
            <Border Grid.Column="4"
              Grid.Row="2" />
            <Border Grid.Column="5"
              Grid.Row="2" />
            <Border Grid.Column="6"
              Grid.Row="2" />
            <!--PREGUNTA CÉDULA-->
            <sec:SubTituloEntrada x:Name="seCedula"
                            Grid.ColumnSpan="2"
                            Numero="10"
                            Texto="¿Tenía inscrita su cédula para votar? (solo aplica para mayores de edad)" />
            <sec:SubTituloEntrada Numero=""
                            AlineacionTexto="Center"
                            AlineacionVerticalTexto="Center"
                            Grid.Column="1"
                            Grid.Row="1"
                            Texto="LUGAR" />
            <my:EncabezadoColumna Texto="Si No\nNs/Nr"
                            Grid.Column="0"
                            Grid.Row="1"
                            OrientacionTexto="Horizontal" />
            <my:DatoSiNoColumna Valor="{Binding InformacionJefeGrupo.TieneInscritaCedulaParaVotar}"
                          Grid.Column="0"
                          Grid.Row="2" />
            <StackPanel Grid.Row="2"
                  Grid.Column="1">
                <my:DatoColumna Texto="{Binding InformacionJefeGrupo.InscripcionDepartamento, Converter={StaticResource CDC}, ConverterParameter=Departamento }"
                        BordeVisible="False" />
                <my:DatoColumna Texto="{Binding InformacionJefeGrupo.InscripcionMunicipio, Converter={StaticResource CDC}, ConverterParameter=Municipio }"
                        BordeVisible="False" />
            </StackPanel>

            <!--PREGUNTA ESTUDIO HIJOS-->
            <sec:SubTituloEntrada x:Name="seEstudio"
                            Grid.Column="2"
                            Grid.ColumnSpan="2"
                            Numero="11"
                            Texto="¿Dónde estudiaban sus hijos? (Si aplica)" />
            <sec:SubTituloEntrada Numero=""
                            AlineacionTexto="Center"
                            AlineacionVerticalTexto="Center"
                            Grid.Column="2"
                            Grid.Row="1"
                            Texto="LUGAR" />
            <sec:SubTituloEntrada Numero=""
                            AlineacionTexto="Center"
                            AlineacionVerticalTexto="Center"
                            Grid.Column="3"
                            Grid.Row="1"
                            Texto="INSTITUCION EDUCATIVA" />
            <StackPanel Grid.Column="2"
                  Grid.Row="2">
                <my:DatoColumna Texto="{Binding InformacionJefeGrupo.HijosEstudianDepartamento, Converter={StaticResource CDC}, ConverterParameter=Departamento }"
                        BordeVisible="False" />
                <my:DatoColumna Texto="{Binding InformacionJefeGrupo.HijosEstudianMunicipio, Converter={StaticResource CDC}, ConverterParameter=Municipio }"
                        BordeVisible="False" />
            </StackPanel>
            <my:DatoColumna Texto="{Binding InformacionJefeGrupo.HijosEstudianInstitucion}"
                      BordeVisible="False"
                      Grid.Column="3"
                      Grid.Row="2" />
            <!--PREGUNTA SISBEN-->
            <sec:SubTituloEntrada x:Name="seSisben"
                            Grid.Column="4"
                            Grid.ColumnSpan="3"
                            Numero="12"
                            Texto="¿Le aplicaron la encuesta del Sisben?" />
            <my:EncabezadoColumna Texto="Si No\nNs/Nr"
                            Grid.Column="4"
                            Grid.Row="1"
                            OrientacionTexto="Horizontal" />
            <sec:SubTituloEntrada Numero=""
                            AlineacionTexto="Center"
                            AlineacionVerticalTexto="Center"
                            Grid.Column="5"
                            Grid.Row="1"
                            Texto="LUGAR" />
            <my:EncabezadoColumna Texto="Nivel\n(si lo conoce)"
                            Grid.Column="6"
                            Grid.Row="1"
                            OrientacionTexto="Vertical" />
            <my:DatoSiNoColumna Valor="{Binding InformacionJefeGrupo.EncuestaSisben}"
                          Grid.Column="4"
                          Grid.Row="2" />
            <StackPanel Grid.Column="5"
                  Grid.Row="2">
                <my:DatoColumna Texto="{Binding InformacionJefeGrupo.EncuestaSisbenDepartamento, Converter={StaticResource CDC}, ConverterParameter=Departamento }"
                        BordeVisible="False" />
                <my:DatoColumna Texto="{Binding InformacionJefeGrupo.EncuestaSisbenMunicipio, Converter={StaticResource CDC}, ConverterParameter=Municipio }"
                        BordeVisible="False" />
            </StackPanel>
            <my:DatoColumna Texto="{Binding InformacionJefeGrupo.EncuestaSisbenNivel}"
                      BordeVisible="False"
                      Grid.Column="6"
                      Grid.Row="2" />

        </Grid>

    </StackPanel>
</UserControl>
