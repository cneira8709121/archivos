<UserControl 
             x:Class="Ruv.WPF.Captura.Impresion.A13_Pregunta15_16"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sec="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
             xmlns:rec="clr-namespace:Ruv.WPF.Captura.Recursos"
             xmlns:congen="clr-namespace:Ruv.WPF.Captura.Controles"
             xmlns:conv="clr-namespace:Ruv.WPF.Captura.Converters"
             xmlns:my="clr-namespace:Ruv.WPF.Captura.Impresion"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="1279">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Ruv.WPF.Captura;component/Registro/Secciones/RegistroDiccionario.xaml" />
                <ResourceDictionary Source="/Ruv.WPF.Captura;component/Recursos/EstilosImpresion.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:VictimaConsultaConverter x:Key="VCC" />
            <conv:ConsultaDatoConverter x:Key="CDC" />
            <conv:CantidadTiempoConverter x:Key="CTC" />
            <conv:ParametroNumeroConverter x:Key="PNC" />
            <conv:GeoEntornoConverter x:Key="GEC" />
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <sec:SubTituloEntrada 
                Grid.Column="0"
                Grid.Row="0"
                Numero="15"
                Texto="Datos de Contacto" />

            <Grid Grid.Column="0" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource styBordeCajaEntrada1}"
              Grid.ColumnSpan="5">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top">*Dirección de residencia o correspondencia</TextBlock>
                        <my:DatoColumna Texto="{Binding DatoContactoDireccion}"
                          BordeVisible="False" />
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource styBordeCajaEntrada1}"
              Grid.Row="1"
              VerticalAlignment="Stretch">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Top">País</TextBlock>
                        <my:DatoColumna Texto="{Binding DatoContactoPais, Converter={StaticResource CDC}, ConverterParameter=Pais }"
                          BordeVisible="False" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource styBordeCajaEntrada1}"
              Grid.Row="1"
                    Grid.Column="1"
              VerticalAlignment="Stretch">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Top">Departamento</TextBlock>
                        <my:DatoColumna Texto="{Binding DatoContactoDepartamento, Converter={StaticResource CDC}, ConverterParameter=Departamento }"
                          BordeVisible="False" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource styBordeCajaEntrada2}"
              Grid.Column="2"
              Grid.Row="1"
              VerticalAlignment="Stretch">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Top">Municipio</TextBlock>
                        <my:DatoColumna Texto="{Binding DatoContactoMunicipio, Converter={StaticResource CDC}, ConverterParameter=Municipio }"
                          BordeVisible="False" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource styBordeCajaEntrada2}"
              Grid.Column="3"
              Grid.Row="1"
              Grid.ColumnSpan="3"
              VerticalAlignment="Stretch">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Top"
                     Text="{Binding DatoAlternoContactoTipoEntorno, Converter={StaticResource CDC}, ConverterParameter=TIPOENTORNOPOBLACIONES}" />
                        <my:DatoColumna BordeVisible="False">
                            <my:DatoColumna.Texto>
                                <MultiBinding Converter="{StaticResource GEC}"
                            ConverterParameter="ENTORNOCOMPLETO">
                                    <Binding Path="DatoContactoTipoEntorno" />
                                    <Binding Path="DatoContactoBarrioVeredaId" />
                                    <Binding Path="DatoContactoLocalidadCorregimientoId" />
                                    <Binding Path="DatoContactoBarrioVeredaNombre" />
                                    <Binding Path="DatoContactoLocalidadCorregimientoNombre" />
                                </MultiBinding>
                            </my:DatoColumna.Texto>
                        </my:DatoColumna>
                    </DockPanel>
                </Border>

                <sec:SubTituloEntrada Numero=""
                            Texto="Número telefónico al cual se enviarán avisos de notificación e información sobre oferta institucional (Este servicio será siempre gratuito)"
                            Grid.Row="2"
                            Grid.ColumnSpan="2" />
                <sec:SubTituloEntrada Numero=""
                            Texto="Correo electrónico"
                            Grid.Row="2"
                            Grid.Column="2"
                            Grid.ColumnSpan="3" />
                <Border Style="{StaticResource styBordeCajaEntrada1}"
              Grid.Row="3">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top">Fijo</TextBlock>
                        <my:DatoColumna Texto="{Binding DatoContactoTelefonoFijo}"
                          BordeVisible="False" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource styBordeCajaEntrada1}"
              Grid.Row="3"
              Grid.Column="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top">Celular</TextBlock>
                        <my:DatoColumna Texto="{Binding DatContactoTelefonoCelular}"
                          BordeVisible="False" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource styBordeCajaEntrada1}"
              Grid.Row="3"
              Grid.Column="2"
              Grid.ColumnSpan="3">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"></TextBlock>
                        <my:DatoColumna Texto="{Binding DatoContactoCorreoElectronico}"
                          BordeVisible="False" />
                    </DockPanel>
                </Border>
            </Grid>

            <sec:SubTituloEntrada Grid.Column="1" Grid.Row="0"
                Numero="16"
                Texto="Datos alternos de Contacto" />

            <Grid Grid.Column="1" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource styBordeCajaEntrada1}"
              Grid.ColumnSpan="5">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top">*Dirección de residencia o correspondencia</TextBlock>
                        <my:DatoColumna Texto="{Binding DatoAlternoContactoDireccion}"
                          BordeVisible="False" />
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource styBordeCajaEntrada1}"
              Grid.Row="1"
              VerticalAlignment="Stretch">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Top">País</TextBlock>
                        <my:DatoColumna Texto="{Binding DatoAlternoContactoPais, Converter={StaticResource CDC}, ConverterParameter=Pais }"
                          BordeVisible="False" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource styBordeCajaEntrada1}"
              Grid.Row="1"
                    Grid.Column="1"
              VerticalAlignment="Stretch">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Top">Departamento</TextBlock>
                        <my:DatoColumna Texto="{Binding DatoAlternoContactoDepartamento, Converter={StaticResource CDC}, ConverterParameter=Departamento }"
                          BordeVisible="False" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource styBordeCajaEntrada2}"
              Grid.Column="2"
              Grid.Row="1"
              VerticalAlignment="Stretch">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Top">Municipio</TextBlock>
                        <my:DatoColumna Texto="{Binding DatoAlternoContactoMunicipio, Converter={StaticResource CDC}, ConverterParameter=Municipio }"
                          BordeVisible="False" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource styBordeCajaEntrada2}"
              Grid.Column="3"
              Grid.Row="1"
              Grid.ColumnSpan="3"
              VerticalAlignment="Stretch">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Top"
                     Text="{Binding DatoAlternoContactoTipoEntorno, Converter={StaticResource CDC}, ConverterParameter=TIPOENTORNOPOBLACIONES}" />
                        <my:DatoColumna BordeVisible="False">
                            <my:DatoColumna.Texto>
                                <MultiBinding Converter="{StaticResource GEC}"
                            ConverterParameter="ENTORNOCOMPLETO">
                                    <Binding Path="DatoAlternoContactoTipoEntorno" />
                                    <Binding Path="DatoAlternoContactoBarrioVeredaId" />
                                    <Binding Path="DatoAlternoContactoLocalidadCorregimientoId" />
                                    <Binding Path="DatoAlternoContactoBarrioVeredaNombre" />
                                    <Binding Path="DatoAlternoContactoLocalidadCorregimientoNombre" />
                                </MultiBinding>
                            </my:DatoColumna.Texto>
                        </my:DatoColumna>
                    </DockPanel>
                </Border>

                <sec:SubTituloEntrada Numero=""
                            Texto="Número telefónico al cual se enviarán avisos de notificación e información sobre oferta institucional (Este servicio será siempre gratuito)"
                            Grid.Row="2"
                            Grid.ColumnSpan="2" />
                <sec:SubTituloEntrada Numero=""
                            Texto="Correo electrónico"
                            Grid.Row="2"
                            Grid.Column="2"
                            Grid.ColumnSpan="3" />
                <Border Style="{StaticResource styBordeCajaEntrada1}"
              Grid.Row="3">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top">Fijo</TextBlock>
                        <my:DatoColumna Texto="{Binding DatoAlternoContactoTelefonoFijo}"
                          BordeVisible="False" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource styBordeCajaEntrada1}"
              Grid.Row="3"
              Grid.Column="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top">Celular</TextBlock>
                        <my:DatoColumna Texto="{Binding DatoAlternoContactoTelefonoCelular}"
                          BordeVisible="False" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource styBordeCajaEntrada1}"
              Grid.Row="3"
              Grid.Column="2"
              Grid.ColumnSpan="3">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"></TextBlock>
                        <my:DatoColumna Texto="{Binding DatoAlternoContactoCorreoElectronico}"
                          BordeVisible="False" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
        <!--=================================================-->
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <congen:TextoRecurso Grid.Column="1" Grid.RowSpan="2"
                Recurso="{x:Static rec:Textos.h01t006}"
                TextAlignment="Center" 
                VerticalAlignment="Center"
                TextWrapping="Wrap"/>
            <TextBlock Grid.Column="2"
                TextAlignment="Center"
               Margin="0,10,0,0">Identifique a continuación los medios por los cuales la persona autoriza ser contactada:</TextBlock>
            <Grid Margin="10" Grid.Column="2" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="7*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock DockPanel.Dock="Top">Mensajes de texto a través del celular</TextBlock>
                <TextBlock Grid.Column="2">Mensajes de voz a través del teléfono fijo</TextBlock>
                <TextBlock Grid.Row="1">Mensajes a través del correo electrónico</TextBlock>
                <DockPanel Grid.Column="2"
                 Grid.Row="1"
                 Grid.ColumnSpan="2">
                    <TextBlock DockPanel.Dock="Left">Otro medio ¿Cuál?</TextBlock>
                    <my:DatoColumna Texto="{Binding MedioDeContactoOtro}"
                        BordeVisible="False" />
                </DockPanel>
                <my:DatoSiNoColumna Valor="{Binding MedioDeContactoMensajeTexto}"
                          Grid.Column="1"
                          HorizontalAlignment="Left" />
                <my:DatoSiNoColumna Valor="{Binding MedioDeContactoCorreoElectronico}"
                          Grid.Column="1"
                          Grid.Row="1"
                          HorizontalAlignment="Left" />
                <my:DatoSiNoColumna Valor="{Binding MedioDeContactoMensajeVoz}"
                          Grid.Column="3"
                          HorizontalAlignment="Left" />
            </Grid>
        </Grid>
        
            
        
    </StackPanel>
</UserControl>
