<UserControl x:Class="Ruv.WPF.Captura.Registro.Secciones.FechaLugar_Imp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sec="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:controles="clr-namespace:Ruv.WPF.Captura.Controles"
             xmlns:conv="clr-namespace:Ruv.WPF.Captura.Converters"
             mc:Ignorable="d"
             d:DesignHeight="82"
             d:DesignWidth="1000">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Registro/Secciones/RegistroDiccionario.xaml" />
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Recursos/EstilosImpresion.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:GeoEntornoConverter x:Key="GEC" />
      <conv:ConsultaDatoConverter x:Key="CDC" />
      <Style TargetType="RadioButton"
             BasedOn="{StaticResource styRadioButtonX}" />
      <Style TargetType="CheckBox"
             BasedOn="{StaticResource styCheckBoxX}" />
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>

    <sec:SubTituloEntrada x:Name="steTitulo"
                          Margin="0,0,0,5"
                          Numero="."
                          Texto="Relacione la fecha y lugar de los hechos" />
    <Grid x:Name="grdMain">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="1*" />
    </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <sec:SubTituloEntrada Numero=""
                            AlineacionTexto="Center"
                            Grid.Column="1"
                            Grid.ColumnSpan="3"
                            Texto="LUGAR" />
            <sec:SubTituloEntrada x:Name="stePais" 
                        Numero=""
                        AlineacionTexto="Center"
                        Grid.Column="1"
                        Grid.Row="1"
                        Texto="PAÍS" />
        <sec:SubTituloEntrada Numero=""
                        AlineacionTexto="Center"
                        Grid.Column="2"
                        Grid.Row="1"
                        Texto="DEPARTAMENTO" />
      <sec:SubTituloEntrada Numero=""
                            AlineacionTexto="Center"
                            Grid.Column="3"
                            Grid.Row="1"
                            Texto="MUNICIPIO" />
      <sec:SubTituloEntrada x:Name="steTituloEntorno"
                            Numero=""
                            AlineacionTexto="Center"
                            Grid.Column="4"
                            Grid.ColumnSpan="2"
                            Grid.RowSpan="2"
                            AlineacionVerticalTexto="Center"
                            Texto="{Binding TipoEntorno, Converter={StaticResource CDC}, ConverterParameter=TIPOENTORNOPOBLACIONES}" />
      <sec:SubTituloEntrada x:Name="steFecha"
                            Numero=""
                            AlineacionTexto="Center"
                            Grid.RowSpan="2"
                            Texto="Fecha" />
      <sec:CajaIngresoFecha x:Name="cifFecha"
                            Grid.Row="2"
                            Grid.RowSpan="3" />
    <Border Style="{StaticResource styBordeCajaEntrada1}"
        Grid.Row="2"
        Grid.Column="1"
        VerticalAlignment="Stretch">
        <TextBlock x:Name="txtPais" />
    </Border>
    <Border Style="{StaticResource styBordeCajaEntrada1}"
        Grid.Row="2"
        Grid.Column="2"
        VerticalAlignment="Stretch">
        <TextBlock x:Name="txtDepartamento" />
      </Border>
      <Border Style="{StaticResource styBordeCajaEntrada1}"
              Grid.Row="2"
              Grid.Column="3"
              VerticalAlignment="Stretch">
        <TextBlock x:Name="txtMunicipio" />
      </Border>
      <Border Style="{StaticResource styBordeCajaEntrada1}"
              Grid.Row="2"
              Grid.Column="4"
              Grid.ColumnSpan="2"
              VerticalAlignment="Stretch">
        <TextBlock x:Name="txtEntorno">
          <TextBlock.Text>
             <MultiBinding Converter="{StaticResource GEC}"
                           ConverterParameter="ENTORNOCOMPLETO">
                <Binding Path="TipoEntorno" />
                <Binding Path="BarrioVeredaId" />
                <Binding Path="LocalidadCorregimientoId" />
                <Binding Path="BarrioVeredaNombre" />
                <Binding Path="LocalidadCorregimientoNombre" />
              </MultiBinding>
          </TextBlock.Text>
        </TextBlock>

      </Border>
    </Grid>
  </StackPanel>
</UserControl>
