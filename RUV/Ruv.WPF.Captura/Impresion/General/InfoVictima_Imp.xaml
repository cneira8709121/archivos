<UserControl xmlns:my="clr-namespace:Ruv.WPF.Captura.Impresion"
             x:Class="Ruv.WPF.Captura.Registro.Secciones.InfoVictima_Imp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:congen="clr-namespace:Ruv.WPF.Captura.Controles"
             xmlns:sec="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
             Name="usrIfoVictima"
             d:DesignHeight="135"
             d:DesignWidth="1252">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Ruv.WPF.Captura;component/Registro/Secciones/RegistroDiccionario.xaml" />
                <ResourceDictionary Source="/Ruv.WPF.Captura;component/Recursos/EstilosImpresion.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="RadioButton"
             BasedOn="{StaticResource styRadioButtonX}" />
            <Style TargetType="CheckBox"
             BasedOn="{StaticResource styCheckBoxX}" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="9*" />

            <ColumnDefinition Width="7*" />
            <ColumnDefinition Width="9*" />

            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="9*" />
            <ColumnDefinition Width="2*" />

            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="9*" />
            <ColumnDefinition Width="9*" />

            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="9*" />
            <ColumnDefinition Width="7*" />

            <ColumnDefinition Width="7*" />
            <ColumnDefinition Width="9*" />

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Name="Titulos1_6" />
            <RowDefinition Name="SubTitulos1_6" />
            <RowDefinition Name="Valores1_6" />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <!--LOS BORDES-->
        <Border Grid.Column="0"
            Grid.Row="2" />
        <Border Grid.Column="1"
            Grid.Row="2" />
        <Border Grid.Column="2"
            Grid.Row="2" />
        <Border Grid.Column="3"
            Grid.Row="2" />
        <Border Grid.Column="4"
            Grid.Row="2" />
        <Border Grid.Column="5"
            Grid.Row="2" />
        <Border Grid.Column="6"
            Grid.Row="2" />
        <Border Grid.Column="7"
            Grid.Row="2" />
        <Border Grid.Column="8"
            Grid.Row="2" />
        <Border Grid.Column="9"
            Grid.Row="2" />
        <Border Grid.Column="10"
            Grid.Row="2" />
        <Border Grid.Column="11"
            Grid.Row="2" />
        <Border Grid.Column="12"
            Grid.Row="2" />
        <Border Grid.Column="0" Grid.ColumnSpan="6"
            Grid.Row="5" />
        <Border Grid.Column="6" Grid.ColumnSpan="7"
            Grid.Row="5" />
        <!--PREGUNTA CÉDULA-->
        <sec:SubTituloEntrada Tag="CedulaInscrita" x:Name="seCedula"
                          Grid.ColumnSpan="2"
                          Numero="."
                          Texto="¿Tenía inscrita su cédula para votar? (solo aplica para mayores de edad)" />
        <sec:SubTituloEntrada Tag="CedulaInscrita" Numero=""
                          AlineacionTexto="Center"
                          AlineacionVerticalTexto="Center"
                          Grid.Column="1"
                          Grid.Row="1"
                          Texto="LUGAR" />
        <my:EncabezadoColumna Tag="CedulaInscrita" Texto="Si No\nNs/Nr"
                          Grid.Column="0"
                          Grid.Row="1"
                          OrientacionTexto="Horizontal" />
        <TextBlock Tag="CedulaInscrita" x:Name="txtCedulaSiNo"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               Grid.Column="0"
               Grid.Row="2" />
        <StackPanel Tag="CedulaInscrita" Grid.Row="2"
                Grid.Column="1">
            <TextBlock x:Name="txtCedulaDepartamento" />
            <TextBlock x:Name="txtCedulaMunicipio" />
        </StackPanel>

        <!--PREGUNTA ESTUDIO HIJOS-->
        <sec:SubTituloEntrada x:Name="seEstudio"
                          Grid.Column="2"
                          Grid.ColumnSpan="2"
                          Numero="."
                          Texto="¿Dónde estudiaban sus hijos? (Si aplica)" />
        <sec:SubTituloEntrada Numero=""
                          AlineacionTexto="Center"
                          AlineacionVerticalTexto="Center"
                          Grid.Column="2"
                          Grid.Row="1"
                          Texto="LUGAR" />
        <sec:SubTituloEntrada Numero=""
                          AlineacionTexto="Center"
                          AlineacionVerticalTexto="Center"
                          Grid.Column="3"
                          Grid.Row="1"
                          Texto="INSTITUCION EDUCATIVA" />
        <StackPanel Grid.Column="2"
                Grid.Row="2">
            <TextBlock x:Name="txtEstudioDepartamento" />
            <TextBlock x:Name="txtEstudioMunicipio" />
        </StackPanel>
        <TextBlock x:Name="txtEstudioInstitucion"
               Grid.Column="3"
               Grid.Row="2" />
        <!--PREGUNTA SISBEN-->
        <sec:SubTituloEntrada x:Name="seSisben"
                          Grid.Column="4"
                          Grid.ColumnSpan="3"
                          Numero="."
                          Texto="¿Le aplicaron la encuesta del Sisben?" />
        <my:EncabezadoColumna Texto="Si No\nNs/Nr"
                          Grid.Column="4"
                          Grid.Row="1"
                          OrientacionTexto="Horizontal" />
        <sec:SubTituloEntrada Numero=""
                          AlineacionTexto="Center"
                          AlineacionVerticalTexto="Center"
                          Grid.Column="5"
                          Grid.Row="1"
                          Texto="LUGAR" />
        <my:EncabezadoColumna Texto="Nivel\n(si lo conoce)"
                          Grid.Column="6"
                          Grid.Row="1"
                          OrientacionTexto="Vertical" />
        <TextBlock x:Name="txtSisbenSiNo"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               Grid.Column="4"
               Grid.Row="2" />
        <StackPanel Grid.Column="5"
                Grid.Row="2">
            <TextBlock x:Name="txtSisbenDepartamento" />
            <TextBlock x:Name="txtSisbenMunicipio" />
        </StackPanel>
        <TextBlock x:Name="txtSisbenNivel"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               Grid.Column="6"
               Grid.Row="2" />
        <!--PREGUNTA INSCRITO EN FAMILIAS EN ACCION-->
        <sec:SubTituloEntrada x:Name="seInscrito"
                          Grid.Column="7"
                          Grid.ColumnSpan="3"
                          Numero="."
                          Texto="¿Estaba inscrito en el programa (Familias en Acción)?" />
        <my:EncabezadoColumna Texto="Si No\nNs/Nr"
                          Grid.Column="7"
                          Grid.Row="1"
                          OrientacionTexto="Horizontal" />
        <sec:SubTituloEntrada Numero=""
                          AlineacionTexto="Center"
                          AlineacionVerticalTexto="Center"
                          Grid.Column="8"
                          Grid.Row="1"
                          Texto="LUGAR" />
        <my:EncabezadoColumna Texto="Entidad en\nla cual cobra"
                          Grid.Column="9"
                          Grid.Row="1"
                          OrientacionTexto="Horizontal" />
        <TextBlock x:Name="txtInscritoSiNo"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               Grid.Column="7"
               Grid.Row="2" />
        <StackPanel Grid.Column="8"
                Grid.Row="2">
            <TextBlock x:Name="txtInscritoDepartamento" />
            <TextBlock x:Name="txtInscritoMunicipio" />
        </StackPanel>
        <TextBlock x:Name="txtInscritoEntidad"
               Grid.Column="9"
               Grid.Row="2" />
        <!--PREGUNTA SALUD-->
        <sec:SubTituloEntrada x:Name="seSalud"
                          Grid.Column="10"
                          Grid.ColumnSpan="3"
                          Numero="."
                          Texto="¿Se encontraba vinculado al sistema de salud?" />
        <my:EncabezadoColumna Texto="Si No\nNs/Nr"
                          Grid.Column="10"
                          Grid.Row="1"
                          OrientacionTexto="Horizontal" />
        <sec:SubTituloEntrada Numero=""
                          AlineacionTexto="Center"
                          AlineacionVerticalTexto="Center"
                          Grid.Column="11"
                          Grid.Row="1"
                          Texto="LUGAR" />
        <my:EncabezadoColumna Texto="Tipo de\nAfiliación"
                          Grid.Column="12"
                          Grid.Row="1"
                          OrientacionTexto="Horizontal" />
        <TextBlock x:Name="txtSaludSiNo"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               Grid.Column="10"
               Grid.Row="2" />
        <StackPanel Grid.Column="11"
                Grid.Row="2">
            <TextBlock x:Name="txtSaludDepartamento" />
            <TextBlock x:Name="txtSaludMunicipio" />
        </StackPanel>
        <TextBlock x:Name="txtSaludAfiliacion"
               Grid.Column="12"
               Grid.Row="2" />
        
        <!--PREGUNTA ESTUDIO HIJOS-->
        <sec:SubTituloEntrada x:Name="seActividades"
                          Grid.Column="0"
                          Grid.ColumnSpan="13"
                              Grid.Row="3"
                          Numero="."
                          Texto="Indique el lugar en el cual desempeñaba sus actividades laborales" />
        <sec:SubTituloEntrada Numero=""
                          AlineacionTexto="Center"
                          AlineacionVerticalTexto="Center"
                          Grid.Column="0" Grid.ColumnSpan="6"
                          Grid.Row="4"
                          Texto="LUGAR" />
        <my:EncabezadoColumna Texto="Nombre\nempleador"
                          Grid.Column="6" Grid.ColumnSpan="7"
                          Grid.Row="4"
                          OrientacionTexto="Horizontal" />
        <StackPanel Grid.Column="0" Grid.ColumnSpan="6"
                Grid.Row="5">
            <TextBlock x:Name="txtActividadesDepartamento" />
            <TextBlock x:Name="txtActividadesMunicipio" />
        </StackPanel>
        <TextBlock x:Name="txtActividadesEmpleador"
               Grid.Column="6" Grid.ColumnSpan="7"
               Grid.Row="5" />
    </Grid>
</UserControl>
