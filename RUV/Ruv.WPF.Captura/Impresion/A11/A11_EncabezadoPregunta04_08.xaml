<UserControl x:Class="Ruv.WPF.Captura.Impresion.A11_EncabezadoPregunta04_08"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:rec="clr-namespace:Ruv.WPF.Captura.Recursos"
             xmlns:congen="clr-namespace:Ruv.WPF.Captura.Controles"
             xmlns:my="clr-namespace:Ruv.WPF.Captura.Impresion"
             xmlns:sec="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
             xmlns:conv="clr-namespace:Ruv.WPF.Captura.Converters"
             mc:Ignorable="d"
             d:DesignHeight="535"
             d:DesignWidth="664">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Registro/Secciones/RegistroDiccionario.xaml" />
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Recursos/EstilosImpresion.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:VictimaConsultaConverter x:Key="VCC" />
      <conv:ConsultaDatoConverter x:Key="CDC" />
      <conv:CantidadTiempoConverter x:Key="CTC" />
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid VerticalAlignment="Top">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1*" />
      <ColumnDefinition Width="1*" />
      <ColumnDefinition Width="4*" />
      <ColumnDefinition Width="4*" />
      <ColumnDefinition Width="1*" />
      <ColumnDefinition Width="4*" />
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="1*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="15" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <my:EncabezadoColumna Texto="No. Consecutivo\n(Hoja 2-Item 11)"
                          OrientacionTexto="Vertical"
                          Grid.RowSpan="2"
                          Grid.Row="0"
                          Grid.Column="0" />
    <sec:SubTituloEntrada Numero="4"
                          Texto="." 
                          Grid.Column="1"/>
    <my:EncabezadoColumna Texto="Tipo de\ninmueble"
                          OrientacionTexto="Vertical"
                          Grid.Row="1"
                          Grid.Column="1" />
    <sec:SubTituloEntrada Numero="5"
                          Texto="Localización"
                          Grid.Column="2"
                          Grid.ColumnSpan="2"/>
    <my:EncabezadoColumna Texto="Lugar"
                          Grid.Row="1"
                          Grid.Column="2" />
    <my:EncabezadoColumna Texto="Entorno"
                          Grid.Row="1"
                          Grid.Column="3" />
    <sec:SubTituloEntrada Numero="6"
                          Texto="."
                          Grid.Column="4" />
    <my:EncabezadoColumna Texto="Tipo de\ntenencia"
                          OrientacionTexto="Vertical"
                          Grid.Row="1"
                          Grid.Column="4" />
    <sec:SubTituloEntrada Numero="7"
                          Texto="."
                          Grid.Column="5" />
    <my:EncabezadoColumna Texto="Nombre / Dirección"
                          Grid.Row="1"
                          Grid.Column="5" />
    <sec:SubTituloEntrada Numero="8"
                          Texto="Extensión"
                          Grid.Column="6"
                          Grid.ColumnSpan="2"/>
    <my:EncabezadoColumna Texto="Área"
                          Grid.Row="1"
                          Grid.Column="6" />
    <my:EncabezadoColumna Texto="Unidad\nde área"
                          OrientacionTexto="Vertical"
                          Grid.Row="1"
                          Grid.Column="7" />

  </Grid>
</UserControl>
