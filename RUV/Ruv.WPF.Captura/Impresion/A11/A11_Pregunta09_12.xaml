<UserControl x:Class="Ruv.WPF.Captura.Impresion.A11_Pregunta09_12"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:rec="clr-namespace:Ruv.WPF.Captura.Recursos"
             xmlns:congen="clr-namespace:Ruv.WPF.Captura.Controles"
             xmlns:my="clr-namespace:Ruv.WPF.Captura.Impresion"
             xmlns:sec="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
             xmlns:conv="clr-namespace:Ruv.WPF.Captura.Converters"
             mc:Ignorable="d"
             d:DesignHeight="535"
             d:DesignWidth="822">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Registro/Secciones/RegistroDiccionario.xaml" />
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Recursos/EstilosImpresion.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:ParametroNumeroConverter x:Key="PNC" />
      <conv:ConsultaDatoConverter x:Key="CDC" />
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <sec:SubTituloEntrada Numero="9"
                            Texto="¿Su Tierra / Lote le fue despojado(a)?" />
            <my:DatoColumna Texto="{Binding LoteFueDespojado, Converter={StaticResource CDC}, ConverterParameter=PARAMETRO}"
                     Grid.Row="1" />
            <!--<my:DatoSiNoColumna Valor="{Binding LoteFueDespojado}"
                          Grid.Row="1" />-->
      <sec:SubTituloEntrada Numero="10"
                            Grid.Column="1"
                            Texto="En caso de que su Tierra / Lote le haya sido despojado(a), indique el tipo y autor del despojo:" />
      <StackPanel Grid.Row="1"
                  Grid.Column="1">
        <my:DatoColumna Texto="{Binding DespojoTipo, Converter={StaticResource CDC}, ConverterParameter=PARAMETRO}" />
        <my:DatoColumna Texto="{Binding DespojoQuien}"
                        Margin="10,0,0,0" />
      </StackPanel >
      <sec:SubTituloEntrada Numero="11"
                            Grid.Column="2"
                            Texto="Su Tierra / Lote actualmente se encuentra:" />
      <my:DatoColumna Texto="{Binding EstadoActualLote, Converter={StaticResource CDC}, ConverterParameter=PARAMETRO}"
                      Grid.Row="1"
                      Grid.Column="2" />
    </Grid>
    <sec:SubTituloEntrada Numero="12"
                          Texto="¿Solicita que le sea tramitada la protección de los bienes inmuebles que dejó abandonados o que le fueron despojados?" />
    <DockPanel>
      <my:DatoColumna Texto="{Binding SolicitaProteccionMuebles, Converter={StaticResource CDC}, ConverterParameter=PARAMETRO}"
                      DockPanel.Dock="Left" />
      <TextBlock DockPanel.Dock="Left"
                 Margin="5,0">¿Por qué?</TextBlock>
      <my:DatoColumna Texto="{Binding SolicitaProteccionMueblesPorque}"
                      BordeVisible="False" />
    </DockPanel>
    <congen:TextoRecurso Recurso="{x:Static rec:Textos.a11t009}"
                         Margin="0,5"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Stretch" />
  </StackPanel>
</UserControl>
