<UserControl x:Class="Ruv.WPF.Captura.Impresion.A11_Pregunta13"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:rec="clr-namespace:Ruv.WPF.Captura.Recursos"
             xmlns:congen="clr-namespace:Ruv.WPF.Captura.Controles"
             xmlns:my="clr-namespace:Ruv.WPF.Captura.Impresion"
             xmlns:sec="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
             xmlns:conv="clr-namespace:Ruv.WPF.Captura.Converters"
             mc:Ignorable="d"
             d:DesignHeight="535"
             d:DesignWidth="822">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Registro/Secciones/RegistroDiccionario.xaml" />
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Recursos/EstilosImpresion.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:ParametroNumeroConverter x:Key="PNC" />
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>
    <sec:SubTituloEntrada Numero=""
                          AlineacionTexto="Center"
                          Texto="BIENES MUEBLES (HERRAMIENTAS, ANIMALES, CULTIVOS, VEHÍCULOS, ETC.)" />
    <sec:SubTituloEntrada Numero="13"
                          Texto="Si fueron abandonados bienes muebles (herramientas, animales, cultivos, vehículos, etc.) como consecuencia del conflicto armado, registre estos bienes en el siguiente cuadro . En la primera columna, especifique la persona a la que pertenece cada bien según el número consecutivo asignado en el ítem 11 de la Hoja 2 (cuadro de caracterización básica)."
                          Margin="0,5" />

    <Grid HorizontalAlignment="Center"
          Margin="0,5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border>
        <StackPanel Orientation="Vertical">
          <congen:TextoRecurso Recurso="{x:Static rec:Textos.a11t010}"
                               TextAlignment="Center"
                               Background="LightGray"
                               HorizontalAlignment="Stretch" />
          <StackPanel Orientation="Horizontal">
            <congen:TextoRecurso Recurso="{x:Static rec:Textos.a11t011}"
                                 TextWrapping="Wrap"
                                 Margin="0,0,5,0"
                                 MaxWidth="350" />
            <congen:TextoRecurso Recurso="{x:Static rec:Textos.a11t012}"
                                 TextWrapping="Wrap"
                                 Margin="0,0,5,0"
                                 MaxWidth="350" />
          </StackPanel>

        </StackPanel>
      </Border>
      <Border Grid.Column="1"
              Margin="10,0,0,0">
        <StackPanel Orientation="Vertical">
          <congen:TextoRecurso Recurso="{x:Static rec:Textos.a11t004}"
                               TextAlignment="Center"
                               Background="LightGray"
                               HorizontalAlignment="Stretch" />
          <congen:TextoRecurso Recurso="{x:Static rec:Textos.a11t005}"
                               TextWrapping="Wrap"
                               Margin="0,0,5,0"
                               MaxWidth="350" />
        </StackPanel>
      </Border>

    </Grid>
  </StackPanel>
</UserControl>
