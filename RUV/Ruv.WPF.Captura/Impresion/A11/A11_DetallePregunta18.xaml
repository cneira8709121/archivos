<UserControl x:Class="Ruv.WPF.Captura.Impresion.A11_DetallePregunta18"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:rec="clr-namespace:Ruv.WPF.Captura.Recursos"
             xmlns:congen="clr-namespace:Ruv.WPF.Captura.Controles"
             xmlns:my="clr-namespace:Ruv.WPF.Captura.Impresion"
             xmlns:sec="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
             xmlns:conv="clr-namespace:Ruv.WPF.Captura.Converters"
             mc:Ignorable="d"
             d:DesignHeight="21"
             d:DesignWidth="822">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Registro/Secciones/RegistroDiccionario.xaml" />
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Recursos/EstilosImpresion.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:ParametroNumeroConverter x:Key="PNC" />
      <conv:ConsultaDatoConverter x:Key="CDC" />
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1*" />
      <ColumnDefinition Width="12*"/>
      <ColumnDefinition Width="3*"/>
      <ColumnDefinition Width="3*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition MinHeight="21" />
    </Grid.RowDefinitions>
    <my:DatoColumna Texto="{Binding TipoAcreedor, Converter={StaticResource PNC}}"
                    Grid.Column="0" />
    <my:DatoColumna Texto="{Binding NombreAcreedor}"
                    Grid.Column="1" />
    <my:DatoFechaColumna FechaTexto="{Binding FechaContrajoObligacion}"
                         Grid.Column="2" />
    <Border Grid.Column="3" />
    <my:DatoColumna Texto="{Binding MontoAdeudado, StringFormat='{}#,##0.00'}"
                    BordeVisible="False"
                    HorizontalAlignment="Right"
                    AlineacionTexto="Right"
                    Grid.Column="3" />
  </Grid>
</UserControl>
