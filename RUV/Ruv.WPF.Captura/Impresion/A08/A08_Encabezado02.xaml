<UserControl x:Class="Ruv.WPF.Captura.Impresion.A08_Encabezado02"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:rec="clr-namespace:Ruv.WPF.Captura.Recursos"
             xmlns:congen="clr-namespace:Ruv.WPF.Captura.Controles"
             xmlns:sec="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
             xmlns:my="clr-namespace:Ruv.WPF.Captura.Impresion"
             xmlns:conv="clr-namespace:Ruv.WPF.Captura.Converters"
             mc:Ignorable="d"
             d:DesignHeight="192"
             d:DesignWidth="1528">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Ruv.WPF.Captura;component/Registro/Secciones/RegistroDiccionario.xaml" />
                <ResourceDictionary Source="/Ruv.WPF.Captura;component/Recursos/EstilosImpresion.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:VersionFUDConverter x:Key="VersionFUDConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" x:Name="Columna3" />

                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="4*" />

                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="4*" />

                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="3*" />

                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="4*" />

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <sec:SubTituloEntrada Grid.Column="0"
                            Numero="8"
                            Texto="." />
            <my:EncabezadoColumna Texto="N° Consecutivo\n(Hoja 2 de 4)"
                            Grid.Column="0"
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            OrientacionTexto="Vertical" />
            <sec:SubTituloEntrada Grid.Column="1"
                            Numero="9"
                            Texto="." />
            <my:EncabezadoColumna Texto="Víctima de\neste hecho"
                            Grid.Column="1"
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            OrientacionTexto="Vertical" />
            <sec:SubTituloEntrada Grid.Column="2" x:Name="SubTitulo10"
                            Numero="10"
                            Texto="." />
            <my:EncabezadoColumna Texto="Persona\nsecuestrada" x:Name="Titulo10"
                            Grid.Column="2"
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            OrientacionTexto="Vertical" />
            <!--AFECTACION-->
            <sec:SubTituloEntrada Grid.Column="3"
                            Grid.ColumnSpan="3"
                            Numero="11"
                            Texto="AFECTACIÓN" />
            <my:EncabezadoColumna Texto="Afectado"
                            Grid.Column="3"
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            OrientacionTexto="Vertical" />
            <my:EncabezadoColumna Texto="Tipo de\nafectación"
                            Grid.Column="4"
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            OrientacionTexto="Vertical" />
            <my:EncabezadoColumna Texto="En caso de\nhaber marcado\nla casilla 15 (Otro) en\nel campo anterior, registre\nen este campo\nla afectación sufrida"
                            Grid.Column="5"
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            OrientacionTexto="Horizontal" />
            <!--DENUNCIA PREVIA-->
            <sec:SubTituloEntrada Grid.Column="6"
                            Grid.ColumnSpan="5"
                            Numero="12"
                            Texto="DECLARACIÓN O DENUNCIA PREVIA" />
            <my:EncabezadoColumna Texto="¿Con respecto a estos\nhechos ya presentó\ndeclaración o denuncia?"
                            Grid.Column="6"
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            OrientacionTexto="Vertical" />
            <my:EncabezadoColumna Texto="Indique la Entidad"
                            Grid.Column="7"
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            OrientacionTexto="Horizontal" />
            <my:EncabezadoColumna Texto="Fecha denuncia\no declaración"
                            Grid.Column="8"
                            Grid.Row="1"
                            Grid.RowSpan="2" />
            <my:EncabezadoColumna Texto="Lugar denuncia\no declaración"
                            Grid.Column="9"
                            Grid.Row="1"
                            Grid.RowSpan="2" />
            <my:EncabezadoColumna Texto="Registre en caso\nde conocerlo el código\nde proceso, radicado\no algún dato\nde la denuncia o declaración"
                            Grid.Column="10"
                            Grid.Row="1"
                            Grid.RowSpan="2" />
            <!--DATOS DEL SECUESTRO-->
            <sec:SubTituloEntrada Grid.Column="11" x:Name="SubTituloHomicidioMasacre"
                            Grid.ColumnSpan="6"
                            Numero="13"
                            Texto="DATOS DEL HOMICIDIO O MASACRE" />
            <my:EncabezadoColumna Texto="Tipo de\nsecuestro" x:Name="Titulo_11"
                            Grid.Column="11"
                            Grid.Row="1"
                            Grid.RowSpan="2" />
            <my:EncabezadoColumna Texto="Finalidad\ndel secuestro\nextorsivo" x:Name="Titulo_12"
                            Grid.Column="12"
                            Grid.Row="1"
                            Grid.RowSpan="2" />
            <my:EncabezadoColumna Texto="Otra,\nindique ¿Cuál?" x:Name="Titulo_13"
                            OrientacionTexto="Horizontal"
                            Grid.Column="13"
                            Grid.Row="1"
                            Grid.RowSpan="2" />
            <my:EncabezadoColumna Texto="¿Le han pedido algún\ntipo de contraprestación\na cambio de la libertad\nde la víctima?"
                            OrientacionTexto="Vertical" x:Name="Titulo_14"
                            Grid.Column="14"
                            Grid.Row="1"
                            Grid.RowSpan="2" />
            <my:EncabezadoColumna Texto="¿Qué le han pedido?" x:Name="Titulo_15"
                            Grid.Column="15"
                            Grid.Row="1"
                            Grid.RowSpan="2" />
            <my:EncabezadoColumna Texto="Situación\nactual\nde la\nvíctima"
                            Grid.Column="16" x:Name="Titulo_16"
                            Grid.Row="1"
                            Grid.RowSpan="2" />
            <!--LIBERTAD DE LA VÍCTIMA-->
            <sec:SubTituloEntrada Grid.Column="17" x:Name="SubTitulo_17"
                            Grid.ColumnSpan="6"
                            Numero="14"
                            Texto="LIBERTAD DE LA VÍCTIMA" />
            <my:EncabezadoColumna Texto="¿Cómo se produjo\nla liberación\nde la víctima?"
                            Grid.Column="17" x:Name="Titulo_17"
                            Grid.Row="1"
                            Grid.RowSpan="2" />
            <my:EncabezadoColumna Texto="Fecha en que se\nprodujo la libertad\nde la víctima"
                            Grid.Column="18" x:Name="Titulo_18"
                            Grid.Row="1"
                            Grid.RowSpan="2" />
        </Grid>

    </StackPanel>
</UserControl>
