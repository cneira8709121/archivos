<UserControl x:Class="Ruv.WPF.Captura.Impresion.A02_Encabezado02"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:rec="clr-namespace:Ruv.WPF.Captura.Recursos"
             xmlns:congen="clr-namespace:Ruv.WPF.Captura.Controles"
             xmlns:sec="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
             xmlns:my="clr-namespace:Ruv.WPF.Captura.Impresion"
             mc:Ignorable="d"
             d:DesignHeight="192"
             d:DesignWidth="1528">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Registro/Secciones/RegistroDiccionario.xaml" />
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Recursos/EstilosImpresion.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="1*" />

        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="4*" />

        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="4*" />
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="4*" />
        <ColumnDefinition Width="4*" />

        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="4*" />
        <ColumnDefinition Width="4*" />
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="2*" />

        <ColumnDefinition Width="1*" />

      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <sec:SubTituloEntrada Grid.Column="0"
                            Grid.ColumnSpan="1"
                            Numero="8"
                            Texto="." />
      <my:EncabezadoColumna Texto="N° Consecutivo\n(Hoja 2 de 4)"
                            Grid.Column="0"
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            OrientacionTexto="Vertical" />
      <sec:SubTituloEntrada Grid.Column="1"
                            Grid.ColumnSpan="1"
                            Numero="9"
                            Texto="." />
      <my:EncabezadoColumna Texto="Víctima de\neste hecho"
                            Grid.Column="1"
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            OrientacionTexto="Vertical" />
      <!--AFECTACION-->
      <sec:SubTituloEntrada Grid.Column="2"
                            Grid.ColumnSpan="3"
                            Numero="10"
                            Texto="AFECTACIÓN" />
      <my:EncabezadoColumna Texto="Afectado"
                            Grid.Column="2"
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            OrientacionTexto="Vertical" />
      <my:EncabezadoColumna Texto="Tipo de afectación"
                            Grid.Column="3"
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            OrientacionTexto="Horizontal" />
      <my:EncabezadoColumna Texto="En caso de\nhaber marcado\nla casilla 15 (Otro) en\nel campo anterior, registre\nen este campo\nla afectación sufrida"
                            Grid.Column="4"
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            OrientacionTexto="Horizontal" />
      <!--DENUNCIA PREVIA-->
      <sec:SubTituloEntrada Grid.Column="5"
                            Grid.ColumnSpan="5"
                            Numero="11"
                            Texto="DECLARACIÓN O DENUNCIA PREVIA" />
      <my:EncabezadoColumna Texto="¿Con respecto a estos\nhechos ya presentó\ndeclaración o denuncia?"
                            Grid.Column="5"
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            OrientacionTexto="Vertical" />
      <my:EncabezadoColumna Texto="Indique la Entidad"
                            Grid.Column="6"
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            OrientacionTexto="Horizontal" />
      <my:EncabezadoColumna Texto="Fecha denuncia\no declaración"
                            Grid.Column="7"
                            Grid.Row="1"
                            Grid.RowSpan="2" />
      <my:EncabezadoColumna Texto="Lugar denuncia\no declaración"
                            Grid.Column="8"
                            Grid.Row="1"
                            Grid.RowSpan="2" />
      <my:EncabezadoColumna Texto="Registre en caso\nde conocerlo el código\nde proceso, radicado\no algún dato\nde la denuncia o declaración"
                            Grid.Column="9"
                            Grid.Row="1"
                            Grid.RowSpan="2" />
      <!--MEDIDAS DE PROTECCIÓN-->
      <sec:SubTituloEntrada Grid.Column="10"
                            Grid.ColumnSpan="6"
                            Numero="12"
                            Texto="MEDIDAS DE PROTECCIÓN" />
      <my:EncabezadoColumna Texto="¿Ha solicitado\nmedidas de\nprotección"
                            OrientacionTexto="Vertical"
                            Grid.Column="10"
                            Grid.Row="1"
                            Grid.RowSpan="2" />
      <my:EncabezadoColumna Texto="¿Le han brindado\nmedidas de\nprotección"
                            OrientacionTexto="Vertical"
                            Grid.Column="11"
                            Grid.Row="1"
                            Grid.RowSpan="2" />
      <my:EncabezadoColumna Texto="Tipo de medida"
                            Grid.Column="12"
                            Grid.Row="1"
                            Grid.RowSpan="2" />
      <my:EncabezadoColumna Texto="Entidad"
                            Grid.Column="13"
                            Grid.Row="1"
                            Grid.RowSpan="2" />
      <my:EncabezadoColumna Texto="¿Desde cuándo\ngoza de\ndicha\nmedida?"
                            Grid.Column="14"
                            Grid.Row="1"
                            Grid.RowSpan="2" />
      <my:EncabezadoColumna Texto="Vigencia"
                            Grid.Column="15"
                            Grid.Row="1"
                            Grid.RowSpan="2" />
      <!--ATENCIÓN MÉDICA-->
      <sec:SubTituloEntrada Numero="13"
                            Texto="."
                            Grid.Column="16" />
      <my:EncabezadoColumna Texto="¿Han continuado\ncon las amenazas?"
                            OrientacionTexto="Vertical"
                            Grid.Column="17"
                            Grid.Row="1"
                            Grid.RowSpan="2" />

    </Grid>

  </StackPanel>
</UserControl>
