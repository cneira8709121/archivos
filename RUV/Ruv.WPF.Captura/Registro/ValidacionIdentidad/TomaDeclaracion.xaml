<Window x:Class="Ruv.WPF.Captura.Registro.TomaDeclaracion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ruv.WPF.Captura.Registro"
        xmlns:Converter="clr-namespace:Ruv.WPF.Captura.Converters"
        mc:Ignorable="d" Loaded="Window_Loaded"
        Title="TomaDeclaracion" Height="584.36" Width="800" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid>
        <Grid Margin="30,10,10,10" Height="50" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="23"></RowDefinition>
                <RowDefinition Height="23"></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock Height="23" Grid.Row="0" HorizontalAlignment="Left" Text="Tipo Declaracion:" VerticalAlignment="Center" />
            <ComboBox Height="23" Grid.Row="1" Width="150" HorizontalAlignment="Left" x:Name="cbTipoDeclaracion" SelectedValuePath="Id" DisplayMemberPath="Nombre" VerticalAlignment="Center" ItemsSource="{Binding Converter={StaticResource ParametrosConverter}, ConverterParameter=TipoTomaDeclaracion}" SelectedValue="{Binding TipoDeclaracion, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, NotifyOnValidationError=True, ValidatesOnDataErrors=True}" />
        </Grid>
        <GroupBox Margin="10,60,10,200" Height="210" VerticalAlignment="Top" Header="Información de la persona" >
            <Grid Margin="10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="23"></RowDefinition>
                    <RowDefinition Height="23"></RowDefinition>
                    <RowDefinition Height="23"></RowDefinition>
                    <RowDefinition Height="23"></RowDefinition>
                    <RowDefinition Height="23"></RowDefinition>
                    <RowDefinition Height="23"></RowDefinition>
                    <RowDefinition Height="23"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Height="23" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Text="Tipo Documento:" VerticalAlignment="Center" />
                <ComboBox Height="23" Grid.Row="1" Grid.Column="0" Width="150" HorizontalAlignment="Left" x:Name="cbTipoDocumento" 
                          SelectedValuePath="Id" DisplayMemberPath="Nombre" VerticalAlignment="Center" 
                          ItemsSource="{Binding Converter={StaticResource ParametrosConverter}, ConverterParameter=TipoDeDocumentoDeIdentidad}" 
                          SelectedValue="{Binding IdTipoDocumento, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />

                <TextBlock Height="23" Grid.Column="1" HorizontalAlignment="Left" Name="txtNumeroDocumento" Text="Numero Documento:" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Width="150" HorizontalAlignment="Left" VerticalAlignment="Center" Height="23" Text="{Binding NumeroDocumento, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, NotifyOnValidationError=True, ValidatesOnDataErrors=True}"></TextBox>

                <TextBlock Height="23" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" Text="Primer Nombre:" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="0" Width="150" HorizontalAlignment="Left" VerticalAlignment="Center" Height="23" Text="{Binding PrimerNombre, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, NotifyOnValidationError=True, ValidatesOnDataErrors=True}"></TextBox>

                <TextBlock Height="23" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Text="Segundo Nombre:" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" Width="150" HorizontalAlignment="Left" VerticalAlignment="Center" Height="23" Text="{Binding SegundoNombre, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, NotifyOnValidationError=True, ValidatesOnDataErrors=True}"></TextBox>

                <TextBlock Height="23" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left" Text="Primer Apellido:" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="2" Width="150" HorizontalAlignment="Left" VerticalAlignment="Center" Height="23" Text="{Binding PrimerApellido, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, NotifyOnValidationError=True, ValidatesOnDataErrors=True}"></TextBox>

                <TextBlock Height="23" Grid.Row="2" Grid.Column="3" HorizontalAlignment="Left" Text="Segundo Apellido:" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="3" Width="150" HorizontalAlignment="Left" VerticalAlignment="Center" Height="23" Text="{Binding SegundoApellido, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, NotifyOnValidationError=True, ValidatesOnDataErrors=True}"></TextBox>

                <TextBlock Height="23" Grid.Row="4" Grid.ColumnSpan="2" Grid.Column="0" HorizontalAlignment="Left" Text="Celular:" VerticalAlignment="Center" />
                <TextBox Grid.Row="5" Grid.ColumnSpan="2" Grid.Column="0" Width="250" HorizontalAlignment="Left" VerticalAlignment="Center" Height="23" Text="{Binding Celular, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, NotifyOnValidationError=True, ValidatesOnDataErrors=True}"></TextBox>

                <TextBlock Height="23" Grid.Row="4" Grid.ColumnSpan="2" Grid.Column="2" HorizontalAlignment="Left" Text="Correo:" VerticalAlignment="Center" />
                <TextBox Grid.Row="5" Grid.ColumnSpan="2" Grid.Column="2" Width="250" HorizontalAlignment="Left" VerticalAlignment="Center" Height="23" Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, NotifyOnValidationError=True, ValidatesOnDataErrors=True}"></TextBox>

                <Button Content=" Validar Persona " x:Name="btnBuscar" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Right" Height="23" Click="btnBuscar_Click" IsEnabled="{Binding Valido, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnDataErrors=True}" ></Button>
            </Grid>
        </GroupBox>
        <GroupBox Margin="10,280,10,50" Header="Resultado de Validación">
            <Grid Margin="10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="50"></RowDefinition>
                </Grid.RowDefinitions>
                <DataGrid x:Name="dgPersonasEncontradas" HorizontalAlignment="Left" Grid.Row="0" VerticalAlignment="Top" Width="740" Height="100" AutoGenerateColumns="False" >
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Primer Nombre" Binding="{Binding PrimerNombre}" />
                        <DataGridTextColumn Header="Segundo Nombre" Binding="{Binding SegundoNombre}" />
                        <DataGridTextColumn Header="Primer Apellido" Binding="{Binding PrimerApellido}" />
                        <DataGridTextColumn Header="Segundo Apellido" Binding="{Binding SegundoApellido}" />
                        <DataGridTextColumn Header="Vigencia" Binding="{Binding Vigencia}" />
                        <DataGridTextColumn Header="Resultado" Binding="{Binding Resultado}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Height="23" Grid.Row="1" HorizontalAlignment="Left" Text="Correo:" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Height="50" Width="740" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" ></TextBox>
            </Grid>
        </GroupBox>
        <!--ItemsSource="{Binding Converter={StaticResource ParametrosConverter}, ConverterParameter=TipoDeDocumentoDeIdentidad}"-->
        <Button Content="Continuar" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10,10,10,10" Width="75" Click="Button_Click"/>

    </Grid>
</Window>
