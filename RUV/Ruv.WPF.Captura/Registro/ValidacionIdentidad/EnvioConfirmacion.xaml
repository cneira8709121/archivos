<Page x:Class="Ruv.WPF.Captura.Registro.ValidacionIdentidad.EnvioConfirmacion"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Ruv.WPF.Captura.Registro.ValidacionIdentidad"
      xmlns:utils="clr-namespace:Ruv.WPF.Captura.Utils"
      xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="EnvioConfirmacion">

    <Grid>
        <StackPanel>
        <GroupBox Header="Confirmación de envió de correo electronico" Margin="50">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="25" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Label VerticalAlignment="Center" Content="Enviar el codigo de confirmación" Grid.ColumnSpan="2" Grid.Row="0" HorizontalAlignment="Center"></Label>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" >
                        <RadioButton HorizontalAlignment="Center" Content="Correo   " VerticalAlignment="Center" IsChecked="{Binding AlCorreo, Mode=TwoWay}" ></RadioButton>
                        <RadioButton HorizontalAlignment="Center" Content="SMS  " VerticalAlignment="Center" IsChecked="{Binding AlCelular, Mode=TwoWay}" ></RadioButton>
                    <Button Content="Enviar" x:Name="btnEnviarCodigo" Width="100" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" Click="btnEnviarCodigo_Click"></Button>
                </StackPanel>
            </Grid>
        </GroupBox>
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="80">
                    <Label Content="Codigo de verificación" VerticalAlignment="Center"></Label>
                    <TextBox x:Name="txtNumero" Width="150" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Codigo, Mode=TwoWay}" >
                        <i:Interaction.Behaviors>
                            <utils:clsTextBoxFilterBehavior ConjuntoDeCaracteres="SoloDigitos" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                </StackPanel>
                <Button Content="Validar" x:Name="btnValidar" Width="100" Height="23" HorizontalAlignment="Center" Click="btnValidar_Click"></Button>
            </StackPanel>
                
        </StackPanel>
    </Grid>
</Page>
