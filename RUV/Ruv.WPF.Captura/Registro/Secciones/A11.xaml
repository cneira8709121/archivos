<UserControl xmlns:my1="clr-namespace:Ruv.WPF.Captura.Registro.Secciones.Controles"
             xmlns:my="clr-namespace:Ruv.WPF.Captura.Impresion"
             x:Class="Ruv.WPF.Captura.Registro.Secciones.A11"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sec="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
             xmlns:rec="clr-namespace:Ruv.WPF.Captura.Recursos"
             xmlns:congen="clr-namespace:Ruv.WPF.Captura.Controles"
             xmlns:conv="clr-namespace:Ruv.WPF.Captura.Converters"
             xmlns:common="clr-namespace:Ruv.Infrastructure.Crosscutting.Common;assembly=Ruv.Infrastructure.Crosscutting.Common"
             xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" 
             xmlns:utils="clr-namespace:Ruv.WPF.Captura.Utils"
             mc:Ignorable="d"
             d:DesignHeight="1370"
             d:DesignWidth="802">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Ruv.WPF.Captura;component/Registro/Secciones/RegistroDiccionario.xaml" />
                <ResourceDictionary Source="/Ruv.WPF.Captura;component/Recursos/RecursosGeoEntorno.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:ConsultaDatoConverter x:Key="ConsultaDato" />
            <conv:ListaVictimasConverter x:Key="ListaVictimas" />
            <conv:ListaParametrosConverter x:Key="LPC" />
            <conv:ListaPersonasAnexoConverter x:Key="ListaPersonasAnexo"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel x:Name="spMain">

        <ScrollViewer DockPanel.Dock="Top">
            <StackPanel Orientation="Vertical">
                <Grid DockPanel.Dock="Top">
                    <Border BorderThickness="1"
                  BorderBrush="Black"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center">
                    </Border>
                    <DockPanel>
                        <Border DockPanel.Dock="Right"
                    BorderThickness="1"
                    BorderBrush="Black"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                            <TextBlock VerticalAlignment="Center"
                         Margin="5,2"
                         Text="{Binding Path=Numero, StringFormat='ANEXO {0}'}" />
                        </Border>
                        <!--<TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Margin="10,0">FOLIO __ DE __</TextBlock>-->
                        <congen:TextoRecurso Recurso="{x:Static rec:Textos.a06t001}"
                                 Style="{StaticResource styTextoDescripcion}" />
                    </DockPanel>
                </Grid>
                <TextBlock DockPanel.Dock="Top"
                   Margin="0,5,0,0"
                   Style="{StaticResource styTituloSeccion}"
                   Text="{Binding Nombre}" />
                <sec:FechaLugar Numero="1"
                        Texto="Relacione la fecha y lugar de los hechos (si el abandono o despojo está asociado a otro hecho declarado en este formato, pase directamente a la pregunta 2"
                        DockPanel.Dock="Top"
                        DataContext="{Binding FechaYLugar}"
                                ComboPaisEsVisible="False"/>
                <sec:SubTituloEntrada Numero="2"
                              Texto="Con respecto a estos hechos ¿Usted o alguno de los miembros del hogar había presentado declaración o denuncia?" />

                <my1:DenunciaPrevia_Edicion DataContext="{Binding Path=DenunciaPrevia}"
                                    Conjunto="Entidades_Anexo_11_DP"
                                    Margin="5" />
                <sec:SubTituloEntrada Numero="3"
                              Texto="Si tuvo que abandonar bienes inmuebles (tierras, lotes o viviendas) y/o fue despojado de los mismos como consecuencia del conflicto armado, registre estos bienes en el siguiente cuadro. En la primera columna, especifique la persona a la que pertenece cada bien según el número consecutivo asignado en el ítem 11 de la Hoja 2 (cuadro de caracterización básica)." />

                <congen:DummyControl FuenteDeDatos="{Binding BienesInmuebles, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}">
                    <DataGrid x:Name="dgrBienesInmuebles"
                    AutoGenerateColumns="False"
                    HorizontalAlignment="Left"
                    Margin="5"
                    CanUserReorderColumns="False"
                    CanUserAddRows="False"
                    MaxHeight="250"
                    VerticalAlignment="Top"
                    IsSynchronizedWithCurrentItem="True"
                    Grid.IsSharedSizeScope="True">
                        <DataGrid.Columns>
                            <!--==============================-->
                            <DataGridTemplateColumn Header="Persona">
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding PersonaAfectadaId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                              SelectedValuePath="ID"
                              DisplayMemberPath="NombreCompleto"
                              ItemsSource="{Binding Source={StaticResource RUV}, Path=DeclaracionActual.PersonasAfectadas.ListaPersonas}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding PersonaAfectadaId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                              SelectedValuePath="ID"
                              DisplayMemberPath="NombreCompleto"
                              ItemsSource="{Binding Source={StaticResource RUV}, Path=DeclaracionActual.PersonasAfectadas.ListaPersonas}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--==============================-->
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.HeaderTemplate >
                                    <DataTemplate>
                                        <sec:SubTituloEntrada Numero="4" Texto="Tipo inmueble" HorizontalAlignment="Stretch" Margin="0"  />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding TipoInmueble, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                              ItemsSource="{Binding Converter={StaticResource LPC}, ConverterParameter=TipoDeInmueble}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Nombre" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding TipoInmueble, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                              ItemsSource="{Binding Converter={StaticResource LPC}, ConverterParameter=TipoDeInmueble}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Nombre" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--==============================-->
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.HeaderTemplate >
                                    <DataTemplate>
                                        <sec:SubTituloEntrada Numero="5" Texto="Localización" HorizontalAlignment="Stretch" Margin="0"  />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition MinWidth="50"
                                          MaxWidth="150"
                                          SharedSizeGroup="Col01" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="Auto"
                                          SharedSizeGroup="Col03" />
                                                <ColumnDefinition MinWidth="50"
                                          MaxWidth="200"
                                          SharedSizeGroup="Col04" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="0" />
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Margin="0,0,5,0" Visibility="Collapsed">País</TextBlock>
                                            <TextBlock Grid.Row="1" Margin="0,0,5,0">Depto</TextBlock>
                                            <TextBlock Grid.Row="2" Margin="0,0,5,0">Mcpio</TextBlock>
                                            <TextBlock Grid.Column="2"
                                 TextAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="5,0">Entorno</TextBlock>
                                            <TextBlock Grid.Column="3"
                                 Margin="0,0,5,0"
                                 Style="{StaticResource styTextBlockGeoEntorno02}" />
                                            <TextBlock Grid.Column="3"
                                 Grid.Row="1"
                                 Margin="0,0,5,0"
                                 Style="{StaticResource styTextBlockGeoEntorno01}" />

                                <ComboBox Grid.Column="1" Grid.Row="0" x:Name="cbLugarPais" Visibility="Collapsed" />
                                <ComboBox Grid.Column="1" Grid.Row="1" x:Name="cbLugarDepartamento" />
                                <ComboBox Grid.Column="1" Grid.Row="2" x:Name="cbLugarMunicipio" />
                                <ComboBox x:Name="cbxTipoEntorno"
                                    VerticalAlignment="Center"
                                    DisplayMemberPath="Nombre"
                                    SelectedValuePath="Id"
                                    SelectedValue="{Binding TipoEntorno, Converter={StaticResource TEC},
                                      Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                    ItemsSource="{Binding Source={StaticResource RUV}, Path=InfoGeneral.ListaTipoEntorno}"
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Margin="5,0" />

                                <ComboBox x:Name="cbxLocalidadCorregimiento"
                                    IsEditable="true"
                                    VerticalAlignment="Center"
                                    DisplayMemberPath="Nombre"
                                    SelectedValuePath="Id"
                                    Grid.Column="4">
                                                    <i:Interaction.Behaviors>
                                                        <congen:ComboMayusculaBehavior />
                                                        <congen:ComboSoloLetrasBehavior />
                                                    </i:Interaction.Behaviors>
                                </ComboBox>

                                <ComboBox x:Name="cbxBarrioVereda"
                                    IsEditable="true"
                                    VerticalAlignment="Center"
                                    DisplayMemberPath="Nombre"
                                    SelectedValuePath="Id"
                                    Grid.Column="4"
                                    Grid.Row="1">
                                                    <i:Interaction.Behaviors>
                                                        <congen:ComboMayusculaBehavior />
                                                        <congen:ComboSoloLetrasBehavior />
                                                    </i:Interaction.Behaviors>
                                </ComboBox>

                                <congen:Geografia x:Name="geoLugar"
                                        ComboPais="{Binding ElementName=cbLugarPais}"
                                        ComboDepartamento="{Binding ElementName=cbLugarDepartamento}"
                                        ComboMunicipio="{Binding ElementName=cbLugarMunicipio}"
                                        PaisId="{Binding LocalizacionPais, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                        DepartamentoId="{Binding LocalizacionDepartamento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                        MunicipioId="{Binding LocalizacionMunicipio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                        Grid.Column="1"
                                        Grid.RowSpan="3" />

                                <congen:GeoEntorno x:Name="geeEntorno"
                                         ComboMunicipio="{Binding ElementName=cbLugarMunicipio}"
                                         TipoEntornoId="{Binding TipoEntorno}"
                                         ComboBarrioVereda="{Binding ElementName=cbxBarrioVereda}"
                                         ComboLocalidadCorregimiento="{Binding ElementName=cbxLocalidadCorregimiento}"
                                         BarrioVeredaId="{Binding BarrioVeredaId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                         LocalidadCorregimientoId="{Binding LocalidadCorregimientoId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                         BarrioVeredaNombre="{Binding BarrioVeredaNombre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                         LocalidadCorregimientoNombre="{Binding LocalidadCorregimientoNombre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                         Grid.Column="4"
                                         Grid.RowSpan="3" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition MinWidth="50"
                                          MaxWidth="150"
                                          SharedSizeGroup="Col01" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="Auto"
                                          SharedSizeGroup="Col03" />
                                                <ColumnDefinition MinWidth="50"
                                          MaxWidth="200"
                                          SharedSizeGroup="Col04"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="0" />
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Margin="0,0,5,0" Visibility="Collapsed">País</TextBlock>
                                            <TextBlock Grid.Row="1" Margin="0,0,5,0">Depto</TextBlock>
                                            <TextBlock Grid.Row="2" Margin="0,0,5,0">Mcpio</TextBlock>
                                            <TextBlock Grid.Column="2"
                                 TextAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="5,0">Entorno</TextBlock>
                                            <TextBlock Grid.Column="3"
                                 Margin="0,0,5,0"
                                 Style="{StaticResource styTextBlockGeoEntorno02}" />
                                            <TextBlock Grid.Column="3"
                                 Grid.Row="1"
                                 Margin="0,0,5,0"
                                 Style="{StaticResource styTextBlockGeoEntorno01}" />

                                            <ComboBox Grid.Column="1" Grid.Row="0" x:Name="cbLugarPais" Visibility="Collapsed"/>
                                            <ComboBox Grid.Column="1" Grid.Row="1" x:Name="cbLugarDepartamento" />
                                            <ComboBox Grid.Column="1" Grid.Row="2" x:Name="cbLugarMunicipio" />
                                            <ComboBox x:Name="cbxTipoEntorno"
                                    VerticalAlignment="Center"
                                    DisplayMemberPath="Nombre"
                                    SelectedValuePath="Id"
                                    SelectedValue="{Binding TipoEntorno, Converter={StaticResource TEC},
                                      Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                    ItemsSource="{Binding Source={StaticResource RUV}, Path=InfoGeneral.ListaTipoEntorno}"
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Margin="5,0" />

                                            <ComboBox x:Name="cbxLocalidadCorregimiento"
                                    IsEditable="true"
                                    VerticalAlignment="Center"
                                    DisplayMemberPath="Nombre"
                                    SelectedValuePath="Id"
                                    Grid.Column="4">
                                                <i:Interaction.Behaviors>
                                                    <congen:ComboMayusculaBehavior />
                                                    <congen:ComboSoloLetrasBehavior />
                                                </i:Interaction.Behaviors>
                                            </ComboBox>

                                            <ComboBox x:Name="cbxBarrioVereda"
                                    IsEditable="true"
                                    VerticalAlignment="Center"
                                    DisplayMemberPath="Nombre"
                                    SelectedValuePath="Id"
                                    Grid.Column="4"
                                    Grid.Row="1">
                                                <i:Interaction.Behaviors>
                                                    <congen:ComboMayusculaBehavior />
                                                    <congen:ComboSoloLetrasBehavior />
                                                </i:Interaction.Behaviors>
                                            </ComboBox>

                                            <congen:Geografia x:Name="geoLugar"
                                        ComboPais="{Binding ElementName=cbLugarPais}"
                                        ComboDepartamento="{Binding ElementName=cbLugarDepartamento}"
                                        ComboMunicipio="{Binding ElementName=cbLugarMunicipio}"
                                        PaisId="{Binding LocalizacionPais, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                        DepartamentoId="{Binding LocalizacionDepartamento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                        MunicipioId="{Binding LocalizacionMunicipio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                        Grid.Column="1"
                                        Grid.RowSpan="3" />

                                            <congen:GeoEntorno x:Name="geeEntorno"
                                         ComboMunicipio="{Binding ElementName=cbLugarMunicipio}"
                                         TipoEntornoId="{Binding TipoEntorno}"
                                         ComboBarrioVereda="{Binding ElementName=cbxBarrioVereda}"
                                         ComboLocalidadCorregimiento="{Binding ElementName=cbxLocalidadCorregimiento}"
                                         BarrioVeredaId="{Binding BarrioVeredaId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                         LocalidadCorregimientoId="{Binding LocalidadCorregimientoId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                         BarrioVeredaNombre="{Binding BarrioVeredaNombre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                         LocalidadCorregimientoNombre="{Binding LocalidadCorregimientoNombre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                         Grid.Column="4"
                                         Grid.RowSpan="3" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                
                            </DataGridTemplateColumn>
                            <!--==============================-->
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.HeaderTemplate >
                                    <DataTemplate>
                                        <sec:SubTituloEntrada Numero="6" Texto="Tipo tenencia" HorizontalAlignment="Stretch" Margin="0"  />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding TipoTenencia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                              ItemsSource="{Binding Converter={StaticResource LPC}, ConverterParameter=TipoDeTenencia}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Nombre" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding TipoTenencia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                              ItemsSource="{Binding Converter={StaticResource LPC}, ConverterParameter=TipoDeTenencia}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Nombre" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--==============================-->
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.HeaderTemplate >
                                    <DataTemplate>
                                        <sec:SubTituloEntrada Numero="7" Texto="Nombre/Dirección" HorizontalAlignment="Stretch" Margin="0"  />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox 
                                            Text="{Binding NombreDireccion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" 
                                            MaxLength="250"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox 
                                            Text="{Binding NombreDireccion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" 
                                            MaxLength="250"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--==============================-->
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <sec:SubTituloEntrada Numero="8" Texto="Extensión Área" HorizontalAlignment="Stretch" Margin="0"  />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <!--<DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock TextAlignment="Center">8 Extensión<LineBreak />Área</TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>-->
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <congen:EntradaDouble 
                                            Valor="{Binding ExtensionArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" 
                                            />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <congen:EntradaDouble Valor="{Binding ExtensionArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--==============================-->
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock TextAlignment="Center">Extensión<LineBreak />Unidad de área</TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding ExtensionUnidadDeArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                              ItemsSource="{Binding Converter={StaticResource LPC}, ConverterParameter=UnidadDeArea}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Nombre" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding ExtensionUnidadDeArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                              ItemsSource="{Binding Converter={StaticResource LPC}, ConverterParameter=UnidadDeArea}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Nombre" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--==============================-->
                        </DataGrid.Columns>
                    </DataGrid>
                </congen:DummyControl>
                <!--=======================================-->
                <StackPanel Orientation="Horizontal"
                    Margin="5">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Padding"
                      Value="5,3" />
                            <Setter Property="Margin"
                      Value="0,0,5,0" />
                            <Setter Property="MinWidth"
                      Value="60" />
                        </Style>
                    </StackPanel.Resources>
                    <Button x:Name="btnAgregarBienInmueble">Agregar</Button>
                    <Button x:Name="btnQuitarBienInmueble">Quitar</Button>
                </StackPanel>
                <!--=======================================-->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <!--=======================================-->
                    <sec:SubTituloEntrada Numero="9"
                                Texto="¿Su tierra/lote le fué despojado(a)?" />
                    <StackPanel Orientation="Vertical"
                      Grid.Row="1">
                        <sec:ListaOpciones VerticalAlignment="Center"
                               TipoOpciones="Unica"
                               TipoParametros="SiNoNsNr"
                               ValorSeleccionUnica="{Binding LoteFueDespojado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                        <TextBlock TextWrapping="Wrap"
                       TextAlignment="Center"
                       Style="{StaticResource styDescripcionCajaEntrada}">Si la respuesta es NO, pase directamente a la pregunta 12.</TextBlock>
                    </StackPanel>
                    <!--=======================================-->
                    <sec:SubTituloEntrada Numero="10"
                                Texto="En caso de que su Tierra / Lote le haya sido despojado(a), indique el tipo y autor del despojo:"
                                Grid.Column="1" />
                    <my1:AutorDespojo x:Name="adDespojoQuien"
                            Grid.Column="1"
                            Grid.Row="1"
                            Margin="5"
                            ValorSeleccionado="{Binding DespojoTipo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                            Texto="{Binding DespojoQuien, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                    <!--=======================================-->
                    <sec:SubTituloEntrada Numero="11"
                                Texto="Su Tierra / Lote actualmente se encuentra:"
                                Grid.Column="2" />
                    <sec:ListaOpciones x:Name="loEstadoActualLote"
                             Grid.Column="2"
                             Grid.Row="1"
                             VerticalAlignment="Top"
                             TipoOpciones="Unica"
                             TipoParametros="EstadoActualLote"
                             ValorSeleccionUnica="{Binding EstadoActualLote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                    <!--=======================================-->
                </Grid>
                <my1:BloqueadorControles Valor="{Binding LoteFueDespojado}">
                    <my1:BloqueadorControles.ValoresQueDesbloquean>
                        <my1:ValorParametroHabilitante Valor="{x:Static  Member=common:eParametrosHabilitantes.SiNoNsNr_Si}" />
                    </my1:BloqueadorControles.ValoresQueDesbloquean>
                    <my1:ControlIndividual Elemento="{Binding ElementName=adDespojoQuien}" />
                    <my1:ControlIndividual Elemento="{Binding ElementName=loEstadoActualLote}" />
                </my1:BloqueadorControles>
                <sec:SubTituloEntrada Numero="12"
                              Texto="¿Solicita que le sea tramitada la protección de los bienes inmuebles que dejó abandonados o que le fueron despojados?" />
                <WrapPanel Orientation="Horizontal">
                    <sec:ListaOpciones Grid.Column="2"
                             Grid.Row="1"
                             VerticalAlignment="Top"
                             TipoOpciones="Unica"
                             TipoParametros="SiNoNsNr"
                             ValorSeleccionUnica="{Binding SolicitaProteccionMuebles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                    
                    <TextBlock TextWrapping="Wrap"
                     VerticalAlignment="Top"
                     Margin="0,3,0,0"
                     Style="{StaticResource styDescripcionCajaEntrada}">¿Por qué?</TextBlock>
                    <TextBox Text="{Binding SolicitaProteccionMueblesPorque, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                   MinWidth="150"
                   VerticalAlignment="Top"
                   TextWrapping="Wrap" />
                    
                </WrapPanel>
                <WrapPanel Orientation="Horizontal">
                    <TextBlock TextWrapping="Wrap"
                     VerticalAlignment="Top"
                     Margin="0,3,0,0"
                     Style="{StaticResource styDescripcionCajaEntrada}">Nota: En caso que la respuesta a la anterior pregunta sea afirmativa (SI), diligencie el formulario único de solicitud individual de protección de predios abandonados a causa de la violencia. Si el (la) Declarante pertenece a un grupo étnico, diligencie el Formulario Único de Solicitud de Protección de los Derechos Territoriales de Grupos Étnicos Afectados a Causa de la Violencia. El diligenciamiento de estos formatos es responsabilidad de los(as) representantes de Ministerio Público. Estos formatos son requisito para que los bienes protegidos sean inscritos en el Registro Único de Predios y Territorios Abandonados (RUPTA).</TextBlock>
                </WrapPanel>
                <!--=======================================-->
                <sec:SubTituloEntrada Numero=""
                              Margin="0,5"
                              AlineacionTexto="Center"
                              Texto="BIENES MUEBLES (HERRAMIENTAS, ANIMALES, CULTIVOS, VEHÍCULOS, ETC.)" />
                <!--=======================================-->
                <sec:SubTituloEntrada Numero="13"
                              Texto="Si fueron abandonados bienes muebles (herramientas, animales, cultivos, vehículos, etc.) como consecuencia del conflicto armado, registre estos bienes en el siguiente cuadro . En la primera columna, especifique la persona a la que pertenece cada bien según el número consecutivo asignado en el ítem 11 de la Hoja 2 (cuadro de caracterización básica)." />
                <congen:DummyControl FuenteDeDatos="{Binding BienesMuebles, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}">
                    <DataGrid x:Name="dgrBienesMuebles"
                    AutoGenerateColumns="False"
                    HorizontalAlignment="Left"
                    Margin="5"
                    CanUserReorderColumns="False"
                    CanUserAddRows="False"
                    MaxHeight="250"
                    VerticalAlignment="Top"
                    IsSynchronizedWithCurrentItem="True" >
                        <DataGrid.Columns>
                            <!--==============================-->
                            <DataGridTemplateColumn Header="Persona">
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding PersonaAfectadaId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                              SelectedValuePath="ID"
                              DisplayMemberPath="NombreCompleto"
                              ItemsSource="{Binding Source={StaticResource RUV}, Path=DeclaracionActual.PersonasAfectadas.ListaPersonas}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding PersonaAfectadaId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                              SelectedValuePath="ID"
                              DisplayMemberPath="NombreCompleto"
                              ItemsSource="{Binding Source={StaticResource RUV}, Path=DeclaracionActual.PersonasAfectadas.ListaPersonas}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--==============================-->
                            <DataGridTemplateColumn >
                                <DataGridTemplateColumn.HeaderTemplate >
                                    <DataTemplate>
                                        <sec:SubTituloEntrada Numero="14" Texto="Tipo Bien" HorizontalAlignment="Stretch" Margin="0"  />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding TipoBien, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                              ItemsSource="{Binding Converter={StaticResource LPC}, ConverterParameter=TipoDeBien}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Nombre" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding TipoBien, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                              ItemsSource="{Binding Converter={StaticResource LPC}, ConverterParameter=TipoDeBien}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Nombre" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--==============================-->
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.HeaderTemplate >
                                    <DataTemplate>
                                        <sec:SubTituloEntrada Numero="15" Texto="Descripción" HorizontalAlignment="Stretch" Margin="0"  />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox 
                                            Text="{Binding Descripcion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" 
                                            MaxLength="200"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox 
                                            Text="{Binding Descripcion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" 
                                            MaxLength="200"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--==============================-->
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.HeaderTemplate >
                                    <DataTemplate>
                                        <sec:SubTituloEntrada Numero="16" Texto="Tipo tenencia" HorizontalAlignment="Stretch" Margin="0"  />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding TipoTenencia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                              ItemsSource="{Binding Converter={StaticResource LPC}, ConverterParameter=TipoDeTenencia}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Nombre" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding TipoTenencia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                              ItemsSource="{Binding Converter={StaticResource LPC}, ConverterParameter=TipoDeTenencia}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Nombre" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--==============================-->
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.HeaderTemplate >
                                    <DataTemplate>
                                        <sec:SubTituloEntrada Numero="17" Texto="Cantidad" HorizontalAlignment="Stretch" Margin="0"  />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <congen:EntradaDouble Valor="{Binding Cantidad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <congen:EntradaDouble Valor="{Binding Cantidad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--==============================-->
                        </DataGrid.Columns>
                    </DataGrid>
                </congen:DummyControl>
                <!--=======================================-->
                <StackPanel Orientation="Horizontal"
                    Margin="5">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Padding"
                      Value="5,3" />
                            <Setter Property="Margin"
                      Value="0,0,5,0" />
                            <Setter Property="MinWidth"
                      Value="60" />
                        </Style>
                    </StackPanel.Resources>
                    <Button x:Name="btnAgregarBienMueble">Agregar</Button>
                    <Button x:Name="btnQuitarBienMueble">Quitar</Button>
                </StackPanel>
                <!--=======================================-->
                <!--=======================================-->
                <sec:SubTituloEntrada Numero="18"
                              Texto="Pregunte si, al momento de los hechos victimizantes, existían créditos o pasivos asociados a los bienes muebles y/o inmuebles referenciados en este anexo. Indague si estas obligaciones entraron en mora o han sido objeto de refinanciación, reestructuración o consolidación como consecuencia de los hechos victimizantes. De ser así, registre en el siguiente cuadro los datos básicos de estas obligaciones." />
                <congen:DummyControl FuenteDeDatos="{Binding CreditosPasivos, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}">
                    <DataGrid x:Name="dgrCreditosPasivos"
                    AutoGenerateColumns="False"
                    HorizontalAlignment="Left"
                    Margin="5"
                    CanUserReorderColumns="False"
                    CanUserAddRows="False"
                    MaxHeight="250"
                    VerticalAlignment="Top"
                    IsSynchronizedWithCurrentItem="True">
                        <DataGrid.Columns>
                            <!--==============================-->
                            <DataGridTemplateColumn Header="Tipo de acreedor">
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding TipoAcreedor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                              ItemsSource="{Binding Converter={StaticResource LPC}, ConverterParameter=TipoAcreedorEnDeudasPersona}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Nombre" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding TipoAcreedor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                              ItemsSource="{Binding Converter={StaticResource LPC}, ConverterParameter=TipoAcreedorEnDeudasPersona}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Nombre" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--==============================-->
                            <DataGridTemplateColumn Header="Nombre del acreedor">
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding NombreAcreedor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox x:Name="A11_NombreAcreedor" Text="{Binding NombreAcreedor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--==============================-->
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock TextAlignment="Center">Fecha en que contrajo<LineBreak />la deuda u obligación</TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <sec:CajaIngresoFecha x:Name="A11_FechaContrajoObligacionEdit" 
                                          Fecha="{Binding FechaContrajoObligacion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <sec:CajaIngresoFecha x:Name="A11_FechaContrajoObligacion"
                                          Fecha="{Binding FechaContrajoObligacion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                                        <!--<TextBlock x:Name="A11_FechaContrajoObligacion" TextAlignment="Center"
                                            Text="{Binding FechaContrajoObligacion, StringFormat='{}dd  MMM  yyyy', Mode=OneWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />-->
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--==============================-->
                            <DataGridTemplateColumn Header="Monto adeudado">
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <congen:EntradaDouble x:Name="A11_MontoAdeudadoEdit" Valor="{Binding MontoAdeudado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <congen:EntradaDouble x:Name="A11_MontoAdeudado"  Valor="{Binding MontoAdeudado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--==============================-->
                        </DataGrid.Columns>
                    </DataGrid>
                </congen:DummyControl>

                <!--=======================================-->
                <StackPanel Orientation="Horizontal"
                    Margin="5">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Padding"
                      Value="5,3" />
                            <Setter Property="Margin"
                      Value="0,0,5,0" />
                            <Setter Property="MinWidth"
                      Value="60" />
                        </Style>
                    </StackPanel.Resources>
                    <Button x:Name="btnAgregarCreditoPasivo">Agregar</Button>
                    <Button x:Name="btnQuitarCreditoPasivo">Quitar</Button>
                </StackPanel>
                <!--=======================================-->
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

  
  
  
  