<UserControl xmlns:my1="clr-namespace:Ruv.WPF.Captura.Registro.Secciones.Controles"
             xmlns:my="clr-namespace:Ruv.WPF.Captura.Impresion"
             x:Class="Ruv.WPF.Captura.Registro.Secciones.A01"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sec="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
             xmlns:rec="clr-namespace:Ruv.WPF.Captura.Recursos"
             xmlns:congen="clr-namespace:Ruv.WPF.Captura.Controles"
             xmlns:conv="clr-namespace:Ruv.WPF.Captura.Converters"
             mc:Ignorable="d"
             d:DesignHeight="1187"
             d:DesignWidth="939">
  <UserControl.Resources>
        
        <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="RegistroDiccionario.xaml" />
        </ResourceDictionary.MergedDictionaries>
            <conv:VersionFUDConverter x:Key="VersionFUDConverter"/>
            <conv:ConsultaDatoConverter x:Key="ConsultaDato" />
            <conv:EliminadosConverter x:Key="ConsultaEliminado" />
            <conv:ListaVictimasConverter x:Key="ListaVictimas" />   
            <conv:ListaPersonasAnexoConverter x:Key="ListaPersonasAnexo"/>
        </ResourceDictionary>
  </UserControl.Resources>
  <DockPanel x:Name="spMain">
    <Grid DockPanel.Dock="Bottom">
      <Grid.Resources>
        <Style TargetType="Button">
          <Setter Property="Margin"
                  Value="5" />
          <Setter Property="Padding"
                  Value="5,2" />
          <Setter Property="VerticalAlignment"
                  Value="Bottom" />
        </Style>
      </Grid.Resources>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition x:Name="cdAcciones"
                          Width="1*" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Left">
        <ComboBox x:Name="cbxListaCompletaPersonas"
                  Width="200"
                    ItemsSource="{Binding Source={StaticResource RUV}, Path=DeclaracionActual.PersonasAfectadas.ListaPersonas, Converter={StaticResource ListaPersonasAnexo}, ConverterParameter=Acto_terrorista_1}"
                  DisplayMemberPath="NombreCompleto"
                  Margin="5,5,0,5" />
        <Button Click="PrepararAgregarNuevaPersona"
                Margin="0,5">Agregar</Button>
        <Button Click="AgregarCopia"
                Margin="0,5"
                ToolTip="Agrega el usuario seleccionado al anexo copiando la información del usuario seleccionado actualmente.">Agregar copia</Button>
        <Button Click="EiminarPersonas"
                VerticalAlignment="Bottom">
          Quitar persona
        </Button>
      </StackPanel>
      <StackPanel x:Name="spAcciones"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Grid.Column="1"
                  Visibility="Visible">
        <Button Click="AceptarEdicion"
                IsDefault="True">Aceptar</Button>
        <Button Click="CancelarEdicion"
                IsCancel="True">Cancelar</Button>
      </StackPanel>
    </Grid>
    <ScrollViewer DockPanel.Dock="Top">
      <StackPanel Orientation="Vertical">
        <Grid DockPanel.Dock="Top">
          <Border BorderThickness="1"
                  BorderBrush="Black"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center">
          </Border>
          <DockPanel>
            <Border DockPanel.Dock="Right"
                    BorderThickness="1"
                    BorderBrush="Black"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
              <TextBlock VerticalAlignment="Center"
                         Margin="5,2">ANEXO 1</TextBlock>
            </Border>
            <!--<TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Margin="10,0">FOLIO __ DE __</TextBlock>-->
            <congen:TextoRecurso Recurso="{x:Static rec:Textos.a06t001}"
                                 Style="{StaticResource styTextoDescripcion}" />
          </DockPanel>
        </Grid>
        <TextBlock DockPanel.Dock="Top"
                   Margin="0,5,0,0"
                   Style="{StaticResource styTituloSeccion}"
                   Text="{Binding Nombre}" />
        <sec:FechaLugar Numero="1"
                        DockPanel.Dock="Top"
                        DataContext="{Binding FechaYLugar}"
                        ComboPaisEsVisible="False"
                        />
        <congen:TextoRecurso Recurso="{x:Static rec:Textos.a06t004}"
                             DockPanel.Dock="Top"
                             TextAlignment="Left"
                             Style="{StaticResource styTextoDescripcion}" />
                <Grid DockPanel.Dock="Top" >
                    <Grid.ColumnDefinitions >
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>
          <sec:InfoVictima_Cedula DataContext="{Binding InformacionJefeGrupo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                  Numero="2" Visibility="{Binding Source={StaticResource RUV}, Path=I.DeclaracionActual.VersionFUD, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource VersionFUDConverter}, ConverterParameter=VisibleEnVersion1}" />
          <sec:InfoVictima_EstudioHijos DataContext="{Binding InformacionJefeGrupo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                        Numero="3" Visibility="{Binding Source={StaticResource RUV}, Path=I.DeclaracionActual.VersionFUD, Converter={StaticResource VersionFUDConverter}, ConverterParameter=VisibleEnVersion1}"
                                        Grid.Column="1" />
          <sec:InfoVictima_Sisben DataContext="{Binding InformacionJefeGrupo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                  Numero="4" Visibility="{Binding Source={StaticResource RUV}, Path=I.DeclaracionActual.VersionFUD, Converter={StaticResource VersionFUDConverter}, ConverterParameter=VisibleEnVersion1}"
                                  Grid.Column="2" />
        </Grid>
        <Grid DockPanel.Dock="Top"
              Margin="0,5,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>
          <sec:InfoVictima_Inscrito DataContext="{Binding InformacionJefeGrupo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                    Numero="5" Visibility="{Binding Source={StaticResource RUV}, Path=I.DeclaracionActual.VersionFUD, Converter={StaticResource VersionFUDConverter}, ConverterParameter=VisibleEnVersion1}" />
          <sec:InfoVictima_Salud DataContext="{Binding InformacionJefeGrupo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                 Numero="6" Visibility="{Binding Source={StaticResource RUV}, Path=I.DeclaracionActual.VersionFUD, Converter={StaticResource VersionFUDConverter}, ConverterParameter=VisibleEnVersion1}"
                                 Grid.Column="1" Grid.ColumnSpan="2" />
        </Grid>
                <Grid DockPanel.Dock="Top"
              Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <sec:InfoVictima_Laboral DataContext="{Binding InformacionJefeGrupo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                   Numero="7"
                                   Grid.Column="1"  />
                </Grid>
                <Grid Margin="5,10,5,5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition x:Name="cdEdicion"
                              Width="2*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <sec:SubTituloEntrada Numero=""
                                Texto="Grupo Familiar"
                                Grid.ColumnSpan="2" />
          <!--SelectionChanged="PersonaSeleccionada"-->
          <StackPanel Grid.Row="1"
                      Grid.RowSpan="2"
                      Margin="0,0,9,0">
            <DockPanel>
              <congen:TextoRecurso Recurso="{x:Static rec:Textos.a01t006}"
                                   Style="{StaticResource styTextoDescripcionIzq}"
                                   TextAlignment="Left"
                                   DockPanel.Dock="Top" />
              <TextBlock DockPanel.Dock="Left"
                         VerticalAlignment="Center"
                         Margin="5">Víctima 1:</TextBlock>
              <ComboBox Margin="5"
                        HorizontalAlignment="Left"
                        Width="250"
                        ItemsSource="{Binding Victimas, Converter={StaticResource ListaVictimas}, ConverterParameter=1}"
                        DisplayMemberPath="NombreCompleto"
                        SelectedValuePath="ID"
                        SelectedValue="{Binding JefeGrupoFamiliarId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}">
              </ComboBox>
            </DockPanel>
            <ListBox MinHeight="20"
                     ItemsSource="{Binding Victimas, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                     SelectionChanged="PersonaSeleccionada"
                     x:Name="lbxListaPersonas"                     
                     BorderThickness="0"
                     SelectionMode="Extended">
              <ListBox.ItemTemplate>
                <DataTemplate>
                   <TextBlock Foreground="{Binding EstadoRegistro, Converter={StaticResource ConsultaEliminado}}" Text="{Binding PersonaAfectadaId, Converter={StaticResource ConsultaDato}, ConverterParameter=NOMBRECOMPLETOAFECTADO}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
          <GridSplitter x:Name="gsSeparador"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        Grid.Row="1"
                        Width="7" />

          <StackPanel x:Name="svEdicion"
                      Grid.Column="1"
                      Grid.Row="1"
                      Grid.IsSharedSizeScope="True"
                      Background="LightGray">
            <StackPanel.Resources>
              <Style BasedOn="{StaticResource styDescripcionCajaEntrada}"
                     TargetType="TextBlock">
                <Setter Property="Margin"
                        Value="6,3,3,3" />
                <Setter Property="VerticalAlignment"
                        Value="Top" />
              </Style>
              <Style BasedOn="{StaticResource styBaseTextBoxNormal}"
                     TargetType="TextBox">
                <Setter Property="VerticalAlignment"
                        Value="Bottom" />
                <Setter Property="Margin"
                        Value="0,1,4,1" />
              </Style>
              <Style TargetType="{x:Type my:DatoSiNoColumna}">
                <Setter Property="Margin"
                        Value="0,1" />
              </Style>
            </StackPanel.Resources>
            <Grid VerticalAlignment="Top">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"
                                  SharedSizeGroup="grpEdicion01" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <!--===============================-->
              <TextBlock Grid.Row="0">Nombre completo</TextBlock>
              <TextBlock Text="{Binding PersonaAfectadaId, Converter={StaticResource ConsultaDato}, ConverterParameter=NOMBRECOMPLETOAFECTADO }"
                         Margin="0,1"
                         VerticalAlignment="Center"
                         Grid.Row="0"
                         Grid.Column="1" />
              <!--===============================-->
              <TextBlock Grid.Row="1">Víctima de este hecho</TextBlock>
              <my:DatoSiNoColumna x:Name="chkVictimaDelHecho"
                                  Valor="{Binding VictimaDeEsteHecho, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                  IncluirNsNr="False"
                                  Grid.Column="1"
                                  Grid.Row="1"
                                  Background="White"
                                  HorizontalAlignment="Left" />
              <!--Contenedor="{Binding ElementName=svEdicion}"-->
            </Grid>
            <!--===============================-->
            <my1:Afectacion_Edicion x:Name="aeAfectacion"
                                    DataContext="{Binding Path=Afectacion}"
                                    Conjunto="Afectacion_Anexo_1" />
            <my1:DenunciaPrevia_Edicion x:Name="dpDenuncia"
                                        DataContext="{Binding Path=DenunciaPrevia}"
                                        Conjunto="Entidades_Anexo_1_DP" />

            <StackPanel x:Name="spBienes">
              <sec:SubTituloEntrada Numero=""
                                    Texto="Daño en Bienes Muebles o Inmuebles"
                                    HorizontalAlignment="Stretch"
                                    ColorTexto="Inverso"
                                    Margin="0,0,0,5" />
              <congen:DummyControl FuenteDeDatos="{Binding Bienes, ValidatesOnDataErrors=True, NotifyOnValidationError=True}">
                <DataGrid x:Name="dgrBienes"
                          AutoGenerateColumns="False"
                          HorizontalAlignment="Left"
                          Margin="5"
                          CanUserReorderColumns="False"
                          CanUserAddRows="False"
                          MaxHeight="200"
                          VerticalAlignment="Top"
                          IsSynchronizedWithCurrentItem="True">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Tipo">
                      <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                          <ComboBox SelectedValue="{Binding TipoBien, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                    SelectedValuePath="Id"
                                    DisplayMemberPath="Nombre"
                                    ItemsSource="{Binding Source={StaticResource RUV}, Path=InfoGeneral.ListaTiposDeBienesAnexo01}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellEditingTemplate>
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <ComboBox SelectedValue="{Binding TipoBien, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                    SelectedValuePath="Id"
                                    DisplayMemberPath="Nombre"
                                    ItemsSource="{Binding Source={StaticResource RUV}, Path=InfoGeneral.ListaTiposDeBienesAnexo01}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!--==============================-->
                    <DataGridTemplateColumn Header="Descripción">
                      <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                          <TextBox Text="{Binding Descripcion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellEditingTemplate>
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBox Text="{Binding Descripcion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!--==============================-->
                    <DataGridTemplateColumn>
                      <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                          <TextBlock TextAlignment="Center">Calidad de la víctima<LineBreak />(frente al bien)</TextBlock>
                        </DataTemplate>
                      </DataGridTemplateColumn.HeaderTemplate>
                      <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                          <ComboBox SelectedValue="{Binding CalidadDeLaVictima, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                    ItemsSource="{Binding Converter={StaticResource ParametrosConverter}, ConverterParameter=TipoPerteneciaBienAfectadoAnexo1}"
                                    SelectedValuePath="Id"
                                    DisplayMemberPath="Nombre" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellEditingTemplate>
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <ComboBox SelectedValue="{Binding CalidadDeLaVictima, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                    ItemsSource="{Binding Converter={StaticResource ParametrosConverter}, ConverterParameter=TipoPerteneciaBienAfectadoAnexo1}"
                                    SelectedValuePath="Id"
                                    DisplayMemberPath="Nombre" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </congen:DummyControl>
              <StackPanel Orientation="Horizontal"
                          Margin="5">
                <StackPanel.Resources>
                  <Style TargetType="Button">
                    <Setter Property="Padding"
                            Value="5,3" />
                    <Setter Property="Margin"
                            Value="0,0,5,0" />
                  </Style>
                </StackPanel.Resources>
                <Button x:Name="btnAgregarBien"
                        Content="Agregar bien" />
                <Button x:Name="btnQuitarBien"
                        Content="Quitar bien seleccionado" />
              </StackPanel>
            </StackPanel>

            <!--===============================-->
            <sec:SubTituloEntrada Numero=""
                                  Texto="Átención Médica"
                                  HorizontalAlignment="Stretch"
                                  ColorTexto="Inverso"
                                  Margin="0,0,0,5" />
            <Grid x:Name="grdAtencionMedica"
                  VerticalAlignment="Top"
                  Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"
                                  SharedSizeGroup="grpEdicion01" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <!--===============================-->
              <TextBlock Grid.Row="0">Recibió atención médica</TextBlock>
              <my:DatoSiNoColumna Valor="{Binding AtencionMedicaRecibio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                  Grid.Column="1"
                                  Grid.Row="0"
                                  Background="White"
                                  HorizontalAlignment="Left" />
              <!--===============================-->
              <TextBlock Grid.Row="1">Entidad que lo atendió</TextBlock>
              <TextBox Text="{Binding AtencionEntidadMedica, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                       x:Name="tbxEntidad"
                       Grid.Row="1"
                       Grid.Column="1" 
                       CharacterCasing="Upper"
                       />
              <!--===============================-->
              <TextBlock Grid.Row="2">Lugar de atención</TextBlock>
              <congen:Geografia Grid.Row="2"
                                Grid.Column="1"
                                Grid.RowSpan="2"
                                ComboPais="{Binding ElementName=cb01Pais}"
                                ComboDepartamento="{Binding ElementName=cb01Departamento}"
                                ComboMunicipio="{Binding ElementName=cb01Municipio}"
                                PaisId="{Binding AtencionMedicaPais, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                DepartamentoId="{Binding AtencionMedicaDepartamento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                MunicipioId="{Binding AtencionMedicaMunicipio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                <StackPanel Grid.Row="2"
                Grid.Column="1">
                    <TextBlock Visibility="Collapsed" >País</TextBlock>
                    <ComboBox x:Name="cb01Pais" Visibility="Collapsed" />
                </StackPanel>
                            <StackPanel Grid.Row="2"
                          Grid.Column="1">
                <TextBlock>Departamento</TextBlock>
                <ComboBox x:Name="cb01Departamento" />
              </StackPanel>
              <StackPanel Grid.Row="3"
                          Grid.Column="1">
                <TextBlock>Municipio</TextBlock>
                <ComboBox x:Name="cb01Municipio" />
              </StackPanel>
              <!--==============================-->
            </Grid>

            <!--===============================-->
            <my1:BloqueadorControles Valor="{Binding AtencionMedicaRecibio}">
              <my1:ControlIndividual Elemento="{Binding ElementName=tbxEntidad}" />
              <my1:ControlIndividual Elemento="{Binding ElementName=cb01Departamento}" />
              <my1:ControlIndividual Elemento="{Binding ElementName=cb01Municipio}" />
            </my1:BloqueadorControles>

            <!--FICHA CONTROL DE CAMBIOS RUV 27-03-12
              No se debe bloquear ningun campo cuando se marque la persona como "no víctima"              
            <my1:BloqueadorControles x:Name="bc01"
                                     Valor="{Binding VictimaDeEsteHecho}">
              
              <my1:ControlIndividual Elemento="{Binding ElementName=spBienes}" />
              <my1:ControlIndividual Elemento="{Binding ElementName=grdAtencionMedica}" />
            </my1:BloqueadorControles>
              -->
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>

  
  
  
  