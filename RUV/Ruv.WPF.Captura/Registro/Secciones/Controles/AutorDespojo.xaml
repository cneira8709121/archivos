<UserControl x:Class="Ruv.WPF.Captura.Registro.Secciones.Controles.AutorDespojo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="107"
             d:DesignWidth="466">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Registro/Secciones/RegistroDiccionario.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid x:Name="grdMain"
        Grid.Row="1"
        Grid.Column="1">
    <Grid.Resources>
      <Style TargetType="RadioButton"
             BasedOn="{StaticResource styRadioButtonX}">
        <Setter Property="Margin"
                Value="0,0,10,3" />
      </Style>
    </Grid.Resources>
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="1.5*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition />
      <RowDefinition />
      <RowDefinition />
    </Grid.RowDefinitions>
    <!--================================-->
    <RadioButton GroupName="grp01"
                 x:Name="rbt01"
                 Checked="SeleccionCambia"
                 Tag="5561"
                 VerticalAlignment="Center">
      <TextBlock Style="{StaticResource styBaseTextBlockNormal}"
                 TextWrapping="Wrap">Material</TextBlock>
    </RadioButton>
    <StackPanel Grid.Column="1">
      <TextBlock Style="{StaticResource styBaseTextBlockPequeño}">¿Quién?</TextBlock>
      <TextBox x:Name="tbx01"
               TextChanged="CambioTexto"
               Margin="0,0,0,5">
        <TextBox.Style>
          <Style TargetType="TextBox">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsChecked, ElementName=rbt01}"
                           Value="False">
                <Setter Property="Foreground"
                        Value="Transparent" />
                <Setter Property="IsEnabled"
                        Value="False" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBox.Style>
      </TextBox>
    </StackPanel>
    <!--================================-->
    <RadioButton GroupName="grp01"
                 x:Name="rbt02"
                 Checked="SeleccionCambia"
                 Tag="5562"
                 Grid.Row="1"
                 VerticalAlignment="Center">
      <TextBlock Style="{StaticResource styBaseTextBlockNormal}"
                 TextWrapping="Wrap">Administrativo</TextBlock>
    </RadioButton>
    <StackPanel Grid.Column="1"
                Grid.Row="1">
      <TextBlock Style="{StaticResource styBaseTextBlockPequeño}">¿Qué entidad?</TextBlock>
      <TextBox x:Name="tbx02"
               TextChanged="CambioTexto"
               Margin="0,0,0,5">
        <TextBox.Style>
          <Style TargetType="TextBox">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsChecked, ElementName=rbt02}"
                           Value="False">
                <Setter Property="Foreground"
                        Value="Transparent" />
                <Setter Property="IsEnabled"
                        Value="False" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBox.Style>
      </TextBox>
    </StackPanel>
    <!--================================-->
    <RadioButton GroupName="grp01"
                 x:Name="rbt03"
                 Checked="SeleccionCambia"
                 Tag="5563"
                 Grid.Row="2"
                 VerticalAlignment="Center">
      <TextBlock Style="{StaticResource styBaseTextBlockNormal}"
                 TextWrapping="Wrap">Judicial</TextBlock>
    </RadioButton>
    <StackPanel Grid.Column="1"
                Grid.Row="2">
      <TextBlock Style="{StaticResource styBaseTextBlockPequeño}">¿Qué juzgado?</TextBlock>
      <TextBox x:Name="tbx03"
               TextChanged="CambioTexto"
               Margin="0,0,0,5">
        <TextBox.Style>
          <Style TargetType="TextBox">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsChecked, ElementName=rbt03}"
                           Value="False">
                <Setter Property="Foreground"
                        Value="Transparent" />
                <Setter Property="IsEnabled"
                        Value="False" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBox.Style>
      </TextBox>
    </StackPanel>
    <!--================================-->
    <RadioButton GroupName="grp01"
                 x:Name="rbt04"
                 Checked="SeleccionCambia"
                 Tag="5564"
                 Grid.Row="3"
                 VerticalAlignment="Center">
      <TextBlock Style="{StaticResource styBaseTextBlockNormal}"
                 TextWrapping="Wrap">Negocio Privado</TextBlock>
    </RadioButton>
    <StackPanel Grid.Column="1"
                Grid.Row="3">
      <TextBlock Style="{StaticResource styBaseTextBlockPequeño}">¿Quién?</TextBlock>
      <TextBox x:Name="tbx04"
               TextChanged="CambioTexto"
               Margin="0,0,0,5">
        <TextBox.Style>
          <Style TargetType="TextBox">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsChecked, ElementName=rbt04}"
                           Value="False">
                <Setter Property="Foreground"
                        Value="Transparent" />
                <Setter Property="IsEnabled"
                        Value="False" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBox.Style>
      </TextBox>
    </StackPanel>
    <!--================================-->
  </Grid>
</UserControl>
