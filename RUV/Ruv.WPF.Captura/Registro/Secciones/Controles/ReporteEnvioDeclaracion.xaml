<Window x:Class="Ruv.WPF.Captura.Registro.Secciones.Controles.ReporteEnvioDeclaracion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Ruv.WPF.Captura;component/Recursos/Imagenes/RUV.ico"
        Title="Novedades de Transmisión"
        WindowStyle="ToolWindow"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        MinHeight="318"
        Width="483"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DesignWidth="695">
  <Grid>
    <TabControl Margin="5,5,5,47"
                Name="tabMain">
      <TabItem Name="tabErrores"
               Visibility="Collapsed">
        <TabItem.HeaderTemplate>
          <DataTemplate>
            <TextBlock Foreground="Red"
                       FontWeight="Bold">Errores</TextBlock>
          </DataTemplate>
        </TabItem.HeaderTemplate>
        <Grid>
          <TextBlock Margin="6,6,0,0"
                     TextAlignment="Left"
                     VerticalAlignment="Top"
                     TextWrapping="Wrap"
                     HorizontalAlignment="Left"
                     Width="429">
            La declaración no fue registrada debido a los inconveninetes aqui reportados.<LineBreak />Realice las correcciones necesarias e intente transmitir de nuevo.
          </TextBlock>
          <ListBox Margin="6,44,6,6"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   Name="lbxErrores">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Padding="5"
                           HorizontalAlignment="Stretch"
                           Text="{Binding}">
                  <TextBlock.Background>
              <LinearGradientBrush EndPoint="0.5,1"
                                   StartPoint="0.5,0">
                <GradientStop Color="White"
                              Offset="0" />
                <GradientStop Color="#FFFFD4D4"
                              Offset="1" />
              </LinearGradientBrush>
            </TextBlock.Background>
                </TextBlock>
              </DataTemplate>
            </ListBox.ItemTemplate>

          </ListBox>
        </Grid>
      </TabItem>
      <TabItem Name="tabAdvertencias"
               Visibility="Collapsed">
        <TabItem.HeaderTemplate>
          <DataTemplate>
            <TextBlock Foreground="DarkBlue"
                       FontWeight="Bold">Advertencias</TextBlock>
          </DataTemplate>
        </TabItem.HeaderTemplate>
        <Grid>
          <TextBlock Margin="6,6,0,0"
                     VerticalAlignment="Top"
                     TextAlignment="Left"
                     TextWrapping="Wrap"
                     HorizontalAlignment="Left"
                     Width="429">
            La declaración se registró exitosamente.<LineBreak />Sin embargo se reportaron los siguientes mensajes de advertencia.
          </TextBlock>
          <ListBox Margin="6,44,6,6"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   Name="lbxAdvertencias">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Padding="5"
                           HorizontalAlignment="Stretch"
                           Text="{Binding}">
                  <TextBlock.Background>
                    <LinearGradientBrush EndPoint="0.5,1"
                                         StartPoint="0.5,0">
                      <GradientStop Color="White"
                                    Offset="0" />
                      <GradientStop Color="#FFDBDBFF"
                                    Offset="1" />
                    </LinearGradientBrush>
                  </TextBlock.Background>
                </TextBlock>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>
    </TabControl>
    <Button Content="Cerrar"
            Click="Cerrar"
            HorizontalAlignment="Left"
            Margin="12,0,0,12"
            Name="button1"
            Width="75"
            Height="23"
            VerticalAlignment="Bottom" />
  </Grid>
</Window>
