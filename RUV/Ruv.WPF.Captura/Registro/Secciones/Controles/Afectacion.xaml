<UserControl xmlns:my="clr-namespace:Ruv.WPF.Captura.Impresion"
             x:Class="Ruv.WPF.Captura.Registro.Secciones.Afectacion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:congen="clr-namespace:Ruv.WPF.Captura.Controles"
             xmlns:sec="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
             d:DesignHeight="300"
             d:DesignWidth="595">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Registro/Secciones/RegistroDiccionario.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="RadioButton"
             BasedOn="{StaticResource styRadioButtonX}" />
      <Style TargetType="CheckBox"
             BasedOn="{StaticResource styCheckBoxX}" />
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid VerticalAlignment="Stretch">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="8*" />
      <ColumnDefinition Width="3*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition />
    </Grid.RowDefinitions>
    <!--PREGUNTA CÉDULA-->
    <sec:SubTituloEntrada x:Name="seTitulo"
                          Grid.ColumnSpan="4"
                          Numero="."
                          Texto="AFECTACIÓN" />
    <my:EncabezadoColumna Texto="Afectado"
                          Grid.Column="0"
                          Grid.Row="1"
                          OrientacionTexto="Vertical" />
    <my:EncabezadoColumna Texto="Tipo de\nAfectación"
                          Grid.Column="1"
                          Grid.Row="1" />
    <my:EncabezadoColumna Texto="En caso de haber marcado\nla casilla 'Otro' en el campo\nanterior, registre en este campo\nla afectación sufrida"
                          Grid.Column="2"
                          Grid.Row="1" />

  </Grid>
</UserControl>
