<Window x:Class="Ruv.WPF.Captura.Registro.Secciones.Controles.SeleccionAnexo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Ruv.WPF.Captura;component/Recursos/Imagenes/RUV.ico"
        Title="Selección de Anexo"
        WindowStyle="ToolWindow"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        Closing="CerrarVentana"
        Height="357"
        Width="500">
  <Grid>
    <Grid.Resources>
      <Style TargetType="ListBoxItem" />
    </Grid.Resources>
    <ListBox Margin="12,32,12,116"
             Style="{x:Null}"
             SelectionMode="Single"
             Name="lbxAnexos"
             MouseDoubleClick="SeleccionDefinitiva_DobleClick">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <TextBlock FontWeight="Bold"
                       Margin="0,0,5,0"
                       Text="{Binding NombreAnexo}" />
            <TextBlock Text="{Binding JefeDeHogar}"
                       Foreground="{Binding ColorEstado}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Button Content="Aceptar"
            Click="Aceptar_Click"
            IsDefault="True"
            HorizontalAlignment="Left"
            Margin="12,0,0,87"
            Width="80"
            Height="23"
            VerticalAlignment="Bottom" />
        <Button Content="Cerrar"
            Click="Cancelar_Click"
            IsCancel="True"
            Height="23"
            Margin="99,0,0,87"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Left"
            Width="80" />
        <TextBlock Height="23"
               Margin="12,12,12,0"
               Text="Seleccione el anexo que desee editar."
               TextWrapping="Wrap"
               VerticalAlignment="Top" />
    <TextBlock Margin="12,0,12,58"
               Text="O agregue un nuevo anexo:"
               TextWrapping="Wrap"
               Height="23"
               VerticalAlignment="Bottom" />
    <ComboBox Margin="12,0,102,12"
              Name="cbxNuevoAnexo"
              Height="40"
              VerticalAlignment="Bottom">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Nombre}"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <Button x:Name="btnAgregar"
            Content="Agregar"
            Click="AgregarAnexo"
            Height="23"
            IsDefault="True"
            Margin="0,0,12,20"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Width="75" />
    <Button x:Name="btnEliminar"
            Content="Eliminar"
            Click="EliminarAnexo"
            Height="23"
            Margin="0,0,12,87"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Width="75" />
  </Grid>
</Window>
