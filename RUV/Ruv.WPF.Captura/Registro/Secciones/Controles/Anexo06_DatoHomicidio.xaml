<UserControl xmlns:my="clr-namespace:Ruv.WPF.Captura.Impresion"
             x:Class="Ruv.WPF.Captura.Registro.Secciones.Anexo06_DatoHomicidio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:congen="clr-namespace:Ruv.WPF.Captura.Controles"
             xmlns:sec="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
             d:DesignHeight="300"
             d:DesignWidth="595">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Registro/Secciones/RegistroDiccionario.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="RadioButton"
             BasedOn="{StaticResource styRadioButtonX}" />
      <Style TargetType="CheckBox"
             BasedOn="{StaticResource styCheckBoxX}" />
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid VerticalAlignment="Top">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="4*" />
      <ColumnDefinition Width="13*" />
      <ColumnDefinition Width="6*" />
      <ColumnDefinition Width="3*" />
      <ColumnDefinition Width="6*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition />
    </Grid.RowDefinitions>
    <!--PREGUNTA CÉDULA-->
    <sec:SubTituloEntrada x:Name="seTitulo"
                          Grid.ColumnSpan="5"
                          Numero="."
                          AlineacionTexto="Center"
                          Texto="DATOS DEL HOMICIDIO O MASACRE" />
    <my:EncabezadoColumna Texto="¿Con ocasión a estos hechos,\nalgún(a) menor de edad\nquedó huérfano(a)?"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Grid.Row="1" />
    <my:EncabezadoColumna Texto="En caso afirmativo\nindique si\nquedó huérfano de:"
                          Grid.Column="2"
                          Grid.Row="1" />

    <my:EncabezadoColumna Texto="¿Recuerda\nel número\nde personas\nmuertas por\neste hecho?"
                          Grid.Column="3"
                          Grid.Row="1" />
    <my:EncabezadoColumna Texto="En caso afirmativo\nIndique cuantas"
                          Grid.Column="4"
                          Grid.Row="1" />
  </Grid>
</UserControl>
