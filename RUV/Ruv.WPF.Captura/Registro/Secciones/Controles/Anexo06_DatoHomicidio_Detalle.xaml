<UserControl xmlns:my="clr-namespace:Ruv.WPF.Captura.Impresion"
             x:Class="Ruv.WPF.Captura.Registro.Secciones.Anexo06_DatoHomicidio_Detalle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:congen="clr-namespace:Ruv.WPF.Captura.Controles"
             xmlns:sec="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
             d:DesignHeight="300"
             d:DesignWidth="595">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Registro/Secciones/RegistroDiccionario.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="RadioButton"
             BasedOn="{StaticResource styRadioButtonX}" />
      <Style TargetType="CheckBox"
             BasedOn="{StaticResource styCheckBoxX}" />
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid VerticalAlignment="Top">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="4*" />
      <ColumnDefinition Width="13*" />
      <ColumnDefinition Width="6*" />
      <ColumnDefinition Width="3*" />
      <ColumnDefinition Width="6*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition />
    </Grid.RowDefinitions>
    <my:DatoSiNoColumna DireccionTamaño="Both"
                        Valor="{Binding AlgunMenorQuedoHuerfano, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
    <Border Grid.Column="1">
      <StackPanel>
        <TextBlock FontSize="{StaticResource TamañoTextoMedio}">Nombre del menor</TextBlock>
      <TextBox Text="{Binding NombreMenorHuerfano, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
               Margin="3" />
      </StackPanel>
    </Border>
    <Border Grid.Column="2">
      <ComboBox SelectedValue="{Binding MenorQuedoHuerfanoDe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                SelectedValuePath="Id"
                DisplayMemberPath="Nombre" />
    </Border>
    <my:DatoSiNoColumna Grid.Column="3"
                        DireccionTamaño="Both"
                        Valor="{Binding RecuerdaNumeroPersonasMuertas, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
    <Border Grid.Column="4">
      <congen:EntradaNumerica Valor="{Binding NumeroPersonasMuertasEnEsteHecho, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                              Margin="3" />
    </Border>
  </Grid>
</UserControl>
