<Window x:Class="Ruv.WPF.Captura.Registro.Secciones.Controles.DocumentoDigital"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Ruv.WPF.Captura;component/Recursos/Imagenes/RUV.ico"
        Title="Documento Digital"
        Height="286"
        Width="536">
  <Grid>
    <Button Content="Seleccionar otra carpeta"
            Click="SeleccionarOtraCarpeta"
            Margin="0,0,170,44"
            Name="button1"
            Height="23"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Width="163" />
    <Button Content="Button"
            Click="VerArchivoActual"
            x:Name="btnArchivoActual"
            ToolTip="Click para abrir este archivo"
            Style="{StaticResource styLinkButton}"
            Height="23"
            Margin="12,12,18,0"
            VerticalAlignment="Top" />
    <GroupBox x:Name="gbContenidoCarpeta" 
              Margin="12,33,12,73">
      <ListBox x:Name="lbxListaArchivos"
               MouseDoubleClick="SeleccionarArchivoDobleClick">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Fecha, StringFormat='{}dd/MMM/yyyy hh:mm:ss tt'}"
                         Foreground="DarkGray"
                         Margin="0,0,10,0" />
              <TextBlock Text="{Binding Nombre}"
                         Foreground="DarkBlue" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </GroupBox>
    <Button Content="Seleccionar archivo"
            Height="23"
            Margin="12,0,0,44"
            Click="BotonSeleccionarArchivo"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Left"
            Width="163" />
    <Button Content="Cerrar"
            Height="23"
            HorizontalAlignment="Right"
            Margin="0,0,18,12"
            Click="Cerrar"
            VerticalAlignment="Bottom"
            Width="73" />
  </Grid>
</Window>
