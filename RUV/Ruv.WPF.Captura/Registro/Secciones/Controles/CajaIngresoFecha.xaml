<UserControl xmlns:my="clr-namespace:Ruv.WPF.Captura.Controles"
             x:Class="Ruv.WPF.Captura.Registro.Secciones.CajaIngresoFecha"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="100"
             d:DesignWidth="300">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Estilos/BasesParaEstilos.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid x:Name="grdMain" IsKeyboardFocusWithinChanged="grdMain_IsKeyboardFocusWithinChanged">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1*" />
      <ColumnDefinition Width="1*" />
      <ColumnDefinition Width="2*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition x:Name="rdTitulos"/>
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid.Resources>
      <Style TargetType="Border">
        <Setter Property="BorderBrush"
                Value="Black" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="BorderBrush"
                Value="Black" />
      </Style>

      <Style TargetType="TextBlock"
             BasedOn="{StaticResource styBaseTextBlockNormal}">
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextAlignment"
                Value="Center" />
      </Style>
      <Style TargetType="my:EntradaNumerica"
             BasedOn="{StaticResource styBaseTextBoxNormal}">
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextAlignment"
                Value="Center" />
      </Style>

    </Grid.Resources>
    <Border Grid.Column="0" />
    <Border Grid.Column="1"
            BorderThickness="0,1,1,1" />
    <Border Grid.Column="2"
            BorderThickness="0,1,1,1" />

    <TextBlock>Día</TextBlock>
    <TextBlock Grid.Column="1">Mes</TextBlock>
    <TextBlock Grid.Column="2">Año</TextBlock>
    <my:EntradaNumerica x:Name="tbxDia"
                        MaxLength="2"
                        Grid.Row="1" />
    <my:EntradaNumerica x:Name="tbxMes"
                        MaxLength="2"
                        Grid.Column="1"
                        Grid.Row="1" />
    <my:EntradaNumerica x:Name="tbxAño"
                        MaxLength="4"
                        Grid.Column="2"
                        Grid.Row="1" />
    <Border Grid.ColumnSpan="3"
            Grid.Row="1"
            BorderThickness="1,0,1,1" />

  </Grid>
</UserControl>
