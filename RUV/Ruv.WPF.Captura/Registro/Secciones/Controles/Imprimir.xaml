<Window x:Class="Ruv.WPF.Captura.Registro.Secciones.Controles.Imprimir"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ruv.WPF.Captura.Registro.Secciones.Controles"
        mc:Ignorable="d"
        Title="Imprimir" Height="293.436" Width="506.563" Loaded="Window_Loaded">
    <Grid>
        <ListBox Margin="12,32,10,38"
            Style="{x:Null}"
            SelectionMode="Single"
            x:Name="lbxAnexos">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontWeight="Bold"
                            Margin="0,0,5,0"
                            Text="{Binding NombreAnexo}" />
                        <TextBlock Text="{Binding JefeDeHogar}"
                            Foreground="{Binding ColorEstado}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Height="23"
            Margin="12,12,10,0"
            Text="Seleccione una sección a imprimir"
            TextWrapping="Wrap"
            VerticalAlignment="Top" />
        <CheckBox x:Name="chkTodo" Content="Imprimir toda la declaración" Margin="12,230,10,0" ></CheckBox>
        <Button x:Name="btnEliminar"
            Content="Imprimir"
            Height="23"
            Margin="0,0,10,10"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Width="75" Click="btnEliminar_Click" />
    </Grid>
</Window>
