<UserControl x:Class="Ruv.WPF.Captura.Registro.Secciones.InfoVictima_Laboral"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:congen="clr-namespace:Ruv.WPF.Captura.Controles"
             xmlns:sec="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
             d:DesignHeight="300"
             d:DesignWidth="595">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Registro/Secciones/RegistroDiccionario.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="RadioButton"
             BasedOn="{StaticResource styRadioButtonX}" />
      <Style TargetType="CheckBox"
             BasedOn="{StaticResource styCheckBoxX}" />
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid VerticalAlignment="Stretch">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="8*" />
      <ColumnDefinition Width="8*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition />
      <RowDefinition />
    </Grid.RowDefinitions>
    <!--PREGUNTA CÉDULA-->
    <sec:SubTituloEntrada x:Name="seTitulo"
                          Grid.ColumnSpan="2"
                          AlineacionTexto="Center"
                          AlineacionVerticalTexto="Center"
                          Numero="."
                          Texto="Indique el lugar donde desempeñaba sus actividades laborales" />
    <sec:SubTituloEntrada Numero=""
                          AlineacionTexto="Center"
                          Grid.Column="0"
                          Grid.Row="1"
                          Texto="LUGAR" />
    <congen:Geografia x:Name="geo01"
                      Grid.Row="2"
                      Grid.Column="0"
                      ComboPais="{Binding ElementName=cb01Pais}"
                      ComboDepartamento="{Binding ElementName=cb01Departamento}"
                      ComboMunicipio="{Binding ElementName=cb01Municipio}"
                      PaisId="{Binding LugarLaboralPais, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                      DepartamentoId="{Binding LugarLaboralDepartamento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                      MunicipioId="{Binding LugarLaboralMunicipio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
    <StackPanel Grid.Row="2"
                Grid.Column="0">
        <ComboBox x:Name="cb01Pais" Visibility="Collapsed" />
        <ComboBox x:Name="cb01Departamento" />
        <ComboBox x:Name="cb01Municipio" />
    </StackPanel>
    <sec:SubTituloEntrada Numero=""
                          AlineacionTexto="Center"
                          Grid.Column="1"
                          Grid.Row="1"
                          Texto="NOMBRE EMPLEADOR" />
    <TextBox Text="{Binding LugarLaboralEmpleador, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
             Margin="3"
             Grid.Row="2"
             Grid.Column="1" />
  </Grid>
</UserControl>
