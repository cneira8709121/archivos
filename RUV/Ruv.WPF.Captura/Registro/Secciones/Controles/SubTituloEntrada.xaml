<UserControl x:Class="Ruv.WPF.Captura.Registro.Secciones.SubTituloEntrada"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="300">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Estilos/BasesParaEstilos.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <Style TargetType="Label"
             BasedOn="{StaticResource styBaseLabelNormal}">
        <Setter Property="DockPanel.Dock"
                Value="Left" />
        <Setter Property="Background"
                Value="Black" />
        <Setter Property="Foreground"
                Value="White" />
        <Setter Property="Padding"
                Value="7,2" />
      </Style>
      <Style x:Key="stySubTituloEntrada"
             TargetType="TextBlock"
             BasedOn="{StaticResource styBaseTextBlockNormal}">
        <Setter Property="TextAlignment"
                Value="Left" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Background"
                Value="{StaticResource scbFondoSubtitulo}" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="Padding"
                Value="5,0,0,0" />
      </Style>

    </ResourceDictionary>

  </UserControl.Resources>
  <DockPanel>
    <Label x:Name="lbl01"
           VerticalContentAlignment="Stretch"
           Margin="0"
           DockPanel.Dock="Left">3</Label>
    <Border x:Name="bor01"
            Margin="0,0,0,0">
      <Grid>
        <TextBlock x:Name="txtTextoAtras"
                   VerticalAlignment="Stretch"
                   Style="{StaticResource stySubTituloEntrada}" />
        <TextBlock x:Name="txtTexto"
                   TextWrapping="Wrap"
                   VerticalAlignment="Stretch"
                   Text="(titulo)"
                   Style="{StaticResource stySubTituloEntrada}" />
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
