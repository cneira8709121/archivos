<UserControl xmlns:my="clr-namespace:Ruv.WPF.Captura.Impresion"
             x:Class="Ruv.WPF.Captura.Registro.Secciones.DenunciaPrevia_Detalle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:congen="clr-namespace:Ruv.WPF.Captura.Controles"
             xmlns:sec="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
             d:DesignHeight="300"
             d:DesignWidth="1243">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Ruv.WPF.Captura;component/Registro/Secciones/RegistroDiccionario.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="RadioButton"
             BasedOn="{StaticResource styRadioButtonX}" />
      <Style TargetType="CheckBox"
             BasedOn="{StaticResource styCheckBoxX}" />
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid VerticalAlignment="Top">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="4*" />
      <ColumnDefinition Width="8*" />
      <ColumnDefinition Width="8*" />
    </Grid.ColumnDefinitions>
    <!--PREGUNTA CÉDULA-->
    <congen:Geografia x:Name="geo01"
                      ComboPais="{Binding ElementName=cb01Pais}"
                      ComboDepartamento="{Binding ElementName=cb01Departamento}"
                      ComboMunicipio="{Binding ElementName=cb01Municipio}" />
    <my:DatoSiNoColumna DireccionTamaño="Both"
                        Valor="{Binding SePresento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
    <Border Grid.Column="1"
            Grid.ColumnSpan="8">
      <sec:ListaOpciones VerticalAlignment="Center"
                         TipoOpciones="Unica"
                         TipoParametros="Entidades"
                         Conjunto="TomaDeclaracion"
                         ValorSeleccionUnica="{Binding EntidadQueAtiende, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
    </Border>
    <sec:CajaIngresoFecha Grid.Column="9"
                          Fecha="{Binding Fecha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
    <Border Grid.Column="10">
      <StackPanel Orientation="Vertical">
                <ComboBox x:Name="cb01Pais"
                  SelectedValuePath="Id"
                  DisplayMemberPath="Nombre"
                  SelectedValue="{Binding Pais, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                <ComboBox x:Name="cb01Departamento"
                  SelectedValuePath="Id"
                  DisplayMemberPath="Nombre"
                  SelectedValue="{Binding Departamento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
        <ComboBox x:Name="cb01Municipio"
                  SelectedValue="{Binding Municipio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                  SelectedValuePath="Id"
                  DisplayMemberPath="Nombre" />
      </StackPanel>
    </Border>
    <Border Grid.Column="11">
      <TextBox Text="{Binding HijosEstudianInstitucion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
               Margin="3" />
    </Border>
  </Grid>
</UserControl>
