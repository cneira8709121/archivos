<UserControl xmlns:my1="clr-namespace:Ruv.WPF.Captura.Registro.Secciones.Controles"
             xmlns:my="clr-namespace:Ruv.WPF.Captura.Impresion"
             x:Class="Ruv.WPF.Captura.Registro.Secciones.A05"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:blo="clr-namespace:Ruv.WPF.Captura.Registro.Secciones.Controles"
             xmlns:sec="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
             xmlns:rec="clr-namespace:Ruv.WPF.Captura.Recursos"
             xmlns:imp="clr-namespace:Ruv.WPF.Captura.Impresion"
             xmlns:congen="clr-namespace:Ruv.WPF.Captura.Controles"
             xmlns:conv="clr-namespace:Ruv.WPF.Captura.Converters"
             xmlns:common="clr-namespace:Ruv.Infrastructure.Crosscutting.Common;assembly=Ruv.Infrastructure.Crosscutting.Common"
             mc:Ignorable="d"
             d:DesignHeight="1370"
             d:DesignWidth="939">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="RegistroDiccionario.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:VersionFUDConverter x:Key="VersionFUDConverter"/>
            <conv:ConsultaDatoConverter x:Key="ConsultaDato" />
            <conv:ListaVictimasConverter x:Key="ListaVictimas" />
            <conv:ListaPersonasAnexoConverter x:Key="ListaPersonasAnexo"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel x:Name="spMain">

        <ScrollViewer DockPanel.Dock="Top">
            <StackPanel Orientation="Vertical">
                <Grid DockPanel.Dock="Top">
                    <Border BorderThickness="1"
                  BorderBrush="Black"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center">
                    </Border>
                    <DockPanel>
                        <Border DockPanel.Dock="Right"
                    BorderThickness="1"
                    BorderBrush="Black"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                            <TextBlock VerticalAlignment="Center"
                         Margin="5,2"
                         Text="{Binding Path=Numero, StringFormat='ANEXO {0}'}" />
                        </Border>
                        <!--<TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Margin="10,0">FOLIO __ DE __</TextBlock>-->
                        <congen:TextoRecurso Recurso="{x:Static rec:Textos.a06t001}"
                                 Style="{StaticResource styTextoDescripcion}" />
                    </DockPanel>
                </Grid>
                <TextBlock DockPanel.Dock="Top"
                   Margin="0,5,0,0"
                   Style="{StaticResource styTituloSeccion}"
                   Text="{Binding Nombre}" />
                <sec:FechaLugar Numero="1"
                        DockPanel.Dock="Top"
                        ComboPaisEsVisible="False"
                        DataContext="{Binding FechaYLugar}" />

                <my1:DenunciaPrevia_Edicion DataContext="{Binding Path=DenunciaPrevia}"
                                    Conjunto="Entidades_Anexo_5_DP"
                                    Margin="5" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="1"
                  Grid.Column="1" />
                    <Border Grid.Row="1" Grid.Column="0" />
                    <Border Grid.Row="1"
                  Grid.Column="2" />
                    <Border Grid.Row="4"
                  Grid.Column="0" Grid.ColumnSpan="3" />
                    <sec:SubTituloEntrada Numero="3"
                                Texto="Tipo de evento" />
                    <!--<sec:SubTituloEntrada  Grid.Column="1" Grid.ColumnSpan="2"
                                Texto="Tipo de desplazamiento" />-->
                    <sec:SubTituloEntrada Numero="4"
                                Grid.Column="1"  Grid.Row="0"
                                Texto="Tiempo de residencia en lugar expulsor" />
                    <sec:ListaOpciones Grid.Row="1"
                             VerticalAlignment="Center"
                             TipoOpciones="Unica"
                             TipoParametros="TipoDeDesplazamiento"
                             ValorSeleccionUnica="{Binding TipoDesplazamiento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" 
                             Margin="2"/>
                    <!--<sec:ListaOpciones Grid.Row="1" Grid.Column="1"
                             VerticalAlignment="Center"
                             TipoOpciones="Unica"
                             TipoParametros="NuevoTipoDesplazamiento"
                             ValorSeleccionUnica="{Binding NuevoTipoDesplazamiento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" 
                             Margin="2"/>
                    <DockPanel Grid.Column="2" Grid.Row="1" Margin="1,1,1,1" VerticalAlignment="Center">
                        <sec:ListaOpciones ValorSeleccionUnica="{Binding EsExilio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                         TipoParametros="SiNo"
                         Grid.Column="1"
                         Grid.Row="2"
                         Grid.ColumnSpan="2" />
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource styDescripcionCajaEntrada}">Exilio *Use esta opción en caso que el arribo se diera fuera del territorio nacional por motivos políticos, sociales y/o culturales</TextBlock>
                    </DockPanel>-->
                    <Grid HorizontalAlignment="Center"
                MinWidth="150"
                Margin="5" Grid.ColumnSpan="3"
                Grid.Column="1"
                Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <sec:TituloConBorde AlineacionHorizontal="Left"
                                AlineacionVertical="Center"
                                Grid.Column="0"
                                Grid.Row="0"
                                Texto="Años" />
                        <sec:TituloConBorde AlineacionHorizontal="Left"
                                AlineacionVertical="Center"
                                Grid.Column="1"
                                Grid.Row="0"
                                Texto="Meses" />
                        <sec:TituloConBorde AlineacionHorizontal="Left"
                                AlineacionVertical="Center"
                                Grid.Column="2"
                                Grid.Row="0"
                                Texto="Días" />
                        <Border Grid.Row="1">
                            <congen:EntradaNumerica Valor="{Binding TiempoResidenciaEnLugarExpulsorAños, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                        </Border>
                        <Border Grid.Row="1"
                    Grid.Column="1">
                            <congen:EntradaNumerica Valor="{Binding TiempoResidenciaEnLugarExpulsorMeses, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                        </Border>
                        <Border Grid.Row="1"
                    Grid.Column="2">
                            <congen:EntradaNumerica Valor="{Binding TiempoResidenciaEnLugarExpulsorDias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                        </Border>
                    </Grid>
                </Grid>

                <sec:SubTituloEntrada Numero="5"
                              Texto="¿Cuál fué la causa del desplazamiento? (marque la casilla correspondiente)" />

                <sec:ListaOpciones TipoOpciones="Multiple"
                           TipoParametros="CausaDeDesplazamiento"
                           ValoresUsuario="{Binding CausaDesplazamiento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                           TextoOtro="{Binding CausaDesplazamientoOtro, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" Margin="2" />
                <sec:FechaLugar Numero="6"
                        Texto="Información de Arribo"
                        DockPanel.Dock="Top" CambioPais="FechaLugar_CambioPais"
                        DataContext="{Binding InformacionDeArribo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"  />
                <sec:SubTituloEntrada Numero="" Texto="Tipo de desplazamiento" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <sec:ListaOpciones Grid.Column="0"
         VerticalAlignment="Center" x:Name="sNuevoTipoDesplazamiento"
         TipoOpciones="Unica" IsEnabled="False"
         TipoParametros="NuevoTipoDesplazamiento"
         ValorSeleccionUnica="{Binding NuevoTipoDesplazamiento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" 
         Margin="2"/>
                    <DockPanel Grid.Column="1" Margin="1,1,1,1" VerticalAlignment="Center">
                        <sec:ListaOpciones x:Name="sExilio" ValorSeleccionUnica="{Binding EsExilio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
     TipoParametros="SiNo"
     Grid.Column="1"
     Grid.Row="2"
     Grid.ColumnSpan="2" />
                        <blo:BloqueadorControles Valor="{Binding NuevoTipoDesplazamiento}"
                            Visibility="Collapsed">
                            <blo:BloqueadorControles.ValoresQueDesbloquean>
                                <blo:ValorParametroHabilitante Valor="{x:Static Member=common:eParametrosHabilitantes.Trasnsnacional }" />
                                <blo:ValorParametroHabilitante Valor="{x:Static Member=common:eParametrosHabilitantes.Transfronterizo }" />
                            </blo:BloqueadorControles.ValoresQueDesbloquean>
                            <blo:ControlIndividual Elemento="{Binding ElementName=sExilio}" />
                        </blo:BloqueadorControles>
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource styDescripcionCajaEntrada}">Exilio *Use esta opción en caso que el arribo se diera fuera del territorio nacional por motivos políticos, sociales y/o culturales</TextBlock>
                    </DockPanel>
                </Grid>
                <sec:SubTituloEntrada Numero=""
                              Texto="INFORMACIÓN DE RETORNO O REUBICACIÓN"
                              AlineacionTexto="Center"
                              Margin="0,5" />
                <sec:SubTituloEntrada Numero="7"
                              Texto="¿El deseo del hogar es?" />
                <sec:ListaOpciones TipoOpciones="Unica"
                           TipoParametros="DeseoDelHogar"
                           ValorSeleccionUnica="{Binding DeseoDelHogar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" Margin="2" />
                <sec:FechaLugar x:Name="flDeseaUbicarseEn"
                        Numero="8"
                        Texto="Si respondió la opción 3 ¿en qué lugar le gustaría reubicarse?"
                        CajaFechaEsVisible="False"
                        ComboPaisEsVisible="False"
                        DataContext="{Binding DeseaUbicarseEn}" />
                <my1:BloqueadorControles Valor="{Binding DeseoDelHogar}">
                    <my1:BloqueadorControles.ValoresQueDesbloquean>
                        <!--<my1:ValorParametroHabilitante Valor="{x:Static  Member=common:eParametrosHabilitantes.DeseoDelHogar_Retornar}" />-->
                        <my1:ValorParametroHabilitante Valor="{x:Static  Member=common:eParametrosHabilitantes.DeseoDelHogar_Reubicarse}"  />
                    </my1:BloqueadorControles.ValoresQueDesbloquean>
                    <my1:ControlIndividual Elemento="{Binding ElementName=flDeseaUbicarseEn}" />
                </my1:BloqueadorControles>

                <!--=========================================-->
                <sec:SubTituloEntrada Numero=""
                              Texto="HOGAR AFECTADO"
                              AlineacionTexto="Center"
                              Margin="0,5" />
                <sec:SubTituloEntrada Numero="9"
                              Texto="Relacione en este cuadro las personas que conforman el hogar afectado por el desplazamiento" />
                <DockPanel>
                    <!--<congen:TextoRecurso Recurso="{x:Static rec:Textos.a01t006}"
                               Style="{StaticResource styTextoDescripcionIzq}"
                               TextAlignment="Left"
                               DockPanel.Dock="Top" />-->
                    <TextBlock VerticalAlignment="Center"
                     Margin="5">Jefe de hogar:</TextBlock>
                    <ComboBox Margin="5"
                    HorizontalAlignment="Left"
                    Width="250"
                    ItemsSource="{Binding Victimas, Converter={StaticResource ListaVictimas}, ConverterParameter=5}"
                    DisplayMemberPath="NombreCompleto"
                    SelectedValuePath="ID"
                    SelectedValue="{Binding JefeGrupoFamiliarId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                </DockPanel>
                <congen:TextoRecurso Recurso="{x:Static rec:Textos.a05t001}"
                             DockPanel.Dock="Top"
                             TextAlignment="Left"
                             Style="{StaticResource styTextoDescripcion}" />

                <!--===================================-->
                <Grid Height="150"
              Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2.5*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="lbxPersonasAfectadas"
                   ItemsSource="{Binding Source={StaticResource RUV}, Path=DeclaracionActual.PersonasAfectadas.ListaPersonas, Converter={StaticResource ListaPersonasAnexo}, ConverterParameter=DesplazamientoForzado_5}"
                   DisplayMemberPath="NombreCompleto"
                   Grid.Row="1"
                   SelectionMode="Extended" />
                    <StackPanel Grid.Column="1"
                      VerticalAlignment="Center"
                      Grid.RowSpan="2">
                        <StackPanel.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Padding"
                        Value="5,3" />
                                <Setter Property="Margin"
                        Value="3" />
                            </Style>
                        </StackPanel.Resources>
                        <Button Click="AgregarPersona">
                            <TextBlock>Agregar<Run FontFamily="Webdings"></Run></TextBlock>
                        </Button>
                        <Button Click="QuitarPersonas">
                            <TextBlock><Run FontFamily="Webdings"></Run>Quitar</TextBlock>
                        </Button>
                    </StackPanel>
                    <my:EncabezadoColumna Texto="Personas Afectadas"
                                Grid.Row="0"
                                Grid.Column="0" />
                    <my:EncabezadoColumna Texto="Personas que conforman el hogar\n(indique para cada miembro si se desplazó)"
                                Grid.Row="0"
                                Grid.Column="2" />
                    <my1:ListaPersonasDesplazadas x:Name="lpdPersonasHogar"
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Victimas="{Binding Victimas, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                </Grid>

                <!--================================-->
                <congen:TextoRecurso Recurso="{x:Static rec:Textos.a05t004}"
                             DockPanel.Dock="Top"
                             TextAlignment="Left"
                             Style="{StaticResource styTextoDescripcion}" />
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <sec:InfoVictima_Cedula DataContext="{Binding InformacionJefeGrupo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                  Numero="10" Visibility="{Binding Source={StaticResource RUV}, Path=I.DeclaracionActual.VersionFUD, Converter={StaticResource VersionFUDConverter}, ConverterParameter=VisibleEnVersion1}" />
                    <sec:InfoVictima_EstudioHijos DataContext="{Binding InformacionJefeGrupo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                        Numero="11" Visibility="{Binding Source={StaticResource RUV}, Path=I.DeclaracionActual.VersionFUD, Converter={StaticResource VersionFUDConverter}, ConverterParameter=VisibleEnVersion1}"
                                        Grid.Column="1" />
                    <sec:InfoVictima_Sisben DataContext="{Binding InformacionJefeGrupo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                  Numero="12" Visibility="{Binding Source={StaticResource RUV}, Path=I.DeclaracionActual.VersionFUD, Converter={StaticResource VersionFUDConverter}, ConverterParameter=VisibleEnVersion1}"
                                  Grid.Column="2" />
                </Grid>
                <Grid DockPanel.Dock="Top"
              Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <sec:InfoVictima_Inscrito DataContext="{Binding InformacionJefeGrupo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                    Numero="13" Visibility="{Binding Source={StaticResource RUV}, Path=I.DeclaracionActual.VersionFUD, Converter={StaticResource VersionFUDConverter}, ConverterParameter=VisibleEnVersion1}" />
                    <sec:InfoVictima_Salud DataContext="{Binding InformacionJefeGrupo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                 Numero="14" Visibility="{Binding Source={StaticResource RUV}, Path=I.DeclaracionActual.VersionFUD, Converter={StaticResource VersionFUDConverter}, ConverterParameter=VisibleEnVersion1}"
                                 Grid.Column="1" Grid.ColumnSpan="2" />

                </Grid>
                <Grid DockPanel.Dock="Top"
              Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <sec:InfoVictima_Laboral DataContext="{Binding InformacionJefeGrupo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                   Numero="15"
                                   Grid.Column="2" />
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

  
  
  
  
