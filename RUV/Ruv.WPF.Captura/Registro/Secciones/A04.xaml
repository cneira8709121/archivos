<UserControl xmlns:my1="clr-namespace:Ruv.WPF.Captura.Registro.Secciones.Controles"
             xmlns:my="clr-namespace:Ruv.WPF.Captura.Impresion"
             x:Class="Ruv.WPF.Captura.Registro.Secciones.A04"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sec="clr-namespace:Ruv.WPF.Captura.Registro.Secciones"
             xmlns:rec="clr-namespace:Ruv.WPF.Captura.Recursos"
             xmlns:congen="clr-namespace:Ruv.WPF.Captura.Controles"
             xmlns:conv="clr-namespace:Ruv.WPF.Captura.Converters"
             mc:Ignorable="d"
             d:DesignHeight="1370"
             d:DesignWidth="842">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="RegistroDiccionario.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:VersionFUDConverter x:Key="VersionFUDConverter"/>
            <conv:ConsultaDatoConverter x:Key="ConsultaDato" />
            <conv:EliminadosConverter x:Key="ConsultaEliminado" />
            <conv:ListaVictimasConverter x:Key="ListaVictimas" />
            <conv:ListaPersonasAfectadasNuloConverter x:Key="LPANC" />
            <conv:ListaPersonasAnexoConverter x:Key="ListaPersonasAnexo"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>

        <Grid Name="overlay" Visibility="Collapsed" Background="#66000000" Panel.ZIndex="1000">
            <!-- Rectángulo transparente que cubre toda la pantalla -->
            <Rectangle Fill="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
        </Grid>
        <DockPanel x:Name="spMain">

            <Grid DockPanel.Dock="Bottom">
                <Grid.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Margin"
                  Value="5" />
                        <Setter Property="Padding"
                  Value="5,2" />
                        <Setter Property="VerticalAlignment"
                  Value="Bottom" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition x:Name="cdAcciones"
                          Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Left">
                    <ComboBox x:Name="cbxListaCompletaPersonas"
                  Width="200"
                  ItemsSource="{Binding Source={StaticResource RUV}, Path=DeclaracionActual.PersonasAfectadas.ListaPersonas, Converter={StaticResource ListaPersonasAnexo}, ConverterParameter=DesaparicionForzada_4}"
                  DisplayMemberPath="NombreCompleto"
                  Margin="5,5,0,5" />
                    <Button Click="PrepararAgregarNuevaPersona"
                Margin="0,5">Agregar</Button>
                    <Button Click="AgregarCopia"
                Margin="0,5"
                ToolTip="Agrega el usuario seleccionado al anexo copiando la información del usuario seleccionado actualmente.">Agregar copia</Button>
                    <Button Click="EiminarPersonas"
                VerticalAlignment="Bottom">
                        Quitar persona
                    </Button>
                </StackPanel>
                <StackPanel x:Name="spAcciones"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Grid.Column="1"
                  Visibility="Visible">
                    <Button Click="AceptarEdicion"
                IsDefault="True">Aceptar</Button>
                    <Button Click="CancelarEdicion"
                IsCancel="True">Cancelar</Button>
                </StackPanel>
            </Grid>

            <ScrollViewer DockPanel.Dock="Top">
                <StackPanel Orientation="Vertical">
                    <Grid DockPanel.Dock="Top">
                        <Border BorderThickness="1"
                  BorderBrush="Black"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center">
                        </Border>
                        <DockPanel>
                            <Border DockPanel.Dock="Right"
                    BorderThickness="1"
                    BorderBrush="Black"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                                <TextBlock VerticalAlignment="Center"
                         Margin="5,2"
                         Text="{Binding Path=Numero, StringFormat='ANEXO {0}'}" />
                            </Border>
                            <!--<TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Margin="10,0">FOLIO __ DE __</TextBlock>-->
                            <congen:TextoRecurso Recurso="{x:Static rec:Textos.a06t001}"
                                 Style="{StaticResource styTextoDescripcion}" />
                        </DockPanel>
                    </Grid>
                    <TextBlock DockPanel.Dock="Top"
                   Margin="0,5,0,0"
                   Style="{StaticResource styTituloSeccion}"
                   Text="{Binding Nombre}" />
                    <sec:FechaLugar Numero="1"
                        DockPanel.Dock="Top"
                        DataContext="{Binding FechaYLugar}"
                        ComboPaisEsVisible="False"/>
                    <congen:TextoRecurso Recurso="{x:Static rec:Textos.a06t004}"
                             DockPanel.Dock="Top"
                             TextAlignment="Left"
                             Style="{StaticResource styTextoDescripcion}" />
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <sec:InfoVictima_Cedula DataContext="{Binding InformacionJefeGrupo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                  Numero="2" Visibility="{Binding Source={StaticResource RUV}, Path=I.DeclaracionActual.VersionFUD, Converter={StaticResource VersionFUDConverter}, ConverterParameter=VisibleEnVersion1}" />
                        <sec:InfoVictima_EstudioHijos DataContext="{Binding InformacionJefeGrupo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                        Numero="3" Visibility="{Binding Source={StaticResource RUV}, Path=I.DeclaracionActual.VersionFUD, Converter={StaticResource VersionFUDConverter}, ConverterParameter=VisibleEnVersion1}"
                                        Grid.Column="1" />
                        <sec:InfoVictima_Sisben DataContext="{Binding InformacionJefeGrupo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                  Numero="4" Visibility="{Binding Source={StaticResource RUV}, Path=I.DeclaracionActual.VersionFUD, Converter={StaticResource VersionFUDConverter}, ConverterParameter=VisibleEnVersion1}"
                                  Grid.Column="2" />
                    </Grid>
                    <Grid DockPanel.Dock="Top"
              Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <sec:InfoVictima_Inscrito DataContext="{Binding InformacionJefeGrupo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                    Numero="5" Visibility="{Binding Source={StaticResource RUV}, Path=I.DeclaracionActual.VersionFUD, Converter={StaticResource VersionFUDConverter}, ConverterParameter=VisibleEnVersion1}" />
                        <sec:InfoVictima_Salud DataContext="{Binding InformacionJefeGrupo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                 Numero="6" Visibility="{Binding Source={StaticResource RUV}, Path=I.DeclaracionActual.VersionFUD, Converter={StaticResource VersionFUDConverter}, ConverterParameter=VisibleEnVersion1}"
                                 Grid.Column="1" Grid.ColumnSpan="2" />
                        
                    </Grid>
                    <Grid DockPanel.Dock="Top"
              Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <sec:InfoVictima_Laboral DataContext="{Binding InformacionJefeGrupo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                   Numero="7"
                                   Grid.Column="2" />
                    </Grid>
                    <Popup Name="popup" IsOpen="False" Placement="Center" PlacementTarget="{Binding ElementName=overlay}">
                        <Border Background="White" BorderBrush="Black" BorderThickness="2">
                            <StackPanel Margin="20">
                                <TextBlock Text="Seleccione la persona Desaparecida" />
                                <Button x:Name="btnAceptarPopup" Content="Aceptar" Click="btnAceptarPopup_Click" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Grid Margin="5,10,5,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition x:Name="cdEdicion"
                              Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <sec:SubTituloEntrada Numero=""
                                Texto="Grupo Familiar"
                                Grid.ColumnSpan="2" />
                        <!--SelectionChanged="PersonaSeleccionada"-->
                        <StackPanel Grid.Row="1"
                      Grid.RowSpan="2"
                      Margin="0,0,9,0">
                            <DockPanel>
                                <congen:TextoRecurso Recurso="{x:Static rec:Textos.a04t002}"
                                   Style="{StaticResource styTextoDescripcionIzq}"
                                   TextAlignment="Left"
                                   DockPanel.Dock="Top" />
                                <TextBlock DockPanel.Dock="Left"
                         VerticalAlignment="Center"
                         Margin="5">Víctima 1:</TextBlock>
                                <ComboBox x:Name="cbVictima1" Margin="5"
                        HorizontalAlignment="Left"
                        Width="250"
                        ItemsSource="{Binding Victimas, Converter={StaticResource ListaVictimas}, ConverterParameter=4}"
                        DisplayMemberPath="NombreCompleto"
                        SelectedValuePath="ID"
                        SelectedValue="{Binding JefeGrupoFamiliarId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" DropDownOpened="cbVictima1_DropDownOpened"/>
                            </DockPanel>
                            <ListBox MinHeight="20"
                     ItemsSource="{Binding Victimas, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                     SelectionChanged="PersonaSeleccionada"
                     x:Name="lbxListaPersonas"
                     BorderThickness="0"
                     SelectionMode="Extended">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="{Binding EstadoRegistro, Converter={StaticResource ConsultaEliminado}}" Text="{Binding PersonaAfectadaId, Converter={StaticResource ConsultaDato}, ConverterParameter=NOMBRECOMPLETOAFECTADO}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <GridSplitter x:Name="gsSeparador"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Visibility="Visible"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        Grid.Row="1"
                        Width="7" />

                        <StackPanel x:Name="svEdicion"
                      Grid.Column="1"
                      Grid.Row="1"
                      Grid.IsSharedSizeScope="True"
                      Background="LightGray">
                            <StackPanel.Resources>
                                <Style BasedOn="{StaticResource styDescripcionCajaEntrada}"
                     TargetType="TextBlock">
                                    <Setter Property="Margin"
                        Value="6,3,3,3" />
                                    <Setter Property="VerticalAlignment"
                        Value="Top" />
                                </Style>
                                <Style BasedOn="{StaticResource styBaseTextBoxNormal}"
                     TargetType="TextBox">
                                    <Setter Property="VerticalAlignment"
                        Value="Bottom" />
                                    <Setter Property="Margin"
                        Value="0,1,4,1" />
                                </Style>
                                <Style TargetType="{x:Type my:DatoSiNoColumna}">
                                    <Setter Property="Margin"
                        Value="0,1" />
                                </Style>
                            </StackPanel.Resources>
                            <Grid VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"
                                  SharedSizeGroup="grpEdicion01" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <!--===============================-->
                                <TextBlock Grid.Row="0">Nombre completo</TextBlock>
                                <TextBlock Text="{Binding PersonaAfectadaId, Converter={StaticResource ConsultaDato}, ConverterParameter=NOMBRECOMPLETOAFECTADO }"
                         Margin="0,1"
                         VerticalAlignment="Center"
                         Grid.Row="0"
                         Grid.Column="1" />
                                <!--===============================-->
                                <TextBlock Grid.Row="1">Víctima de este hecho</TextBlock>
                                <my:DatoSiNoColumna x:Name="chkVictimaDelHecho"
                                  Valor="{Binding VictimaDeEsteHecho, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                  IncluirNsNr="False"
                                  Grid.Column="1"
                                  Grid.Row="1"
                                  Background="White"
                                  HorizontalAlignment="Left" />
                                <!--===============================-->
                                <TextBlock Grid.Row="2">Se encuentra desaparecido</TextBlock>
                                <my:DatoSiNoColumna x:Name="dsnVictimaDesaparecida"
                                  Valor="{Binding VictimaDesaparecida, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                  IncluirNsNr="False"
                                  Grid.Column="1"
                                  Grid.Row="2"
                                  Background="White"
                                  HorizontalAlignment="Left" />
                            </Grid>
                            <!--===============================-->
                            <my1:Afectacion_Edicion x:Name="aeAfectacion"
                                    DataContext="{Binding Path=Afectacion}"
                                    Conjunto="Afectacion_Anexo_4" />
                            <my1:DenunciaPrevia_Edicion x:Name="dpDenuncia"
                                        DataContext="{Binding Path=DenunciaPrevia}"
                                        Conjunto="Entidades_Anexo_4_DP" />
                            <!--===============================-->
                            <sec:SubTituloEntrada Numero=""
                                  Texto="Antecedentes y Hechos Posteriores a la Desaparición"
                                  HorizontalAlignment="Stretch"
                                  ColorTexto="Inverso"
                                  Margin="0,0,0,5" />
                            <Grid x:Name="grdAntecedentes"
                  VerticalAlignment="Top"
                  Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"
                                  SharedSizeGroup="grpEdicion01" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <!--===============================-->
                                <TextBlock Grid.Row="0">Antes de la desaparición<LineBreak />¿Se presentó alguno de estos eventos?</TextBlock>
                                <ComboBox SelectedValue="{Binding SePresentoEventoAnterior, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                        ItemsSource="{Binding Converter={StaticResource ParametrosConverter}, ConverterParameter=EventosAntesDeDesaparición}"
                        DisplayMemberPath="Nombre"
                        SelectedValuePath="Id"
                        Grid.Row="0"
                        Grid.Column="1"
                        VerticalAlignment="Center" />
                                <!--===============================-->
                                <TextBlock Grid.Row="1">Después de la desaparición<LineBreak />¿Se presentó alguno de estos eventos?</TextBlock>
                                <ComboBox SelectedValue="{Binding SePresentoEventoPosterior, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                        ItemsSource="{Binding Converter={StaticResource ParametrosConverter}, ConverterParameter=EventosDespuésDeDesaparición}"
                        DisplayMemberPath="Nombre"
                        SelectedValuePath="Id"
                        Grid.Row="1"
                        Grid.Column="1"
                        VerticalAlignment="Center" />
                                <!--===============================-->
                                <TextBlock Grid.Row="2">Actividad de la persona<LineBreak />al momento de la desaparación</TextBlock>
                                <TextBox Grid.Row="2"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="{Binding ActividadAlDesaparecer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                                <!--===============================-->
                                <TextBlock Grid.Row="3">¿Con ocasión de estos hechos algún niño,<LineBreak />niña o adolescente quedó desprotegido?</TextBlock>
                                <my:DatoSiNoColumna Valor="{Binding QuedoMenorDesprotegido, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                  IncluirNsNr="False"
                                  Grid.Column="1"
                                  Grid.Row="3"
                                  VerticalAlignment="Center"
                                  Height="20"
                                  Background="White"
                                  HorizontalAlignment="Left" />
                                <!--===============================-->
                                <TextBlock Grid.Row="4">Menor desprotegido</TextBlock>
                                <ComboBox x:Name="cbxMenorDesprotegidoId"
                        SelectedValue="{Binding MenorDesprotegidoId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                        ItemsSource="{Binding Source={StaticResource RUV}, Path=DeclaracionActual.PersonasAfectadas.ListaPersonas, Converter={StaticResource LPANC}}"
                        DisplayMemberPath="NombreCompleto"
                        SelectedValuePath="ID"
                        Grid.Row="4"
                        Grid.Column="1"
                        VerticalAlignment="Center" />
                                <!--===============================-->
                                <TextBlock Grid.Row="5">¿Han realizado búsqueda<LineBreak />de la víctima?</TextBlock>
                                <my:DatoSiNoColumna Valor="{Binding HaRealizadoBusquedaDeVictima, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                  IncluirNsNr="False"
                                  Grid.Column="1"
                                  Grid.Row="5"
                                  VerticalAlignment="Center"
                                  Height="18"
                                  Background="White"
                                  HorizontalAlignment="Left" />
                                <!--===============================-->
                                <TextBlock Grid.Row="6">Indique mediante qué entidad</TextBlock>
                                <TextBox x:Name="tbxHarealizadoBusquedaAnteEntidad"
                       Grid.Row="6"
                       Grid.Column="1"
                       Text="{Binding HarealizadoBusquedaAnteEntidad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                                <!--===============================-->
                            </Grid>

                            <my1:BloqueadorControles Valor="{Binding QuedoMenorDesprotegido}">
                                <my1:ControlIndividual Elemento="{Binding ElementName=cbxMenorDesprotegidoId}" />
                            </my1:BloqueadorControles>

                            <my1:BloqueadorControles Valor="{Binding HaRealizadoBusquedaDeVictima}">
                                <my1:ControlIndividual Elemento="{Binding ElementName=tbxHarealizadoBusquedaAnteEntidad}" />
                            </my1:BloqueadorControles>

                            <!--FICHA CONTROL DE CAMBIOS RUV 27-03-12
            No se debe bloquear ningun campo cuando se marque la persona como "no víctima" 
            <my1:BloqueadorControles Valor="{Binding VictimaDeEsteHecho}">
              <my1:ControlIndividual Elemento="{Binding ElementName=grdAntecedentes}" />
              <my1:ControlIndividual Elemento="{Binding ElementName=dsnVictimaDesaparecida}" />
            </my1:BloqueadorControles>
            -->
                        </StackPanel>
                    </Grid>
                </StackPanel>

            </ScrollViewer>

        </DockPanel>
    </Grid>
</UserControl>

  
  
  
  