<Window x:Class="Ruv.WPF.Captura.Opciones.Configuracion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:config="clr-namespace:Ruv.WPF.Captura.Opciones"
        Title="Configuracion" mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" d:DesignHeight="468" d:DesignWidth="521" SizeToContent="WidthAndHeight" ResizeMode="NoResize">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom"
                HorizontalAlignment="Left"
                Margin="5">
            <Button Click="Aceptar_Click">Grabar configuración</Button>
        </StackPanel>
    
        <TabControl x:Name="tblConfuguracion" >
            <TabItem Header="General" >
                <config:Ubicaciones DataContext="{Binding Ubicaciones}" />
            </TabItem>
            <TabItem Header="Impresora" >
                <config:ConfiguracionImpresora x:Name="ImpresoraConfig" DataContext="{Binding Impresion}"></config:ConfiguracionImpresora>
            </TabItem>
        </TabControl>
    </DockPanel>
    
</Window>
