<Window x:Class="Ruv.WPF.Captura.ListaTareas.BorrarColaConfirmacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Ruv.WPF.Captura.Converters"
        xmlns:Recursos="clr-namespace:Ruv.WPF.Captura.Recursos"
        Title="BorrarColaConfirmacion" Height="400" Width="600">
    <Window.Resources>
        <conv:SeparadorTextoConverter x:Key="STC" />
        <Recursos:Controles x:Key="Controles"></Recursos:Controles>
    </Window.Resources>
    <Grid>
        <StackPanel HorizontalAlignment="Stretch" Margin="10" VerticalAlignment="Stretch">
            <WrapPanel HorizontalAlignment="Stretch" Margin="10" VerticalAlignment="Stretch">
                <TextBlock  Name="textBlock1" TextWrapping="Wrap" Text="{Binding Path=BorrarColaPendiente, Source={StaticResource ResourceKey=Controles}}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="10" />
            </WrapPanel>
            <Grid HorizontalAlignment="Stretch" Margin="10" VerticalAlignment="Stretch">
                <DataGrid x:Name="dgCola" Height="200" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Estado, Converter={StaticResource STC}, ConverterParameter=EstadoProceso}"
                                  Header="Estado" />
                        <DataGridTextColumn Binding="{Binding FechaEnCola, StringFormat='{}dd-MMM-yyyy hh:mm'}"
                                  Header="Fecha ingreso" />
                        <DataGridTextColumn Binding="{Binding NombreDeclarante}"
                                  Header="Declarante" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <WrapPanel HorizontalAlignment="Stretch" Margin="10" VerticalAlignment="Stretch" Height="35">
                <Button x:Name="btnAceptar" VerticalAlignment="Center" Margin="5" Height="25" Click="btnAceptar_Click">Aceptar y Continuar</Button>
                <Button x:Name="btnCancelar" VerticalAlignment="Center" Margin="5" Height="25" Click="btnCancelar_Click">Cancelar y Salir</Button>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
