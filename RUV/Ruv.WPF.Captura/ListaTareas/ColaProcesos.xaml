<Page x:Class="Ruv.WPF.Captura.ListaTareas.ColaProcesos"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:conv="clr-namespace:Ruv.WPF.Captura.Converters"
      xmlns:rec="clr-namespace:Ruv.WPF.Captura.Recursos"
      mc:Ignorable="d"
      Unloaded="Unload_ColaProcesos"
      d:DesignHeight="300"
      d:DesignWidth="578"
      DataContext="{Binding Source={StaticResource RUV}, Path=ColaProcesos}"
      Title="ColaProcesos">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Ruv.WPF.Captura;component/Estilos/ColoresEstadosProcesos.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:EstadoProcesoColorConverter x:Key="EPCC" />
            <conv:SeparadorTextoConverter x:Key="STC" />
            <conv:ErroresTransmisionVisibilidadConverter x:Key="ETVC" />
            <conv:VisibilidadSegunRolConverter x:Key="VisibilidadSegunRolConverter"/>
            <rec:Controles x:Key="ControlesDataSource" d:IsDataSource="True"/>
        </ResourceDictionary>
    </Page.Resources>
    <DockPanel Margin="5">
        <TabControl Name="tabControl1"
                SelectionChanged="tabControl1_SelectionChanged">
            <TabItem Header="Pendientes"
               Name="tabPendientes">
                <DockPanel>
                    <DockPanel.Resources>
                        <Style TargetType="{x:Type DataGridRow}">
                            <Style.Setters>
                                <Setter Property="Background"
                        Value="{Binding Path=Estado, Converter={StaticResource EPCC}}" />
                            </Style.Setters>
                        </Style>
                    </DockPanel.Resources>
                    <TextBlock TextWrapping="Wrap"
                     DockPanel.Dock="Top"
                     Margin="5">Esta es la lista actual de declaraciones pendientes por transmitir.</TextBlock>
                    <StackPanel DockPanel.Dock="Bottom"
                      Margin="5"
                      Orientation="Horizontal">
                        <Button x:Name="btnPuargarCola"
                    Click="PurgarCola"
                    Padding="10,5"
                    ToolTip="Borrar todos los trabajos pendientes de la cola de transmisión"
                    Content="Purgar cola" />
                    </StackPanel>
                    <DataGrid x:Name="dgPendientes"
                    MouseDoubleClick="GrillaDobleClick"
                    Margin="5,0,5,5"
                    AutoGenerateColumns="False"
                    ItemsSource="{Binding ListaProcesos}"
                    CanUserReorderColumns="False"
                    CanUserResizeRows="False"
                    IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding NombreDeclarante}"
                        Header="Declarante / FUD" />
                            <DataGridTextColumn Binding="{Binding Estado, Converter={StaticResource STC}, ConverterParameter=EstadoProceso}"
                        Header="Estado" />
                            <DataGridTextColumn Binding="{Binding FechaEnCola, StringFormat='{}dd-MMM-yyyy hh:mm'}"
                                  Header="Fecha ingreso" />
                            <DataGridTemplateColumn Header="Errores">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button HorizontalAlignment="Center"
                                Content="Ver"
                                Click="VerErroresAdvertenciasDB">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource styLinkButton}"
                                   TargetType="Button">
                                                    <Setter Property="Visibility"
                                      Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ErroresDB.Count, FallbackValue=0, TargetNullValue=0}"
                                             Value="0">
                                                            <Setter Property="Visibility"
                                          Value="Hidden" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <!--LISTA HISTÓRICA DE TRANSFERENCIA-->
            <TabItem Header="Histórico"
               Name="tabHistorico">
                <DockPanel>
                    <DockPanel.Resources>
                        <Style TargetType="{x:Type DataGridRow}">
                            <Style.Setters>
                                <Setter Property="Background"
                        Value="{Binding Path=Estado, Converter={StaticResource EPCC}}" />
                            </Style.Setters>
                        </Style>
                    </DockPanel.Resources>
                    <DockPanel DockPanel.Dock="Top"
                     VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Top"
                        DockPanel.Dock="Right">
                            <TextBlock TextWrapping="Wrap"
                         Margin="5">Filtro</TextBlock>
                            <ComboBox x:Name="cbxMes"
                        DisplayMemberPath="Nombre"
                        SelectedValuePath="Id" />
                            <ComboBox x:Name="cbxAño"
                        SelectedValuePath="Id"
                        DisplayMemberPath="Nombre" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap"
                       Margin="5">Esta es la lista de transmisiones exitosas realizadas.</TextBlock>
                    </DockPanel>
                    <Grid DockPanel.Dock="Bottom"
                      Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="dgHistorico"
                        MouseDoubleClick="GrillaDobleClick"
                        Margin="5,0,5,5"
                        AutoGenerateColumns="False"
                        CanUserReorderColumns="False"
                        CanUserResizeRows="False"
                        IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding FechaEnCola, StringFormat='{}dd-MMM-yyyy hh:mm'}"
                                      Header="Fecha ingreso" />
                                <DataGridTextColumn Binding="{Binding FechaUltimaTransmision, StringFormat='{}dd-MMM-yyyy hh:mm'}"
                                      Header="Fecha Transmisión" />
                                <DataGridTextColumn Binding="{Binding NombreDeclarante}"
                                      Header="Declarante / FUD" />
                                <DataGridTemplateColumn Header="Advertencias">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button HorizontalAlignment="Center"
                                Content="Ver"
                                Click="VerErroresAdvertenciasDB">
                                                <Button.Style>
                                                    <Style BasedOn="{StaticResource styLinkButton}"
                                   TargetType="Button">
                                                        <Setter Property="Visibility"
                                      Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AdvertenciasDB.Count, FallbackValue=0, TargetNullValue=0}"
                                             Value="0">
                                                                <Setter Property="Visibility"
                                          Value="Hidden" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{Binding Colilla, Source={StaticResource ControlesDataSource}}" Visibility="{Binding Source={StaticResource RUV}, Path=I.Usuario.RolesUsuario, Converter={StaticResource VisibilidadSegunRolConverter}, ConverterParameter=TomaEnLinea}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Margin="5" Content="{Binding VerColilla, Source={StaticResource ControlesDataSource}}" Click="Button_Click" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <TextBlock TextDecorations="Underline">
                                                            <ContentPresenter />
                                                        </TextBlock>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Foreground" Value="Blue" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="true">
                                                                <Setter Property="Foreground" Value="Red" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="1" HorizontalAlignment="Left" Content="Exportar en Excel" Height="23" Name="Btn_ExportaExcel" Width="118" Click="Btn_ExportaExcel_Click" />
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Page>
