        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>“RESUELVE:</Value>
                <Style>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
