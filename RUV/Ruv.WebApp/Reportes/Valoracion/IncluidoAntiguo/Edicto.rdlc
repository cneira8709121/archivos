        </Style>
      </Textbox>
      <Textbox Name="Textbox3">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Que por medio del presente edicto </Value>
                <Style />
              </TextRun>
              <TextRun>
                <Value>NOTIFICA </Value>
                <Style>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value>la </Value>
                <Style />
              </TextRun>
              <TextRun>
                <Value>Resolución No.</Value>
                <Style>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value xml:space="preserve"> </Value>
                <Style />
              </TextRun>
              <TextRun>
                <Value>=Fields!cConsecutivo.Value</Value>
                <Style>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value> del </Value>
                <Style>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Fields!dFechaValoracionReal.Value</Value>
                <Style>
                  <FontWeight>Bold</FontWeight>
                  <Format>d' de 'MMMM' de 'yyyy</Format>
                </Style>
              </TextRun>
              <TextRun>
                <Value>, FUD </Value>
                <Style>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Label>FUD</Label>
                <Value>=First(Fields!cNumeroFormulario.Value, "DataSet1")</Value>
                <Style>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value>, mediante la cual la </Value>
                <Style />
              </TextRun>
              <TextRun>
                <Value>DIRECTORA TÉCNICA DE REGISTRO Y GESTIÓN DE LA INFORMACIÓN DE LA UNIDAD PARA LA ATENCIÓN Y REPARACIÓN INTEGRAL A LAS VÍCTIMAS</Value>
                <Style>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value>,decide sobre la inscripción en el Registro Único de Víctimas de </Value>
                <Style />
              </TextRun>
              <TextRun>
                <Value>=Fields!cNombreDeclarante.Value</Value>
                <Style>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value> con </Value>
                <Style />
              </TextRun>
              <TextRun>
                <Value>=Fields!cTipoDocumento.Value</Value>
                <Style />
              </TextRun>
              <TextRun>
                <Value> No. </Value>
                <Style />
              </TextRun>
              <TextRun>
                <Value>=Fields!nDocumentoIdentidad.Value</Value>
                <Style>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value> y en cuya parte resolutiva decidió:</Value>
                <Style />
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
